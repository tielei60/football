@import "../players/temporary-player.wxss";
/* UI v3：管理页共享视觉由 app.wxss 令牌与品牌横幅提供。 */
.admin-header { gap:16rpx; flex-wrap:wrap; margin:24rpx 0; }
.field-label { font-size:26rpx; font-weight:500; color:var(--muted); margin-bottom:12rpx; }
.hint,.subtitle { font-size:24rpx; line-height:1.65; color:var(--muted); }
.section-title { font-size:32rpx; font-weight:650; line-height:1.4; }
.card { padding:34rpx; }
.error { overflow-wrap:anywhere; }
 .card.row { padding:28rpx; gap:20rpx; }
.card .avatar { width:92rpx; height:92rpx; border-radius:50%; flex-shrink:0; }
.card .grow { flex:1; min-width:0; }
.bold { font-size:30rpx; font-weight:650; overflow-wrap:anywhere; }
.player-number-note { display:block; font-size:24rpx; color:var(--muted); font-weight:400; margin-top:4rpx; }
.muted { font-size:24rpx; margin-top:6rpx; }
.card .tag { flex-shrink:0; max-width:150rpx; white-space:normal; font-size:24rpx; }
@media(max-width:340px) { .card.row { flex-wrap:wrap; } .card .grow { min-width:160rpx; } }

/* 对齐 V3 管理列表：新增操作独立成行，保留权限与禁用条件。 */
.admin-create-action { margin:24rpx 0 32rpx; }
.admin-create-action .ui-button { width:100%; min-height:44px; margin:0; box-sizing:border-box; }

/* 账号是否开通与成员是否确认分别表达，不混用同一业务状态。 */
.account-status.account-ready{color:var(--success);background:var(--success-soft)}
.account-status.account-pending{color:var(--muted);background:var(--brand-soft)}
.empty-title{font-size:var(--type-body);color:var(--ink);font-weight:500}
.empty-hint{font-size:var(--type-meta);color:var(--muted);margin-top:12rpx;line-height:1.6}

/* ZIP 11：搜索图标和合并名册卡片，点击及账号状态保持原绑定。 */
.page .admin-create-action button.ui-button[size="mini"]{display:flex;align-items:center;justify-content:center;gap:18rpx}
.create-symbol{font-size:36rpx;font-weight:400;line-height:1;flex:none}
.player-search{position:relative}
.player-search input.input{padding-left:68rpx}
.search-symbol{position:absolute;left:24rpx;top:50%;width:24rpx;height:24rpx;box-sizing:border-box;border:2rpx solid var(--muted);border-radius:50%;transform:translateY(-60%);pointer-events:none;z-index:1}
.search-symbol::after{content:"";position:absolute;width:12rpx;height:2rpx;right:-9rpx;bottom:-4rpx;background:var(--muted);transform:rotate(45deg)}
.managed-player-list{background:var(--surface);border:1rpx solid var(--line);border-radius:30rpx;padding:0 28rpx;box-shadow:0 6rpx 18rpx #6a00680c}
.managed-player-list:empty{display:none}
.managed-player-list>.card.row{margin:0;padding:28rpx 0;border:0;border-radius:0;background:transparent;box-shadow:none;gap:16rpx}
.managed-player-list>.card.row+.card.row{border-top:1rpx solid var(--line)}
.managed-player-list .player-number-note{display:inline-block;max-width:100%;margin-left:0;padding-left:8rpx;box-sizing:border-box;word-break:keep-all;overflow-wrap:anywhere;vertical-align:baseline}
.player-chevron{font-size:36rpx;color:var(--ink);flex:none;line-height:1}
@media(max-width:340px){.managed-player-list>.card.row{gap:12rpx}.managed-player-list .account-status{margin-left:auto}}

.managed-player-list .temporary-player-marker{margin-left:10rpx;margin-right:4rpx}
