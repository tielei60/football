<view class="page"><view class="between admin-header"><view class="title">球员管理</view><button disabled="{{loading}}" wx:if="{{authorized}}" class="primary small ui-button ui-compact" bindtap="create" size="mini">新增球员</button></view><page-state skeleton-type="list" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error&&authorized}}"><input disabled="{{loading}}" class="input" placeholder="搜索姓名或号码" value="{{search}}" bindinput="search"/><view class="tabs"><view aria-role="button" class="tab {{status==='active'?'active':''}}" data-status="active" bindtap="status">在队</view><view aria-role="button" class="tab {{status==='inactive'?'active':''}}" data-status="inactive" bindtap="status">已归档</view><view aria-role="button" class="tab {{status==='unconfirmed'?'active':''}}" data-status="unconfirmed" bindtap="status">待确认</view></view><view aria-role="button" wx:for="{{visible}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="edit"><view class="avatar {{!item.avatar?'player-placeholder':''}}"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" data-target="list" data-index="{{index}}" binderror="imageError"/><text wx:else>{{item.initial}}</text></view><view class="grow"><view class="bold">{{item.name}}<text class="player-number-note">{{item.numberDescription}}</text></view><view class="muted">{{item.positionLabel}}</view></view><text class="tag">{{item.hasAccount?'已开通':'未开通'}}账号</text></view><view wx:if="{{!visible.length}}" class="empty">暂无球员</view></block></view>
<business-dialog id="business-dialog"/>
