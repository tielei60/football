:host{display:block;min-width:0}.state{box-sizing:border-box;padding:44rpx 28rpx;text-align:center;color:var(--muted,#716779);font-size:25rpx;line-height:1.65;border-radius:24rpx;background:var(--surface,#fff);border:1rpx solid var(--line,#eae5ef)}.state-title{display:block;color:var(--ink,#51435d);font-size:28rpx;font-weight:600}.state-message{display:block;margin-top:12rpx;word-break:break-word;white-space:pre-wrap}.state-symbol{width:56rpx;height:56rpx;line-height:56rpx;margin:0 auto 18rpx;border-radius:18rpx;background:#faedf0;color:var(--danger,#b04758);font-weight:700;font-size:32rpx}.state button.retry{display:inline-flex;justify-content:center;align-items:center;box-sizing:border-box;width:auto;max-width:100%;min-width:176rpx;min-height:80rpx;margin:24rpx 0 0;padding:16rpx 28rpx;color:var(--brand-ink,#633277);background:var(--brand-soft,#f0e7f5);border-radius:16rpx;font-size:26rpx;line-height:1.4;font-weight:600}.state button::after{border:0}.state button:focus-visible{outline:3rpx solid var(--focus,#8845a0);outline-offset:3rpx}.empty-mark{width:60rpx;padding:14rpx 12rpx;margin:0 auto 20rpx;background:var(--brand-soft,#f0e7f5);border-radius:14rpx;box-sizing:border-box}.empty-mark view{height:4rpx;margin:6rpx 0;border-radius:4rpx;background:#bca7c7}.empty-mark view:last-child{width:70%}

.state button.retry{border:1rpx solid #e5d7eb;background:#f5eef8;box-shadow:0 4rpx 12rpx rgba(63,33,78,.05)}
.state button.retry.button-hover{opacity:.72}

/* 重试属于主要动作；宽屏保留原有 80rpx 高度。 */
@media(max-width:412.5px){.state button.retry{min-height:44px}}
