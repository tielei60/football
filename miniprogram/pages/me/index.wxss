/* 本页文字层级；不改变输入、按钮、列数或画布几何。 */
.management-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 12rpx;
}
.management-grid button {
  width: 100%;
  margin: 0;
  font-size: 26rpx;
  min-width: 0;
  padding: 22rpx 12rpx;
  line-height: 1.4;
}
.card.row {
  gap: 22rpx;
}
.card.row .title {
  font-size: var(--type-page);
  overflow-wrap: anywhere;
  font-weight: 650;
  line-height: 1.4;
}
.card.row .grow {
  min-width: 0;
}
.card.row .avatar {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
}
.metrics {
  gap: 10rpx;
}
.metric .number {
  font-size: 38rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
}
.metric .label {
  font-size: 25rpx;
}
.card .tag {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.page>button.danger {
  margin-top: 24rpx;
}
.team-name {
  font-size: var(--type-field);
  line-height: 1.6;
}
.section-title, .account-heading {
  font-size: var(--type-section);
  font-weight: 600;
}
.hint {
  font-size: var(--type-meta);
  line-height: 1.6;
}
.error {
  font-size: 26rpx;
  font-weight: 500;
}

/* 小屏正文下限 12px，仅覆盖以上内容文字，不影响控件。 */
@media (max-width: 375.000px) {
  .card .tag, .hint { font-size: 12px; }
}
@media (max-width: 360.000px) {
  .metric .label { font-size: 12px; }
}
@media (max-width: 346.154px) {
  .team-name, .error { font-size: 12px; }
}
@media (max-width: 321.429px) {
  .section-title, .account-heading { font-size: var(--type-section); }
}

/* Management shortcuts use the same restrained card treatment as match tools. */
.page .management-grid>button.ui-button[size="mini"]{min-height:88rpx;border:1rpx solid #e7dfeb;border-radius:18rpx;background:#fff;color:var(--brand-ink);box-shadow:0 4rpx 14rpx rgba(46,32,54,.035);font-weight:600}
.page .management-grid>button.ui-button[disabled]{background:#eeebf1;color:#8b8191;border-color:transparent;box-shadow:none}
