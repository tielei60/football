# 复制为 .env 后由 Docker Compose 读取；禁止提交 .env。
# 首次启动前设置独立强密码。首位管理员创建后移除这两项初始账号变量；
# 已有账号的密码不会被初始配置重置。
FOOTBALL_ADMIN_USERNAME=owner
FOOTBALL_ADMIN_PASSWORD=
# 精确外部来源地址，不带末尾斜杠；公网部署必须使用 HTTPS。
FOOTBALL_PUBLIC_ORIGIN=http://localhost:13001
FOOTBALL_COOKIE_SECURE=false
# 仅列出直接连接 Node 的可信代理精确 IP，逗号分隔。
# 参见 docs/security-deployment.md；不能信任任意客户端转发请求头。
FOOTBALL_TRUSTED_PROXY_ADDRESSES=

# 微信身份认证默认关闭。仅服务端配置，不能放入小程序或提交真实密钥。
# 开启前需部署 HTTPS、核对微信平台配置及生产限流，不能使用测试身份。
FOOTBALL_WECHAT_ENABLED=false
FOOTBALL_WECHAT_APP_ID=
FOOTBALL_WECHAT_APP_SECRET=
