.login {
  padding-top: 100rpx;
}
.brand-mark {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand);
  color: #fff;
  font-size: 38rpx;
  font-weight: 750;
  border-radius: 30rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 14rpx 30rpx var(--brand)25;
}
.login-card {
  margin-top: 44rpx;
}

/* Page-specific density, hierarchy and long-content safeguards. */
.login{padding-top:100rpx}.brand-mark{width:88rpx;height:88rpx;border-radius:24rpx;font-size:30rpx;line-height:88rpx;box-shadow:0 8rpx 24rpx rgba(99,50,119,.1)}.login>.title{font-size:40rpx;letter-spacing:1rpx}.login>.subtitle{font-size:25rpx;line-height:1.65;margin-top:10rpx}.login-card{padding:30rpx;margin-top:42rpx;border-radius:24rpx}.login-card .field{margin-bottom:24rpx}.login .hint{font-size:24rpx;line-height:1.65;margin-top:24rpx}
