:host{display:block;min-width:0}.skeleton{width:100%;box-sizing:border-box;pointer-events:none}.block{background:var(--skeleton-fill,#ebe6ef);border-radius:8rpx;box-sizing:border-box}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.item{display:flex;gap:20rpx;align-items:center;box-sizing:border-box;background:var(--surface,#fff);border:1rpx solid var(--line,#eae5ef);border-radius:24rpx;padding:24rpx;margin-bottom:16rpx;min-width:0}.avatar{width:76rpx;height:76rpx;border-radius:22rpx;flex-shrink:0}.lines{flex:1;min-width:0}.line{height:23rpx;width:78%;margin:8rpx 0 16rpx}.medium{width:58%}.short{width:38%}.hero{background:var(--surface,#fff);border:1rpx solid var(--line,#eae5ef);border-radius:24rpx;padding:32rpx 24rpx;margin-bottom:20rpx}.crest{height:96rpx;width:96rpx;border-radius:28rpx;margin:0 auto 24rpx}.title{height:32rpx;width:55%;margin:0 auto 16rpx}.hero>.short{height:20rpx;margin:0 auto}.metrics{display:flex;gap:12rpx;margin-top:28rpx}.metric{flex:1;height:96rpx}.form .item{display:block;padding:24rpx}.field-label{height:22rpx;width:28%;margin-bottom:18rpx}.field{width:100%;height:84rpx;border-radius:16rpx}.cards .items{display:flex;flex-wrap:wrap;gap:16rpx}.cards .item{flex:0 0 calc(50% - 8rpx);width:calc(50% - 8rpx);display:block;margin-bottom:0}.cards .avatar{margin-bottom:20rpx}.cards .line{width:90%}.cards .medium{width:70%}.cards .short{width:48%}.animated .block{animation:skeleton-pulse 1.8s ease-in-out infinite}@keyframes skeleton-pulse{0%,100%{opacity:1}50%{opacity:.6}}@media(prefers-reduced-motion:reduce){.animated .block{animation:none}}
