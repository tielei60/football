.title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.hint {
  font-size: 24rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.feedback {
  color: var(--brand-ink);
  margin-top: 20rpx;
}
button.ui-block {
  width: 100%;
  min-width: 0;
  min-height: 44px;
  white-space: normal;
  box-sizing: border-box;
}
@media (max-width: 375px) {
  .hint {
    font-size: 12px;
  }
}
