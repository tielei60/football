<view class="page"
  ><page-state
    loading="{{loading}}"
    error="{{error}}"
    bind:retry="refresh"
  /><block wx:if="{{!loading && !error && session}}"
    ><view class="card row" bindtap="profile"
      ><view class="avatar large"
        ><image
          wx:if="{{player.avatar}}"
          src="{{player.avatar}}"
          data-target="player"
          binderror="imageError"
          mode="aspectFill"
        /><text wx:else>{{player.initial || '管'}}</text></view
      ><view class="grow"
        ><view class="title">{{player.name || session.user.username}}</view
        ><view class="muted">{{session.team.name}}</view
        ><text class="tag"
          >{{session.user.role==='admin'?'管理员':'球队成员'}}</text
        ></view
      ></view
    ><view wx:if="{{registration}}" class="section"
      ><view class="section-title">{{year}} 年，我的报名</view
      ><view class="metrics"
        ><view class="metric"
          ><text class="number">{{registration.yes}}</text
          ><text class="label">参加</text></view
        ><view class="metric"
          ><text class="number">{{registration.no}}</text
          ><text class="label">请假</text></view
        ><view class="metric"
          ><text class="number">{{registration.maybe}}</text
          ><text class="label">待定</text></view
        ><view class="metric"
          ><text class="number">{{registration.unanswered}}</text
          ><text class="label">未回应</text></view
        ></view
      ><view class="hint">报名状态不等于实际出场。</view></view
    ><view class="card section"
      ><view class="between" bindtap="togglePassword"
        ><text class="bold">修改密码</text
        ><text class="link">{{passwordOpen?'收起':'修改 ›'}}</text></view
      ><view wx:if="{{passwordOpen}}" style="margin-top: 24rpx"
        ><view class="field"
          ><input
            class="input"
            password
            placeholder="当前密码"
            value="{{currentPassword}}"
            data-field="currentPassword" disabled="{{busy}}"
            bindinput="input"
            maxlength="256" /></view
        ><view class="field"
          ><input
            class="input"
            password
            placeholder="新密码，至少10个字符"
            value="{{newPassword}}"
            data-field="newPassword" disabled="{{busy}}"
            bindinput="input"
            maxlength="256" /></view
        ><button
          class="primary"
          loading="{{busy}}"
          disabled="{{busy}}"
          bindtap="changePassword"
        >
          保存并重新登录
        </button></view
      ></view
    ><view class="hint"
      >球队资料仅用于本俱乐部管理。完整战术编辑与资料管理可在网页管理端操作。</view
    ><view wx:if="{{actionError}}" class="error">{{actionError}}</view
    ><button class="danger" disabled="{{busy}}" bindtap="logout">
      退出登录
    </button></block
  ></view
>
