<view class="page"><page-state skeleton-type="form" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error&&authorized}}"><view class="title admin-header">球队设置</view><view class="card"><view class="field"><text class="field-label">球队名称</text><input class="input" value="{{form.name}}" data-field="name" bindinput="input" maxlength="200" disabled="{{loading || (busy)}}"/></view><view class="field"><text class="field-label">队徽</text><image wx:if="{{crest}}" class="picture-preview" src="{{crest}}" mode="aspectFit" binderror="imageError"/><view wx:else class="avatar large">队</view></view><view class="actions"><button bindtap="choose" disabled="{{loading || (busy)}}" class="ui-button" size="mini">选择图片</button><button bindtap="remove" disabled="{{loading || (busy||!crest)}}" class="ui-button" size="mini">移除队徽</button></view><view class="hint">PNG / JPG，最大 2 MB</view></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><button disabled="{{loading}}" wx:if="{{conflict}}" bindtap="reload" class="ui-button ui-block" size="mini">重新载入</button><button class="primary ui-button ui-block" bindtap="save" disabled="{{loading || (busy||conflict)}}" loading="{{busy}}" size="mini">保存设置</button></block></view>
<business-dialog id="business-dialog"/>
