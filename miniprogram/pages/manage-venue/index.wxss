.title{font-size:34rpx}.field-label{font-size:24rpx;margin-bottom:10rpx}
.location-section{margin-top:30rpx;min-width:0}
.location-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:16rpx}
.location-heading .field-label{margin:0}.location-status{font-size:24rpx;color:var(--muted)}
button.location-pick[size="mini"],button.venue-save[size="mini"]{display:flex;justify-content:center;align-items:center;width:100%;max-width:100%;min-width:0;min-height:88rpx;box-sizing:border-box;margin:0;padding:20rpx 24rpx;font-size:27rpx;line-height:1.5;white-space:normal}
.venue-map{display:block;box-sizing:border-box;width:100%;height:460rpx;margin:24rpx 0 0;border-radius:20rpx;border:1rpx solid var(--line);overflow:hidden}
.location-actions{display:flex;gap:20rpx;min-width:0;margin-top:24rpx}
.location-actions>button[size="mini"]{display:flex;justify-content:center;align-items:center;box-sizing:border-box;flex:1 1 0;width:0;min-width:0;max-width:100%;min-height:84rpx;margin:0;padding:18rpx 12rpx;font-size:25rpx;line-height:1.5;white-space:normal}
.location-actions .location-open{background:var(--brand-soft);color:var(--brand-ink)}
.location-actions .location-clear{background:transparent;color:var(--muted);border:1rpx solid var(--line)}
.venue-status{margin-top:32rpx;padding-top:28rpx;border-top:1rpx solid var(--line);gap:20rpx}
.venue-status>text{flex:1;min-width:0;font-size:26rpx}.venue-status switch{flex-shrink:0}
.uncertain-actions{display:flex;flex-direction:column;gap:16rpx;margin:20rpx 0}.hint{line-height:1.65;overflow-wrap:anywhere}
@media(min-width:600px){.venue-map{height:360px}}

/* 管理文字层级：仅文字与组间留白，不改原生输入及业务布局。 */
.title{font-size:34rpx;font-weight:650;color:var(--ink)}
.field-label{font-size:26rpx;font-weight:500;color:var(--ink)}
.location-status{font-size:24rpx;font-weight:500;color:var(--muted)}
.venue-status>text{font-size:26rpx;font-weight:500;color:var(--ink)}
.hint{font-size:25rpx;font-weight:400;line-height:1.65;color:var(--muted)}
@media(max-width:346px){.field-label,.venue-status>text{font-size:12px}}
@media(max-width:360px){.hint{font-size:12px}}
@media(max-width:375px){.location-status{font-size:12px}}
