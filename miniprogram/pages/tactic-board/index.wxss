/* 持久字段标签：输入后仍可识别内容，不改变画布尺寸或触点。 */
.editor-field-label { display:block; margin:8rpx 0; color:var(--muted); font-size:var(--type-field); line-height:1.5; }
.board-wrap{width:100%;margin-top:20rpx;border-radius:20rpx;background:#e8eff1}.row{gap:16rpx}.tag{margin-top:12rpx}canvas{display:block}.title{font-size:34rpx;line-height:1.4}.edit-actions{display:flex;gap:16rpx;margin-top:16rpx}.edit-action{flex:1;text-align:center;padding:18rpx 0;border-radius:16rpx;background:var(--brand-soft);color:var(--brand-ink);font-weight:600;font-size:28rpx;line-height:40rpx}.edit-save{background:var(--brand);color:#fff}.edit-disabled{opacity:.45}

.board-wrap canvas{margin-left:auto;margin-right:auto}

.editor-tools{display:flex;gap:8rpx;align-items:center;margin-top:12rpx}.editor-tools business-picker{flex:1}.editor-tools button{padding:6rpx 14rpx;font-size:24rpx;flex-shrink:0}.properties{padding:12rpx;background:var(--brand-soft);border-radius:14rpx}.properties input{padding:12rpx;background:#fff;border-radius:10rpx;margin-top:8rpx}.properties label{font-size:24rpx}.properties switch{transform:scale(.7)}
.editor-tools{display:grid;grid-template-columns:minmax(0,1fr) 96rpx 96rpx 96rpx;gap:10rpx}.editor-tools business-picker{min-width:0}.editor-tools .picker{box-sizing:border-box;white-space:nowrap;min-height:72rpx;padding:14rpx 16rpx;font-size:26rpx}.editor-tools button.small{width:100%;min-width:0;margin:0;padding:16rpx 0;line-height:40rpx;box-sizing:border-box}.properties .row{flex-wrap:wrap}.properties business-picker{flex:1;min-width:170rpx}.properties .picker{box-sizing:border-box}

/* Page-specific density, hierarchy and long-content safeguards. */
.title{font-size:32rpx;overflow-wrap:anywhere}.row.section{gap:12rpx;align-items:center}.row.section button{width:auto;flex-shrink:0;margin:0;font-size:24rpx}.row.section>.grow{min-width:0}.row>text{font-size:22rpx;white-space:nowrap;flex-shrink:0}.board-wrap{border:1rpx solid var(--line);border-radius:18rpx}.edit-action{font-size:26rpx;padding:14rpx 0}.properties{padding:16rpx;background:var(--brand-soft)}.properties input{line-height:1.5}.hint{font-size:23rpx;line-height:1.6}.editor-tools .picker{overflow:hidden;text-overflow:ellipsis}.prewrap{overflow-wrap:anywhere}

/* Compact read-mode shortcuts; editor actions retain their own layout. */
.board-shortcuts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin:12rpx 0}
.board-shortcuts .shortcut{width:100%;min-width:0;min-height:80rpx;box-sizing:border-box;margin:0;padding:18rpx 10rpx;font-size:25rpx;line-height:40rpx;border-radius:14rpx;background:var(--brand-soft);color:var(--brand-ink)}
.board-shortcuts .shortcut-primary{background:var(--brand);color:#fff}
.playback-controls{gap:10rpx;margin:12rpx 0;min-width:0}
.playback-controls button.small{width:160rpx;min-width:0;flex:0 0 160rpx;box-sizing:border-box;margin:0;padding:14rpx 8rpx;font-size:24rpx;line-height:36rpx}
/* 播放滑块端点保留固定像素净距，避免原生滑块圆钮遮住时间；不改变画布。 */
.playback-controls slider.grow{flex:1;min-width:0;margin:0 18px}
.playback-controls>text{flex:0 0 auto;font-size:24rpx;font-variant-numeric:tabular-nums;white-space:nowrap}

.canvas-focus{padding:8rpx 16rpx 16rpx}.canvas-focus>.section{margin-top:0}.canvas-focus .edit-actions{margin-top:0;gap:10rpx}.canvas-focus .edit-action{padding:8rpx 0;line-height:40rpx;min-height:64rpx}.canvas-focus .editor-tools{margin-top:8rpx}.canvas-focus .editor-tools button.small{padding:10rpx 0}.canvas-focus .editor-tools .picker{min-height:60rpx;padding:10rpx}.canvas-focus .board-wrap{margin-top:8rpx}.selection-status{font-size:22rpx;line-height:28rpx;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.focus-toggle{width:100%;margin:0 0 8rpx;min-height:64rpx;padding:10rpx;font-size:24rpx;line-height:40rpx;background:var(--brand-soft);color:var(--brand-ink)}

/* Compact selectors keep the portrait pitch dominant. */
.picker{background:#fff;border:1rpx solid var(--control-border);border-radius:12rpx;color:var(--brand-ink);padding:12rpx 14rpx;min-height:64rpx;line-height:1.4;font-size:25rpx;gap:10rpx}
.canvas-focus .picker,.canvas-focus .editor-tools .picker{min-height:60rpx;padding:10rpx 12rpx}
.canvas-focus .picker-value,.editor-tools .picker-value{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

.page .edit-actions>button.edit-action{flex:1 1 0;width:0;min-width:0;margin:0;box-sizing:border-box}
.page button.focus-toggle{width:100%;min-width:0;box-sizing:border-box}
.properties input{height:80rpx;min-height:80rpx;padding:0 12rpx;font-size:26rpx;line-height:42rpx;box-sizing:border-box}

/* 战术文字层级：普通信息局部增强，专注工具及画布几何保持。 */
.type-expanded .title{font-weight:650;color:var(--ink)}
.type-expanded .tactic-meta{font-size:26rpx;font-weight:400;color:var(--muted)}
.type-expanded .tag{font-size:24rpx;font-weight:500}
.type-expanded .hint{font-size:24rpx;color:var(--muted)}
.type-expanded .tactic-objective{font-size:28rpx;font-weight:600;color:var(--ink)}
@media(max-width:375px){.type-expanded .tag,.type-expanded .hint{font-size:12px}}
@media(max-width:346px){.type-expanded .tactic-meta{font-size:12px}}

/* 深度视觉层级：保留既有专注与操作几何。 */
.type-expanded .title{font-size:var(--type-page,38rpx);font-weight:600;line-height:1.35}
.type-expanded .tactic-meta,.type-expanded .hint{font-size:var(--type-meta,24rpx);line-height:1.6}
.type-expanded .prewrap{font-size:var(--type-body,28rpx);line-height:1.65}
.type-expanded .tactic-objective{font-size:var(--type-card,30rpx);font-weight:600;line-height:1.5}
@media(max-width:375px){.type-expanded .tactic-meta,.type-expanded .hint{font-size:12px}}

/* 查看信息优先于控制区；专注/编辑条件仍由原模板控制。 */
.type-expanded .board-view-controls{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12rpx;align-items:end;margin:20rpx 0}
.type-expanded .board-view-controls .editor-field-label{grid-column:1/-1;margin:0}
.type-expanded .board-stage-controls{margin:0;min-width:0}
.type-expanded .board-view-controls button.focus-toggle{width:auto;min-width:44px;margin:0;min-height:44px}
.type-expanded .board-view-controls button.small{grid-column:1/-1;width:100%;margin:0;min-height:44px}


/* V3 原生复核：操作层级与紧凑展示，不改变画布及事件。 */
.type-expanded .board-view-controls{grid-template-columns:minmax(0,1fr) auto auto}.type-expanded .board-view-controls button.small{grid-column:auto;width:auto;min-width:44px;padding:10rpx}.type-expanded .board-view-controls button.focus-toggle{padding:10rpx}.type-expanded .playback-controls button.small{background:#fff;border:1rpx solid var(--control-border);border-radius:20rpx;min-height:44px}@media(max-width:360px){.type-expanded .board-view-controls{gap:8rpx}.type-expanded .board-view-controls button{font-size:22rpx}}
/* 原生按钮文字居中与输入光标空间修复。 */
.type-expanded .board-view-controls button,.type-expanded .playback-controls button{display:flex;align-items:center;justify-content:center;min-height:44px}
/* UI v3：保留原 JS 坐标算法；工具区布局已变化，实际画布空间与触点须原生复验。 */
.type-expanded .title { color: var(--brand-ink); font-weight: 700; }
.type-expanded .picker { border-color: var(--control-border); border-radius: 20rpx; }
.type-expanded .card { border-radius: 28rpx; }
.type-expanded .hint { line-height: 1.7; }

.type-expanded .board-shortcuts { margin: 24rpx 0; gap: 16rpx; }
.type-expanded .board-shortcuts .shortcut { border-radius: 20rpx; min-height: 44px; border: 1rpx solid var(--line); }
.type-expanded .focus-toggle { background: #fff; border: 1rpx solid var(--control-border); border-radius: 20rpx; }
.type-expanded .tag { margin-bottom: 12rpx; }

 .type-expanded .picker,.type-expanded button.small,.type-expanded button.focus-toggle,.type-expanded .edit-actions>button.edit-action{min-height:44px;box-sizing:border-box}

/* V3 实际命中区：仅扩大控件盒子，不改变业务坐标。 */
.page.canvas-focus .edit-actions>button.edit-action,.page.canvas-focus button.focus-toggle,.page.canvas-focus .editor-tools button.small,.page.canvas-focus .editor-tools .picker,.page.canvas-focus .picker,.page.canvas-focus .playback-controls button.small,.page .properties input{min-height:44px;box-sizing:border-box}
.page.canvas-focus .editor-tools{grid-template-columns:minmax(0,1fr) 44px 44px 44px}
.page .board-shortcuts .shortcut{min-height:44px}

/* 状态 19–21：编辑摘要、独立只读身份与专注阶段选择，不改变画布尺寸。 */
.board-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.board-title-row .title{flex:1;min-width:0;margin:0;overflow-wrap:anywhere}.board-readonly{flex:none;background:var(--canvas);color:var(--muted)}
.board-source{font-size:var(--type-meta,24rpx);line-height:1.6;margin:16rpx 0;overflow-wrap:anywhere}
.board-edit-summary{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:8rpx 0 12rpx;color:var(--muted);font-size:var(--type-meta,24rpx);line-height:1.5}.board-edit-summary>text:first-child{min-width:0;overflow-wrap:anywhere}.board-edit-summary .tag{flex:none}
.board-focus-identity{font-size:var(--type-meta,24rpx);line-height:1.5;color:var(--muted);margin:4rpx 0 8rpx}
.canvas-focus .board-view-controls{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8rpx;align-items:end;margin:8rpx 0}.canvas-focus .board-view-controls .editor-field-label{grid-column:1/-1;margin:0;font-size:24rpx}.canvas-focus .board-stage-controls{min-width:0;margin:0}.canvas-focus .board-view-controls .focus-toggle{margin:0;min-width:44px;padding:8rpx 12rpx}
@media(max-width:375px){.board-source,.board-edit-summary,.board-focus-identity,.canvas-focus .board-view-controls .editor-field-label{font-size:12px}}
