/* 复用现有紫色主题；独立操作分组避免默认按钮宽度挤压。 */
.field-label{display:block;margin-top:20rpx;margin-bottom:10rpx}
.ai-warning{color:var(--warning);background:var(--warning-soft);padding:20rpx;border-radius:12rpx;line-height:1.6;overflow-wrap:anywhere;margin:16rpx 0}
.ai-picture{width:100%;height:480rpx;display:block;border-radius:16rpx;background:var(--canvas);margin-bottom:16rpx}
.ai-status{font-size:var(--type-card);font-weight:600;color:var(--ink);margin:24rpx 0 16rpx}
.ai-actions{display:flex;gap:16rpx}
.ai-actions>button.ui-button[size=mini]{flex:1;width:0;min-width:0;margin:0;min-height:44px;box-sizing:border-box;white-space:normal}

/* 本页说明层级，不改变全局组件、原图比例或业务动作。 */
.ai-intro,.ai-help{font-size:var(--type-field);line-height:1.6;color:var(--muted);overflow-wrap:anywhere}
.ai-intro{margin-top:16rpx;margin-bottom:24rpx}
.ai-help{margin:12rpx 0}
.ai-disclosure{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.6;font-size:var(--type-body);color:var(--ink)}
.ai-complete{margin-top:16rpx;font-size:var(--type-field);line-height:1.6;color:var(--success)}
.ai-adopted{border-left:6rpx solid var(--success)}
.ai-disabled .muted{line-height:1.6;overflow-wrap:anywhere}
@media(max-width:346.154px){.ai-intro,.ai-help,.ai-complete{font-size:12px}}

/* 页面身份与三步操作分层，候选图片和按钮几何保持原值。 */
.title{font-size:var(--type-page);line-height:1.35}
.section-title{font-size:var(--type-section);line-height:1.4}
.subtitle{font-size:var(--type-meta);margin-top:8rpx}

/* v3 三步工作区：素材、任务、采用各自成卡；状态不依赖颜色判断。 */
.card { padding:32rpx; border-radius:30rpx; }
.section-title { position:relative; padding-left:18rpx; margin-bottom:20rpx; font-size:32rpx; font-weight:650; }
.section-title::before { content:''; position:absolute; left:0; top:8rpx; bottom:8rpx; width:6rpx; border-radius:6rpx; background:var(--brand); }
.ai-intro { margin:24rpx 4rpx 28rpx; font-size:26rpx; }
.ai-disabled { padding-top:40rpx; padding-bottom:40rpx; }
.ai-picture { border-radius:24rpx; background:var(--brand-soft); }
.ai-status { padding:20rpx 24rpx; background:var(--brand-soft); border-radius:20rpx; color:var(--brand-ink); }
.ai-complete { padding:18rpx 22rpx; background:var(--success-soft); border-radius:20rpx; }
.ai-warning { border-radius:20rpx; }
.ai-adopted { border-left-width:4rpx; }
