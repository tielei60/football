/* 本页文字层级；不改变输入、按钮、列数或画布几何。 */
.rank-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eee8f1;
  gap: 18rpx;
}
.rank-row:last-child {
  border: 0;
}
.rank {
  width: 34rpx;
  color: var(--muted);
  font-weight: 500;
  min-width: 56rpx;
  font-size: 26rpx;
}
.rank-value {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--brand-ink);
  font-variant-numeric: tabular-nums;
}
.score-summary {
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 25rpx;
}
.score-summary > text {
  white-space: nowrap;
}
.metrics {
  gap: 12rpx;
}
.metric .number {
  font-size: 38rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
}
.rank-row .grow {
  min-width: 0;
}
.rank-row .bold {
  overflow-wrap: anywhere;
}
.rank-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
}
.ranking-header, .ranking-values {
  display: flex;
  align-items: center;
}
.ranking-header {
  padding: 0 0 10rpx;
  color: var(--muted);
  font-size: 24rpx;
}
.ranking-header-name { flex: 1; }
.ranking-header > text:not(.ranking-header-name), .ranking-values > text {
  width: 62rpx;
  flex-shrink: 0;
  text-align: center;
  font-variant-numeric: tabular-nums;
}
.ranking-values { color: var(--brand-ink); font-size: 28rpx; font-weight: 600; }
.card>.bold {
  overflow-wrap: anywhere;
  line-height: 1.5;
  word-break: break-word;
}
.filter-row .picker {
  white-space: normal;
  line-height: 1.45;
}
.card .between {
  gap: 16rpx;
}
.card .between>.muted {
  min-width: 0;
  overflow-wrap: anywhere;
}
.card .between>text:last-child {
  flex-shrink: 0;
}
.rank,.rank-value {
  flex-shrink: 0;
  white-space: nowrap;
}
.score-summary>text {
  white-space: normal;
  overflow-wrap: anywhere;
  min-width: 0;
}
.page>.title {
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.4;
}
.subtitle {
  font-size: 24rpx;
  line-height: 1.6;
}
.scope-title, .opponent-name, .rank-row .bold {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
}
.metric .label {
  font-size: 25rpx;
}
.card .muted, .hint {
  font-size: 25rpx;
  line-height: 1.6;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
}
.tag {
  font-size: 24rpx;
  font-weight: 500;
}

/* 小屏正文下限 12px，仅覆盖以上内容文字，不影响控件。 */
@media (max-width: 375.000px) {
  .subtitle, .tag { font-size: 12px; }
}
@media (max-width: 360.000px) {
  .metric .label, .card .muted, .hint, .score-summary { font-size: 12px; }
}
@media (max-width: 346.154px) {
  .rank { font-size: 12px; }
}
@media (max-width: 321.429px) {
  .section-title { font-size: 12px; }
}
