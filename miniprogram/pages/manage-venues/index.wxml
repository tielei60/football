<view class="page"><view class="club-page-banner"><view class="club-eyebrow">BERLIN FC</view><view class="club-banner-title">球场管理</view><view class="club-banner-subtitle">球队管理</view><image class="club-banner-mark" src="/assets/team-badge.png" mode="aspectFit" aria-hidden="true"/></view><view class="admin-create-action"><button disabled="{{loading}}" class="primary ui-button ui-block" bindtap="create" size="mini">添加球场</button></view><view class="subtitle">常用球场保存一次，安排比赛直接选</view>
<page-state id="page-state" skeleton-type="list" loading="{{loading}}" error="{{error}}" bind:retry="refresh" empty="{{!venues.length}}"/>
<block wx:if="{{!loading && !error}}"><view class="section-title venues-heading">常用球场</view><view aria-role="button" class="card section" wx:for="{{venues}}" wx:key="id" data-id="{{item.id}}" bindtap="edit" hover-class="club-card-pressed"><view class="between"><text class="bold">{{item.name}}{{item.fieldNumber?' · '+item.fieldNumber:''}}</text><text class="tag {{item.status==='active'?'status-active':'status-inactive'}}">{{item.status==='active'?'可选':'已停用'}}</text></view><view class="muted">{{item.address || '地址未设置'}}</view><view class="link">{{item.latitude!==null?'已设置地图位置':'未设置地图位置'}} · 编辑 ›</view></view></block></view>

<business-dialog id="business-dialog"/>
