<view class="page schedule-page"><view wx:if="{{!loading && !error && tab==='upcoming' && visible.length}}" class="fixture-focus" aria-role="button" data-id="{{visible[0].id}}" bindtap="openMatch" hover-class="club-card-pressed"><image class="focus-image" src="/assets/club-atmosphere.jpg" mode="aspectFill"/><view class="focus-shade"/><view class="focus-content"><view class="focus-context"><text class="focus-label">焦点赛事</text><text>{{visible[0].competition || '球队比赛'}}{{visible[0].format ? ' · '+visible[0].format+'人制' : ''}}</text></view><view class="focus-teams"><view><image wx:if="{{team.crest}}" src="{{team.crest}}" mode="aspectFit" data-target="team" binderror="imageError"/><text wx:else class="focus-fallback">足</text><text>{{team.name}}</text></view><text class="focus-vs">VS</text><view><view class="focus-fallback" aria-hidden="true"><view class="opponent-ball"/></view><text>{{visible[0].opponent}}</text></view></view><view class="focus-meta">{{visible[0].dateLabel}} · {{visible[0].kickoff || '时间待定'}}</view><view class="focus-meta">{{visible[0].location || '地点待定'}}</view><view class="focus-link">查看比赛 · 去报名 ›</view></view></view><view class="tabs"
    ><view aria-role="button"
      class="tab {{tab==='upcoming'?'active':''}}"
      data-tab="upcoming"
      bindtap="changeTab"
      >待比赛</view
    ><view aria-role="button"
      class="tab {{tab==='past'?'active':''}}"
      data-tab="past"
      bindtap="changeTab"
      >已结束</view
    ><view aria-role="button"
      wx:if="{{admin}}"
      class="tab {{tab==='draft'?'active':''}}"
      data-tab="draft"
      bindtap="changeTab"
      >草稿</view
    ></view
  ><view wx:if="{{admin}}" class="schedule-admin-action"><button disabled="{{loading}}" class="ui-button ui-block schedule-create" bindtap="create" size="mini">创建比赛</button></view>
  <page-state id="page-state" skeleton-type="list"
    loading="{{loading}}"
    error="{{error}}"
    empty="{{!visible.length}}"
    bind:retry="refresh"
  /><block wx:if="{{!loading && !error}}"
    ><block wx:for="{{visible}}" wx:key="id"
      ><view wx:if="{{item.monthHeading}}" class="section-title"
        >{{item.monthHeading}}</view
      ><view aria-role="button" class="card" data-id="{{item.id}}" bindtap="openMatch"
         hover-class="club-card-pressed"><view class="fixture-main">
          <view class="date-ticket"><text>{{item.dayLabel}}</text><text>{{item.weekdayLabel}}</text></view>
          <view class="fixture-details">
            <view class="section-title break match-name">{{item.opponent}}</view>
            <view class="muted fixture-competition">{{item.competition || '球队比赛'}}{{item.format ? ' · '+item.format+'人制' : ''}}</view>
            <view class="muted match-time">{{item.dateLabel}} · {{item.kickoff || '时间待定'}}</view>
          </view>
          <view class="fixture-status"><text class="tag {{item.status}}">{{item.statusLabel}}</text><view wx:if="{{item.status==='completed'}}" class="score">{{item.scoreLabel}}</view></view>
        </view
        ><view class="divider"></view
        ><view class="muted break schedule-location">{{item.location || '地点待定'}}</view
        ><view wx:if="{{item.status==='published'}}" class="schedule-signup"
          ><view class="schedule-counts"><text class="signup-count-yes">参加 {{item.signupCountLabel}}</text><text class="signup-count-maybe">{{item.maybeCount}} 人待定</text><text class="signup-count-no">{{item.noCount}} 人请假</text></view
          ><text class="schedule-response">{{item.responseLabel}} ›</text></view
        ></view
      ></block
    ></block
  ></view
>

<business-dialog id="business-dialog"/>
