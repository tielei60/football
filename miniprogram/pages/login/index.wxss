/* v3：品牌氛围与白色登录卡分层，输入尺寸沿用全局原生控件。 */
.login { padding-top: 0; }
.login-art { position:relative; margin:0 -28rpx; padding:52rpx 32rpx 64rpx; text-align:center; color:#fff; background:linear-gradient(135deg,#4d125f,#760b88 65%,#9345ae); border-radius:0 0 48rpx 48rpx; }
.brand-mark { width:144rpx; height:144rpx; margin:0 auto 24rpx; display:flex; align-items:center; justify-content:center; }
.brand-image { width:144rpx; height:144rpx; display:block; }
.brand-fallback { font-size:28rpx; line-height:1.5; font-weight:600; }
.login-eyebrow { font-size:22rpx; letter-spacing:3rpx; color:#d9e9ff; line-height:1.6; }
.login-art .title { margin:16rpx 0 8rpx; color:#fff; font-size:52rpx; line-height:1.4; font-weight:750; }
.login-team { font-size:28rpx; color:#efe1f7; }
.login-card { position:relative; margin-top:-24rpx; padding:36rpx 32rpx; border-radius:32rpx; box-shadow:0 12rpx 32rpx rgba(81,18,98,.08); }
.login-card .field { margin-bottom:28rpx; }
.field-label { font-size:26rpx; color:var(--muted); font-weight:500; margin-bottom:12rpx; }
.login .hint { font-size:24rpx; line-height:1.7; text-align:center; margin:24rpx 20rpx 0; }
.wechat-entry { padding-top:0; }
.wechat-entry .card { padding:28rpx; }
.wechat-entry .hint { font-size:24rpx; line-height:1.6; margin-top:20rpx; }
.error { font-size:26rpx; line-height:1.6; overflow-wrap:anywhere; }
@media(max-height:650px) { .login-art { padding-top:28rpx; padding-bottom:48rpx; } .brand-mark,.brand-image { width:112rpx; height:112rpx; } }

/* 品牌背景仅作氛围，队徽、标题与表单保持真实独立元素。 */
.login-art { overflow:hidden; }
.login-atmosphere,.login-shade { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
.login-atmosphere { opacity:.46; }
.login-shade { background:linear-gradient(110deg,rgba(61,8,77,.8),rgba(87,8,105,.55)); }
.brand-mark,.login-eyebrow,.login-art .title,.login-team { position:relative; }

/* V3 登录原稿队徽视觉比例；不随短屏缩成难辨识的小图。 */
.brand-mark,.brand-image{width:216rpx;height:216rpx}
.login-art{padding-top:60rpx;padding-bottom:64rpx}
@media(max-height:650px){.brand-mark,.brand-image{width:192rpx;height:192rpx}.login-art{padding-top:40rpx}}
