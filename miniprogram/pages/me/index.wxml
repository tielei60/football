<view class="page"
  ><page-state id="page-state" skeleton-type="detail"
    loading="{{loading}}"
    error="{{error}}"
    bind:retry="refresh"
  /><block wx:if="{{!loading && !error && session}}"
    ><view aria-role="{{player?'button':''}}" class="card row membership-hero" bindtap="profile"
      ><image class="membership-watermark" src="/assets/team-badge.png" mode="aspectFit" aria-hidden="true"/><view class="avatar large {{!player.avatar?'player-placeholder':''}}"
        ><image
          wx:if="{{player.avatar}}"
          src="{{player.avatar}}"
          data-target="player"
          binderror="imageError"
          mode="aspectFill"
        /><text wx:else>{{player.initial || (session.user.role==='player'?'球':'管')}}</text></view
      ><view class="grow"
        ><text wx:if="{{player.avatarGenerated}}" class="tag generated-origin">{{player.avatarOriginLabel}}</text><view class="title">{{player.name || session.user.username}}</view
        ><view class="muted team-name">{{session.team.name}}</view
        ><text class="tag"
          >{{session.user.systemAdmin?'系统管理员':session.user.role==='admin'?'管理员':session.user.role==='player'?'球员':'球队成员'}}</text
        ></view
      ><view wx:if="{{player && player.number!==null && player.number!==undefined}}" class="member-shirt"><text>{{player.number}}</text><text>我的号码</text></view></view
    ><view wx:if="{{player}}" class="member-shortcuts"><button wx:if="{{player}}" bindtap="profile" class="ui-button" size="mini"><image src="/assets/me-active.png"/><text>我的资料</text></button><button bindtap="matches" class="ui-button" size="mini"><image src="/assets/schedule-active.png"/><text>球队比赛</text></button><button wx:if="{{player}}" bindtap="photos" class="ui-button" size="mini"><image src="/assets/photos-shortcut.png"/><text>出场照片</text></button><button bindtap="tactics" class="ui-button" size="mini"><image src="/assets/tactics-shortcut.png"/><text>球队战术</text></button></view><view wx:if="{{session.user.role==='admin'}}" class="section management-section"><view class="section-title">球队管理</view><view class="management-grid"><button disabled="{{loading}}" data-page="team" bindtap="manage" class="ui-button" size="mini"><image class="management-icon" src="/assets/ui-v3-shield.png" mode="aspectFit" aria-hidden="true"/><text>球队资料</text></button><button disabled="{{loading}}" data-page="players" bindtap="manage" class="ui-button" size="mini"><image class="management-icon" src="/assets/ui-v3-people.png" mode="aspectFit" aria-hidden="true"/><text>球员与账号</text></button><button disabled="{{loading}}" data-page="seasons" bindtap="manage" class="ui-button" size="mini"><image class="management-icon" src="/assets/ui-v3-calendar.png" mode="aspectFit" aria-hidden="true"/><text>赛季管理</text></button><button disabled="{{loading}}" data-page="venues" bindtap="manage" class="ui-button" size="mini"><image class="management-icon" src="/assets/ui-v3-pin.png" mode="aspectFit" aria-hidden="true"/><text>球场管理</text></button><button disabled="{{loading}}" data-page="competitions" bindtap="manage" class="ui-button" size="mini"><image class="management-icon" src="/assets/ui-v3-trophy.png" mode="aspectFit" aria-hidden="true"/><text>赛事管理</text></button><button disabled="{{loading}}" data-page="opponents" bindtap="manage" class="ui-button" size="mini"><image class="management-icon" src="/assets/ui-v3-shield.png" mode="aspectFit" aria-hidden="true"/><text>对手管理</text></button><button disabled="{{loading}}" data-page="notices" bindtap="manage" class="ui-button" size="mini"><image class="management-icon" src="/assets/ui-v3-calendar.png" mode="aspectFit" aria-hidden="true"/><text>比赛须知</text></button><button wx:if="{{session.user.systemAdmin}}" disabled="{{loading}}" bindtap="systemAccounts" class="ui-button" size="mini"><image class="management-icon" src="/assets/ui-v3-lock.png" mode="aspectFit" aria-hidden="true"/><text>系统账号</text></button></view></view><view wx:if="{{registration}}" class="section"
      ><view class="registration-heading"><view class="section-title">我的报名</view><text class="registration-year">{{year}} 年</text></view
      ><view class="metrics"
        ><view class="metric"
          ><text class="number">{{registration.yes}}</text
          ><text class="label">参加</text></view
        ><view class="metric"
          ><text class="number">{{registration.no}}</text
          ><text class="label">请假</text></view
        ><view class="metric"
          ><text class="number">{{registration.maybe}}</text
          ><text class="label">待定</text></view
        ><view class="metric"
          ><text class="number">{{registration.unanswered}}</text
          ><text class="label">未回应</text></view
        ></view
      ><view class="hint">报名状态不等于实际出场。</view></view
    ><view class="section account-section"><view class="section-title">球队与账号</view><view class="card account-menu"><button wx:if="{{player}}" disabled="{{loading || busy}}" bindtap="profile" class="ui-button account-row" size="mini"><image class="account-icon" src="/assets/me-active.png"/><text class="account-row-title">我的球员资料</text><text class="account-row-meta">{{player.name}}<block wx:if="{{player.number!==null && player.number!==undefined}}"> · {{player.number}}号</block></text><text class="account-chevron">›</text></button><button disabled="{{loading}}" bindtap="tactics" class="ui-button account-row" size="mini"><image class="account-icon" src="/assets/tactics-shortcut.png"/><text class="account-row-title">球队战术板</text><text class="account-chevron">›</text></button><button disabled="{{loading || busy}}" bindtap="statistics" class="ui-button account-row" size="mini"><image class="account-icon" src="/assets/ui-v3-trophy.png"/><text class="account-row-title">球队数据</text><text class="account-row-meta">赛季与自然年</text><text class="account-chevron">›</text></button><view wx:if="{{session.user.passwordEnabled!==false}}" class="account-password"
      ><view aria-role="button" class="between account-row account-password-toggle" bindtap="togglePassword"
        ><image class="account-icon" src="/assets/ui-v3-lock.png"/><text class="bold account-heading account-row-title">修改密码</text
        ><text class="link">{{passwordOpen?'收起':'修改 ›'}}</text></view
      ><view wx:if="{{passwordOpen}}" class="account-password-form" style="margin-top: 24rpx"
        ><view class="field"
          ><text class="field-label">当前密码</text><input
            class="input"
            password
            placeholder="当前密码"
            value="{{currentPassword}}"
            data-field="currentPassword" disabled="{{loading || (busy)}}"
            bindinput="input"
            maxlength="256" /></view
        ><view class="field"
          ><text class="field-label">新密码</text><input
            class="input"
            password
            placeholder="新密码，10–200个字符"
            value="{{newPassword}}"
            data-field="newPassword" disabled="{{loading || (busy)}}"
            bindinput="input"
            maxlength="200" /></view
        ><button
          class="primary ui-button ui-block"
          loading="{{busy}}"
          disabled="{{loading || (busy)}}"
          bindtap="changePassword"
         size="mini">保存并重新登录</button></view
      ></view></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view></view
    ><button class="danger ui-button ui-block account-logout" disabled="{{loading || (busy)}}" bindtap="logout" size="mini">退出 / 切换账号</button></block
  ></view
>

<business-dialog id="business-dialog"/>
