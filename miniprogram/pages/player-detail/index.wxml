<view class="page player-detail-page">
  <page-state id="page-state" skeleton-type="detail" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/>
  <block wx:if="{{!loading && !error && player}}">
    <view class="profile-sheet"><image class="profile-watermark" src="/assets/team-badge.png" mode="aspectFit" aria-hidden="true"/>
      <view class="profile-main"><view class="avatar large profile-avatar {{!player.avatar?'player-placeholder':''}}"><image wx:if="{{player.avatar}}" src="{{player.avatar}}" data-target="player" binderror="imageError" mode="aspectFill"/><text wx:else>{{player.initial}}</text></view><view class="profile-identity"><view class="profile-name">{{player.name}}</view><view class="profile-tags"><text class="membership">{{player.membershipLabel}}</text><text wx:if="{{player.avatarGenerated}}" class="generated-origin profile-origin">{{player.avatarOriginLabel}}</text></view></view><view wx:if="{{player.number!==null && player.number!==undefined}}" class="profile-number"><text class="profile-number-value">{{player.number}}</text><text class="profile-number-label">号</text></view></view>
      <view class="profile-details"><view class="profile-detail"><text class="detail-label">位置</text><text class="detail-value">{{player.positionLabel}}</text></view><view class="profile-detail"><text class="detail-label">惯用脚</text><text class="detail-value">{{player.preferredFoot || '未设置'}}</text></view><view wx:if="{{player.number===null || player.number===undefined}}" class="profile-detail"><text class="detail-label">号码</text><text class="detail-value">未设置</text></view></view>
    </view>
    <button bindtap="openPhotos" class="ui-button photo-link" size="mini"><view class="photo-link-title"><image class="photo-link-icon" src="/assets/photos-shortcut.png" aria-hidden="true"/><text>出场照片</text></view><text class="photo-arrow" aria-hidden="true">›</text></button>
    <block wx:if="{{record}}">
      <view class="profile-section"><view class="profile-section-heading"><text class="section-heading-title">比赛表现</text><text class="scope-label">{{scopeLabel}}</text></view><view class="performance-card"><view class="performance-row"><view class="performance-item"><text class="performance-value">{{record.appearances}}</text><text class="performance-label">确认出场</text></view><view class="performance-item"><text class="performance-value">{{record.goalsLabel}}</text><text class="performance-label">进球</text></view><view class="performance-item"><text class="performance-value">{{record.assistsLabel}}</text><text class="performance-label">助攻</text></view></view><view class="coverage-note">进球有记录 {{record.goalsKnownMatches}} 场 · 助攻有记录 {{record.assistsKnownMatches}} 场</view><view class="coverage-note">出场待确认 {{record.unknownAppearances}} 场 · 未录入名单 {{record.unrecordedMatches}} 场</view><view class="coverage-note">“—”表示未记录</view></view></view>
      <view class="profile-section registration-section"><view class="profile-section-heading"><text class="section-heading-title">报名记录</text><text class="scope-label">{{scopeLabel}}</text></view><view class="registration-row"><view class="registration-item"><text class="registration-value signup-count-yes">{{record.registration.yes}}</text><text class="registration-label">参加</text></view><view class="registration-item"><text class="registration-value signup-count-maybe">{{record.registration.maybe}}</text><text class="registration-label">待定</text></view><view class="registration-item"><text class="registration-value signup-count-no">{{record.registration.no}}</text><text class="registration-label">请假</text></view><view class="registration-item"><text class="registration-value">{{record.registration.unanswered}}</text><text class="registration-label">未回应</text></view></view></view>
    </block>
    <view wx:else class="profile-section profile-empty"><text>当前统计范围暂无球员记录</text></view>
  </block>
</view>
<business-dialog id="business-dialog"/>
