.notice{height:280rpx;width:100%;box-sizing:border-box}.photo{width:100%;height:360rpx;border-radius:18rpx;background:#f4edf7;margin-bottom:18rpx}.actions{margin-top:16rpx}.section-title{margin-top:24rpx}.prewrap{white-space:pre-wrap}

