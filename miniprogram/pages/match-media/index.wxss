.notice{height:280rpx;width:100%;box-sizing:border-box}.photo{width:100%;height:360rpx;border-radius:18rpx;background:var(--canvas);margin-bottom:18rpx}.actions{margin-top:16rpx}.section-title{margin-top:24rpx}.prewrap{white-space:pre-wrap}

/* Page-specific density, hierarchy and long-content safeguards. */
.photo{border-radius:18rpx;margin-bottom:16rpx}.card .between{gap:14rpx;align-items:flex-start}.card .between>text:first-child{flex:1;min-width:0;overflow-wrap:anywhere;line-height:1.55}.card .between .tag{flex-shrink:0}.card .actions{gap:12rpx;margin-top:18rpx}.card .actions button{font-size:25rpx;padding:16rpx 12rpx}.notice{min-height:220rpx;line-height:1.7}.card>.input{margin:16rpx 0}.prewrap{line-height:1.75}

/* 相册排序独立双列，避免与封面、移除操作挤在同一行。 */
.photo-order-actions{display:flex;gap:12rpx;margin-top:12rpx;min-width:0}
.photo-order-actions button.ui-button[size="mini"]{flex:1 1 0;width:0;min-width:0;min-height:44px;margin:0;box-sizing:border-box;padding:16rpx 12rpx;line-height:1.5;white-space:nowrap}

/* 比赛文字层级：只读须知与照片说明；不覆盖管理员 textarea。 */
.section-title{font-size:var(--type-section);font-weight:600}
.prewrap{font-size:var(--type-body);line-height:1.7}
.photo-caption{font-size:var(--type-body);font-weight:500;color:var(--ink)}
.card .tag{font-size:24rpx;font-weight:500}
.hint{font-size:var(--type-meta);line-height:1.6;color:var(--muted)}
.upload-uncertain{font-weight:500;color:var(--ink)}
.error{font-size:26rpx;font-weight:500}
@media(max-width:375px){.card .tag{font-size:12px}}
@media(max-width:360px){.hint{font-size:12px}}
@media(max-width:346px){.error{font-size:12px}}
@media(max-width:333px){.photo-caption{font-size:var(--type-body)}}
@media(max-width:321px){.section-title{font-size:var(--type-section)}.prewrap{font-size:var(--type-body)}}

/* v3：须知与相册各自成组，媒体操作不挤压图片说明。 */
.card { padding:28rpx; border-radius:30rpx; }
.section-title { margin:36rpx 0 18rpx; padding-left:18rpx; border-left:6rpx solid var(--brand); }
.photo { height:420rpx; border-radius:24rpx; }
.card .between { padding:4rpx 0 12rpx; flex-wrap:wrap; }
.photo-order-actions { padding-top:16rpx; border-top:1px solid var(--line); }
.prewrap { display:block; overflow-wrap:anywhere; }
