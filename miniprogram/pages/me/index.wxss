/* 本页文字层级；不改变输入、按钮、列数或画布几何。 */
.management-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 12rpx;
}
.management-grid button {
  width: 100%;
  margin: 0;
  font-size: 26rpx;
  min-width: 0;
  padding: 22rpx 12rpx;
  line-height: 1.4;
}
.card.row {
  gap: 22rpx;
}
.card.row .title {
  font-size: var(--type-page);
  overflow-wrap: anywhere;
  font-weight: 650;
  line-height: 1.4;
}
.card.row .grow {
  min-width: 0;
}
.card.row .avatar {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
}
.metrics {
  gap: 10rpx;
}
.metric .number {
  font-size: 38rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
}
.metric .label {
  font-size: 25rpx;
}
.card .tag {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.page>button.danger {
  margin-top: 24rpx;
}
.team-name {
  font-size: var(--type-field);
  line-height: 1.6;
}
.section-title, .account-heading {
  font-size: var(--type-section);
  font-weight: 600;
}
.hint {
  font-size: var(--type-meta);
  line-height: 1.6;
}
.error {
  font-size: 26rpx;
  font-weight: 500;
}

/* 小屏正文下限 12px，仅覆盖以上内容文字，不影响控件。 */
@media (max-width: 375.000px) {
  .card .tag, .hint { font-size: 12px; }
}
@media (max-width: 360.000px) {
  .metric .label { font-size: 12px; }
}
@media (max-width: 346.154px) {
  .team-name, .error { font-size: 12px; }
}
@media (max-width: 321.429px) {
  .section-title, .account-heading { font-size: var(--type-section); }
}

/* Management shortcuts use the same restrained card treatment as match tools. */
.page .management-grid>button.ui-button[size="mini"]{min-height:88rpx;border:1rpx solid #e7dfeb;border-radius:18rpx;background:#fff;color:var(--brand-ink);box-shadow:0 4rpx 14rpx rgba(46,32,54,.035);font-weight:600}
.page .management-grid>button.ui-button[disabled]{background:#eeebf1;color:#8b8191;border-color:transparent;box-shadow:none}

/* V3：俱乐部品牌与内容分层，数据及操作由原页面维护。 */
.membership-hero.card{position:relative;margin:-28rpx -28rpx 0;padding:48rpx 32rpx 64rpx;border:0;border-radius:0 0 38rpx 38rpx;background:linear-gradient(110deg,#570a6b,#80228b 72%,#9b57b1);color:#fff;min-height:270rpx}.membership-hero.card .title{color:#fff;font-size:44rpx}.membership-hero .team-name{color:#efdcf6}.membership-hero.card .avatar{border:6rpx solid #fff;width:128rpx;height:128rpx;border-radius:50%;box-shadow:0 0 0 2rpx #c984d9}.member-shirt{display:flex;flex-direction:column;text-align:center;flex:none;color:#e8bcf3}.member-shirt text:first-child{font-size:68rpx;font-style:italic;font-weight:800;line-height:1.2}.member-shirt text:last-child{font-size:22rpx;color:#f4dffb}.member-shortcuts{display:flex;position:relative;gap:16rpx;margin:-24rpx 0 30rpx}.page .member-shortcuts button.ui-button[size="mini"]{flex:1;min-width:0;margin:0;min-height:104rpx;border:1rpx solid #e1cdef;background:linear-gradient(125deg,#fff,#f5edff);border-radius:26rpx;box-shadow:0 6rpx 18rpx #6a006812;font-size:26rpx}.metrics{padding:20rpx 8rpx;background:#fff;border:1rpx solid #e5d7f3;border-radius:28rpx;box-shadow:0 5rpx 16rpx #6a00680c}.metric .number{font-size:50rpx}.metric+.metric{border-left:1rpx solid var(--line)}.section-title{border-left:6rpx solid var(--brand);padding-left:14rpx}.page .management-grid>button.ui-button[size="mini"]{background:linear-gradient(125deg,#fff,#f6efff);border-color:#e1d1ee;border-radius:24rpx;min-height:100rpx}@media(max-width:350px){.member-shirt text:first-child{font-size:54rpx}.membership-hero.card .avatar{width:108rpx;height:108rpx}}

.club-quick,.member-shortcuts{display:flex;gap:12rpx;margin:26rpx 0}.page .club-quick button.ui-button[size="mini"],.page .member-shortcuts button.ui-button[size="mini"]{display:flex;flex:1;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;min-height:132rpx;padding:20rpx 4rpx;margin:0;background:linear-gradient(125deg,#fff,#f5edff);border:1rpx solid #e1cdef;border-radius:24rpx;font-size:24rpx;box-shadow:0 6rpx 18rpx #6a006810}.club-quick image,.member-shortcuts image{width:44rpx;height:44rpx}.member-shortcuts{margin-top:-24rpx}.membership-hero{flex-wrap:wrap}.member-shirt{max-width:100%;margin-left:auto}.member-shirt text:first-child{font-size:60rpx}.membership-hero .grow{min-width:180rpx}

/* 管理入口的页级 100rpx 规则优先于全局控件；窄屏单独守住 44px。 */
@media(max-width:330px){.page .management-grid>button.ui-button[size="mini"]{min-height:44px}}

/* 身份区队徽仅为装饰；内容与触控保持在上层。 */
.membership-hero.card{overflow:hidden}
.membership-watermark{position:absolute;right:-24rpx;top:8rpx;width:280rpx;height:280rpx;opacity:.08;pointer-events:none;z-index:0}
.membership-hero>.avatar,.membership-hero>.grow,.membership-hero>.member-shirt{position:relative;z-index:1}

/* 按 V3 长图收拢现有账号操作；不添加尚无业务处理的入口。 */
.account-menu.card{padding:0 28rpx;background:#fff;border:1rpx solid var(--line);border-radius:28rpx;overflow:hidden}
.page .account-menu .account-row{display:flex;align-items:center;gap:20rpx;min-height:56px;width:100%;margin:0;padding:22rpx 0;border:0;border-radius:0;background:transparent;box-shadow:none;text-align:left;color:var(--ink);line-height:1.5}
.page .account-menu button.account-row::after{border:0}
.account-icon{flex:none;width:36rpx;height:36rpx}
.account-row-title{flex:1;min-width:0;font-size:var(--type-section);font-weight:600;overflow-wrap:anywhere}
.account-chevron{color:var(--brand);font-size:36rpx}
.account-password{border-top:1rpx solid var(--line)}
.account-password-form{padding-bottom:28rpx}
.page button.account-logout.ui-button[size="mini"]{min-height:44px;margin:28rpx 0 0;background:transparent;border-color:transparent;color:var(--muted);box-shadow:none;font-weight:600}
.page button.account-logout.ui-button[disabled]{color:var(--muted);opacity:.55}
