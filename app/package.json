{
  "name": "coco-tactix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:bundle": "node scripts/check-bundle.mjs",
    "profile:performance": "node scripts/profile-performance.mjs",
    "test:e2e": "playwright test",
    "dev": "node scripts/develop.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch ../server/index.mjs",
    "start": "node ../server/index.mjs",
    "test:server": "node --test ../server/*.test.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write .",
    "lint-format": "npm run lint && npm run format"
  },
  "dependencies": {
    "@vueuse/core": "^10.11.0",
    "dexie": "^4.4.5",
    "element-plus": "^2.8.8",
    "lucide-vue-next": "^0.577.0",
    "mitt": "^3.0.1",
    "mobile-device-detect": "^0.4.3",
    "nanoid": "^5.1.2",
    "pinia": "^2.2.5",
    "pinia-plugin-persistedstate": "4.2.0",
    "roughjs": "^4.6.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue": "^3.4.21",
    "vue-router": "4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.12.5",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.29.0",
    "npm-run-all": "^4.1.5",
    "npm-run-all2": "^6.1.2",
    "prettier": "^3.3.3",
    "sass": "^1.81.0",
    "sass-embedded": "^1.80.2",
    "typescript": "~5.4.0",
    "vite": "^5.2.8",
    "vite-plugin-compression": "^0.5.1",
    "vue-tsc": "^2.0.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
