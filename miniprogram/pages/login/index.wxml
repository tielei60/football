<view class="page login {{wechatEnabled?'login-with-wechat':''}}"><view class="login-art"><image class="login-atmosphere" src="/assets/club-atmosphere.jpg" mode="aspectFill" aria-hidden="true"/><view class="login-shade"></view><view class="brand-mark">
    <image wx:if="{{!badgeFailed}}" class="brand-image" src="/assets/team-badge.png" mode="aspectFit" binderror="badgeError" aria-label="柏林花园 FC 队徽" />
    <text wx:else class="brand-fallback">柏林花园 FC</text>
  </view><view class="login-eyebrow">BERLIN SECRET GARDEN</view><view class="title">欢迎归队</view><view class="login-team">柏林花园 FC</view></view
  ><view class="card login-card"
    ><view class="field"
      ><text class="field-label">账号</text
      ><input
        class="input"
        value="{{username}}"
        bindinput="username"
        placeholder="俱乐部账号"
        maxlength="100"
        disabled="{{busy}}" /></view
    ><view class="field"
      ><text class="field-label">密码</text
      ><input
        class="input"
        password
        value="{{password}}"
        bindinput="password"
        placeholder="输入密码"
        maxlength="256"
        disabled="{{busy}}"
        confirm-type="done"
        bindconfirm="submit" /></view
    ><view wx:if="{{error}}" class="error">{{error}}</view
    ><button
      class="primary ui-button ui-block"
      loading="{{busy}}"
      disabled="{{busy}}"
      bindtap="submit"
     size="mini">登录</button></view
  ><view class="hint">管理员与球员共用此入口，登录后按账号权限显示功能。账号问题请联系球队管理员。</view></view
>

<view wx:if="{{wechatEnabled}}" class="page wechat-entry"><view class="card"><button class="ui-button ui-block wechat-login-button" bindtap="wechatLogin" disabled="{{busy}}" size="mini">微信登录</button><button class="ui-button ui-block wechat-invite-button" bindtap="acceptInvite" disabled="{{busy}}" size="mini">接受球队邀请</button><view class="hint">仅限已获邀请并批准的球队成员，不开放注册。</view></view></view>
<business-dialog id="business-dialog"/>
