/* UI v3：战术工作台的品牌页头，不参与画布坐标计算。 */
.tactical-header { margin: -32rpx -28rpx 28rpx; padding: 36rpx 28rpx 40rpx; background: linear-gradient(120deg,#5b106d,#84299b); color: #fff; border-radius: 0 0 32rpx 32rpx; }
.tactical-eyebrow { font-size: 22rpx; letter-spacing: 4rpx; color: #d8eaff; margin-bottom: 10rpx; }
.tactical-header .title { font-size: 44rpx; line-height: 1.4; font-weight: 700; color: #fff; margin: 0; overflow-wrap: anywhere; }
.tactical-subtitle { margin-top: 12rpx; color: #f1e5f7; font-size: 24rpx; line-height: 1.65; }

.section-title { display: flex; align-items: center; gap: 16rpx; margin: 0 0 24rpx; font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.step-number { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 52rpx; height: 52rpx; background: var(--brand-soft); color: var(--brand); font-size: 24rpx; border-radius: 16rpx; font-variant-numeric: tabular-nums; }
.filename { overflow-wrap: anywhere; padding: 20rpx; background: var(--brand-soft); border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; margin: 24rpx 0 14rpx; }
.actions button { margin-top: 22rpx; min-height: 44px; }
.warning { color: var(--warning); background: var(--warning-soft); border-left: 4rpx solid var(--warning); padding: 20rpx; border-radius: 12rpx; margin: 18rpx 0; font-size: 26rpx; line-height: 1.65; }
.summary { line-height: 1.8; }
.transfer-count { font-size: 28rpx; font-weight: 600; color: var(--ink); margin-bottom: 22rpx; }
.card > .hint { font-size: 24rpx; line-height: 1.7; }
.card > button { margin-top: 20rpx; }
