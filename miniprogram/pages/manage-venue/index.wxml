<view class="page">
 <view class="title">{{editing?'编辑球场':'添加球场'}}</view>
 <page-state id="page-state" skeleton-type="form" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/>
 <block wx:if="{{!loading && !error}}">
  <view class="card section">
   <view class="field"><text class="field-label">球场名称 *</text><input class="input" value="{{form.name}}" data-field="name" bindinput="input" maxlength="200" disabled="{{loading || (busy)}}" placeholder="球场名称"/></view>
   <view class="field"><text class="field-label">地址</text><input class="input" value="{{form.address}}" data-field="address" bindinput="input" maxlength="300" disabled="{{loading || (busy)}}" placeholder="通过地图选择，或填写地址"/></view>
   <view class="location-section">
    <view class="location-heading"><text class="field-label">球场位置</text><text wx:if="{{markers.length}}" class="location-status">已选点</text></view>
    <button id="venue-pick" size="mini" class="primary location-pick" bindtap="choose" disabled="{{loading || (busy)}}">{{markers.length?'重新选择位置':'微信地图选点'}}</button>
    <block wx:if="{{markers.length}}">
     <map hidden="{{businessUiBlocking}}" class="venue-map" latitude="{{form.latitude}}" longitude="{{form.longitude}}" markers="{{markers}}" scale="16" aria-label="已选择的球场位置"/>
     <view class="location-actions"><button id="venue-open" size="mini" disabled="{{loading}}" class="location-open" bindtap="open">查看位置</button><button id="venue-clear" size="mini" class="location-clear" bindtap="clear" disabled="{{loading || (busy)}}">移除坐标</button></view>
    </block>
   </view>
   <view class="between venue-status"><text>比赛安排中可选</text><switch checked="{{form.status==='active'}}" color="#8845A0" bindchange="status" disabled="{{busy}}"/></view>
  </view>
  <view wx:if="{{actionError}}" class="error">{{actionError}}</view>
  <view wx:if="{{uncertain}}" class="uncertain-actions"><button disabled="{{loading}}" bindtap="checkList">返回球场列表核对</button><button disabled="{{loading}}" class="ghost" bindtap="confirmAbsent">已核对，确认未创建</button></view>
  <button id="venue-save" size="mini" class="primary venue-save" bindtap="save" loading="{{busy}}" disabled="{{loading || (busy||conflict||uncertain)}}">保存球场</button>
  <view class="hint">停用不影响历史比赛。地图选点由微信处理，取消选择不会更改原位置。</view>
 </block>
</view>
<business-dialog id="business-dialog"/>
