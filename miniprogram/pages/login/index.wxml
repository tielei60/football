<view class="page login"
  ><view class="brand-mark">FC</view><view class="title">欢迎归队</view
  ><view class="subtitle">管理员与球员共用此入口，登录后显示对应功能</view
  ><view class="card login-card"
    ><view class="field"
      ><text class="field-label">账号</text
      ><input
        class="input"
        value="{{username}}"
        bindinput="username"
        placeholder="俱乐部账号"
        maxlength="100"
        disabled="{{busy}}" /></view
    ><view class="field"
      ><text class="field-label">密码</text
      ><input
        class="input"
        password
        value="{{password}}"
        bindinput="password"
        placeholder="输入密码"
        maxlength="256"
        disabled="{{busy}}"
        confirm-type="done"
        bindconfirm="submit" /></view
    ><view wx:if="{{error}}" class="error">{{error}}</view
    ><button
      class="primary ui-button ui-block"
      loading="{{busy}}"
      disabled="{{busy}}"
      bindtap="submit"
     size="mini">登录</button></view
  ><view class="hint">使用球队分配的账号。账号或密码问题请联系球队管理员。</view></view
>

<view wx:if="{{wechatEnabled}}" class="page wechat-entry"><view class="card"><button class="primary ui-button ui-block" bindtap="wechatLogin" disabled="{{busy}}" size="mini">微信登录</button><button class="ui-button ui-block" bindtap="acceptInvite" disabled="{{busy}}" size="mini">接受球队邀请</button><view class="hint">仅限已获邀请并批准的球队成员，不开放注册。</view></view></view>
<business-dialog id="business-dialog"/>
