/* UI v3：管理页共享视觉由 app.wxss 令牌与品牌横幅提供。 */
.admin-header { gap:16rpx; flex-wrap:wrap; margin:24rpx 0; }
.field-label { font-size:26rpx; font-weight:500; color:var(--muted); margin-bottom:12rpx; }
.hint,.subtitle { font-size:24rpx; line-height:1.65; color:var(--muted); }
.section-title { font-size:32rpx; font-weight:650; line-height:1.4; }
.card { padding:34rpx; }
.error { overflow-wrap:anywhere; }
 .crest-editor { margin-top:32rpx; padding:28rpx; border:1px dashed var(--line); border-radius:28rpx; background:var(--canvas); text-align:center; }
.crest-editor .picture-preview { display:block; width:256rpx; height:256rpx; margin:20rpx auto; }
.crest-editor .avatar { margin:20rpx auto; }
.actions { display:flex; gap:16rpx; }
.actions button.ui-button[size="mini"] { flex:1; min-width:0; min-height:44px; white-space:normal; }

/* V3 队徽字段：标签在预览框外，主要选择为描边、移除为弱操作。 */
.crest-field{margin-top:32rpx}
.crest-field .crest-editor{margin-top:16rpx;min-height:300rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box}
.page .actions button.crest-choose.ui-button[size="mini"]{display:flex;align-items:center;justify-content:center;gap:14rpx;background:var(--surface);border:1rpx solid var(--control-border);color:var(--brand-ink);box-shadow:none}
.crest-action-icon{width:32rpx;height:32rpx;flex:none}
.page .actions button.crest-remove.ui-button[size="mini"]{background:transparent;border-color:transparent;color:var(--muted);box-shadow:none}
.page .actions button.crest-remove.ui-button[disabled]{background:transparent}
.page .actions button.crest-choose.ui-button[size="mini"][disabled],.page .actions button.crest-remove.ui-button[size="mini"][disabled]{opacity:.5;box-shadow:none}
