# Docker compose reads this file only when copied to .env. Never commit .env.
# Set a strong unique password before first startup. Remove both bootstrap
# variables after creating the first admin; existing passwords are never reset.
FOOTBALL_ADMIN_USERNAME=owner
FOOTBALL_ADMIN_PASSWORD=
# Exact external origin, no trailing slash. HTTPS is required on the Internet.
FOOTBALL_PUBLIC_ORIGIN=http://localhost:13001
FOOTBALL_COOKIE_SECURE=false
# Exact IPs of trusted proxies directly connected to Node, comma-separated.
# See docs/security-deployment.md; do not trust arbitrary forwarding headers.
FOOTBALL_TRUSTED_PROXY_ADDRESSES=
# Optional Tencent JS API GL browser Key. Leave empty to disable external maps.
# This public browser identifier is NOT a server secret; never use a signing SK.
# Configure permissions/website restrictions/quotas in your own Tencent console.
# See docs/tencent-map-setup.md. Never commit your actual .env or Key.
FOOTBALL_TENCENT_MAP_KEY=
