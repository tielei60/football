<view class="page"
  ><view class="between"
    ><view
      ><view class="title">每一场，都在这里</view
      ><view class="subtitle">赛程 · 报名 · 赛果</view></view
    ><button disabled="{{loading}}" wx:if="{{admin}}" class="small primary no-wrap ui-button ui-compact" bindtap="create" size="mini">创建比赛</button></view
  ><view wx:if="{{!loading && !error && tab==='upcoming' && visible.length}}" class="fixture-focus" aria-role="button" data-id="{{visible[0].id}}" bindtap="openMatch"><image class="focus-image" src="/assets/club-atmosphere.jpg" mode="aspectFill"/><view class="focus-shade"/><view class="focus-content"><view class="focus-context"><text class="focus-label">焦点赛事</text><text>{{visible[0].competition || '球队比赛'}}{{visible[0].format ? ' · '+visible[0].format+'人制' : ''}}</text></view><view class="focus-teams"><view><image wx:if="{{team.crest}}" src="{{team.crest}}" mode="aspectFit" data-target="team" binderror="imageError"/><text wx:else class="focus-fallback">足</text><text>{{team.name}}</text></view><text class="focus-vs">VS</text><view><view class="focus-fallback" aria-hidden="true"><view class="opponent-ball"/></view><text>{{visible[0].opponent}}</text></view></view><view class="focus-meta">{{visible[0].dateLabel}} · {{visible[0].kickoff || '时间待定'}}</view><view class="focus-meta">{{visible[0].location || '地点待定'}}</view><view class="focus-link">查看比赛 · 去报名 ›</view></view></view><view class="tabs"
    ><view aria-role="button"
      class="tab {{tab==='upcoming'?'active':''}}"
      data-tab="upcoming"
      bindtap="changeTab"
      >待比赛</view
    ><view aria-role="button"
      class="tab {{tab==='past'?'active':''}}"
      data-tab="past"
      bindtap="changeTab"
      >已结束</view
    ><view aria-role="button"
      wx:if="{{admin}}"
      class="tab {{tab==='draft'?'active':''}}"
      data-tab="draft"
      bindtap="changeTab"
      >草稿</view
    ></view
  ><page-state id="page-state" skeleton-type="list"
    loading="{{loading}}"
    error="{{error}}"
    empty="{{!visible.length}}"
    bind:retry="refresh"
  /><block wx:if="{{!loading && !error}}"
    ><block wx:for="{{visible}}" wx:key="id"
      ><view wx:if="{{item.monthHeading}}" class="section-title"
        >{{item.monthHeading}}</view
      ><view aria-role="button" class="card" data-id="{{item.id}}" bindtap="openMatch"
        ><view class="between"
          ><text class="muted match-time"
            >{{item.dateLabel}} · {{item.kickoff || '时间待定'}}</text
          ><text class="tag {{item.status}}">{{item.statusLabel}}</text></view
        ><view class="between fixture-main" style="margin-top: 20rpx"
          ><view class="date-ticket"><text>{{item.dayLabel}}</text><text>{{item.weekdayLabel}}</text></view><view class="grow"
            ><view class="section-title break match-name" style="margin: 0"
              >{{item.opponent}}</view
            ><view class="muted"
              >{{item.competition || '球队比赛'}}{{item.format ? ' · '+item.format+'人制' : ''}}</view
            ></view
          ><view wx:if="{{item.status==='completed'}}" class="score"
            >{{item.scoreLabel}}</view
          ></view
        ><view class="divider"></view
        ><view class="muted break schedule-location">{{item.location || '地点待定'}}</view
        ><view wx:if="{{item.status==='published'}}" class="schedule-signup"
          ><view class="schedule-counts"><text class="signup-count-yes">参加 {{item.signupCountLabel}}</text><text class="signup-count-maybe">{{item.maybeCount}} 人待定</text><text class="signup-count-no">{{item.noCount}} 人请假</text></view
          ><text class="schedule-response">{{item.responseLabel}} ›</text></view
        ></view
      ></block
    ></block
  ></view
>

<business-dialog id="business-dialog"/>
