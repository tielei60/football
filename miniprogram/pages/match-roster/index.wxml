<view class="page">
  <page-state skeleton-type="form" loading="{{loading}}" error="{{error}}" bind:retry="refresh" />
  <block wx:if="{{!loading && !error}}">
    <view class="title">比赛名单与数据</view><view class="subtitle">对阵 {{opponent}}</view>
    <view class="hint roster-warning">保存会替换本场完整名单。报名、首发和实际出场互不等同；进球助攻留空表示未知，0 表示确认没有。</view>
    <view class="card section row" wx:if="{{candidates.length}}">
      <business-picker title="添加比赛球员" bind:pickeropen="openBusinessPicker" class="grow" range="{{candidates}}" range-key="label" value="{{candidateIndex}}" bindchange="choosePlayer" disabled="{{loading || (busy || conflict)}}"><view class="picker"><text class="picker-value">{{candidates[candidateIndex].label}}</text></view></business-picker>
      <button class="small primary ui-button ui-compact" bindtap="add" disabled="{{loading || (busy || conflict)}}" size="mini">加入名单</button>
    </view>
    <view wx:if="{{!rows.length}}" class="card empty">名单为空，可选择队员加入。保存空名单会清空已保存的名单。</view>
    <view class="card section" wx:for="{{rows}}" wx:key="playerId">
      <view class="between"><text class="bold">{{item.number}} · {{item.name}}</text><button class="small danger ui-button ui-compact" data-id="{{item.playerId}}" bindtap="remove" disabled="{{loading || (busy || conflict)}}" size="mini">移除</button></view>
      <view class="hint" wx:if="{{item.historical}}">{{item.migration?'迁移时留存身份':'已保存历史身份'}}，不会随当前个人资料改变。</view>
      <view class="roster-grid">
        <view><text class="field-label">名单身份</text><business-picker title="名单身份" bind:pickeropen="openBusinessPicker" range="{{selections}}" range-key="label" value="{{item.selectionIndex}}" data-id="{{item.playerId}}" data-field="selectionIndex" bindchange="pick" disabled="{{loading || (busy || conflict)}}"><view class="picker"><text class="picker-value">{{selections[item.selectionIndex].label}}</text></view></business-picker></view>
        <view><text class="field-label">位置</text><business-picker title="球员位置" bind:pickeropen="openBusinessPicker" range="{{item.positionLabels}}" value="{{item.positionIndex}}" data-id="{{item.playerId}}" data-field="positionIndex" bindchange="pick" disabled="{{loading || (busy || conflict)}}"><view class="picker"><text class="picker-value">{{item.positionLabels[item.positionIndex]}}</text></view></business-picker></view>
      </view>
      <view class="field"><text class="field-label">实际出场</text><business-picker title="实际出场" bind:pickeropen="openBusinessPicker" range="{{appearances}}" range-key="label" value="{{item.appearanceIndex}}" data-id="{{item.playerId}}" data-field="appearanceIndex" bindchange="pick" disabled="{{loading || (busy || conflict)}}"><view class="picker"><text class="picker-value">{{appearances[item.appearanceIndex].label}}</text></view></business-picker></view>
      <view class="roster-grid" wx:if="{{item.appearanceIndex===1}}">
        <view><text class="field-label">进球</text><input class="input" type="number" maxlength="6" placeholder="未知" value="{{item.goals}}" data-id="{{item.playerId}}" data-field="goals" bindinput="input" disabled="{{loading || (busy || conflict)}}" /></view>
        <view><text class="field-label">助攻</text><input class="input" type="number" maxlength="6" placeholder="未知" value="{{item.assists}}" data-id="{{item.playerId}}" data-field="assists" bindinput="input" disabled="{{loading || (busy || conflict)}}" /></view>
      </view>
    </view>
    <view wx:if="{{actionError}}" class="error">{{actionError}}</view>
    <button disabled="{{loading}}" wx:if="{{conflict}}" bindtap="reload" class="ui-button ui-block" size="mini">核对后重新载入</button>
    <button class="primary section ui-button ui-block" loading="{{busy}}" disabled="{{loading || (busy || conflict)}}" bindtap="save" size="mini">保存完整名单（{{rows.length}}人）</button>
  </block>
</view>

<business-dialog id="business-dialog"/>
