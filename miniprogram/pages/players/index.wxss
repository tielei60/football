.jersey {
  font-size: 40rpx;
  font-weight: 700;
  color: #bba5c6;
}

/* Page-specific density, hierarchy and long-content safeguards. */
.card.row{padding:22rpx 24rpx;gap:20rpx}.card .grow{min-width:0}.card .bold{font-size:29rpx;line-height:1.4;overflow-wrap:anywhere}.card .muted{font-size:24rpx;margin-top:4rpx;overflow-wrap:anywhere}.jersey{font-size:34rpx;font-weight:650;color:var(--brand-ink);font-variant-numeric:tabular-nums;flex-shrink:0}.avatar{flex-shrink:0;border:1rpx solid var(--line)}
