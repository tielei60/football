.preview{width:100%;height:600rpx;background:#fff;border-radius:20rpx}.export-canvas{position:fixed;left:-10000px;top:0;width:826px;height:1330px;pointer-events:none}.actions button{margin-top:18rpx}.hint{margin:16rpx 0}
.export-options{display:flex;flex-direction:column;align-items:stretch;gap:18rpx;min-width:0}
.export-buttons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;width:100%;min-width:0}
.export-buttons button{box-sizing:border-box;width:100%;min-width:0;margin:0;padding:22rpx 12rpx}

/* Page-specific density, hierarchy and long-content safeguards. */
.title{font-size:32rpx;line-height:1.4;overflow-wrap:anywhere}.export-options{gap:16rpx}.export-buttons{gap:12rpx}.export-buttons button{font-size:25rpx;line-height:1.45;padding:18rpx 10rpx}.preview{border:1rpx solid var(--line);border-radius:18rpx;background:var(--canvas)}.hint{font-size:24rpx;line-height:1.65}.export-options .row{gap:12rpx}

/* 战术文字层级：普通信息局部增强，专注工具及画布几何保持。 */
.title{font-weight:650;color:var(--ink)}
.hint{font-size:25rpx;color:var(--muted)}
.export-source{font-weight:400}
.export-ready{font-size:26rpx;font-weight:500;color:var(--ink)}
@media(max-width:360px){.hint{font-size:12px}.export-ready{font-size:26rpx}}
@media(max-width:346px){.export-ready{font-size:12px}}

/* 深度视觉层级：保留既有专注与操作几何。 */
.title{font-size:var(--type-page,38rpx);font-weight:600;line-height:1.35}
.export-source,.hint{font-size:var(--type-meta,24rpx);font-weight:400;line-height:1.65}
.export-ready{font-size:var(--type-field,26rpx);font-weight:500;color:var(--success,#176b4a);line-height:1.65}
@media(max-width:375px){.hint{font-size:12px}.export-ready{font-size:var(--type-field,26rpx)}}
@media(max-width:346px){.export-ready{font-size:12px}}

.export-options { padding: 28rpx; margin-top: 24rpx; border-top: 4rpx solid var(--brand); }
.export-buttons button { min-height: 44px; border-radius: 22rpx; }
.export-source { margin-top: 10rpx; }
.page > block > .title { font-size: 32rpx; }
.export-ready { padding: 18rpx; background: var(--success-soft); border-radius: 16rpx; }
