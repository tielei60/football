.position-options{display:flex;flex-wrap:wrap;gap:14rpx}.position-options .selected{background:var(--brand);color:#fff}.admin-header{margin-bottom:28rpx}.picture-preview{width:140rpx;height:140rpx;border-radius:28rpx;background:var(--brand-soft)}
/* Page-specific density, hierarchy and long-content safeguards. */
.picture-preview{width:120rpx;height:120rpx;border-radius:24rpx;flex-shrink:0}.card>.row{gap:20rpx;align-items:center}.card>.row button{flex:1;min-width:0;font-size:25rpx}.field-label{font-size:24rpx}.admin-header{margin-bottom:22rpx}.hint{line-height:1.65}

/* 管理文字层级：仅文字与组间留白，不改原生输入及业务布局。 */
.admin-header{font-size:34rpx;font-weight:650;color:var(--ink)}
.field-label{font-size:26rpx;font-weight:500;margin-bottom:12rpx;color:var(--ink)}
.hint{font-size:24rpx;font-weight:400;line-height:1.65;color:var(--muted)}
.actions button.ui-button[size="mini"]{font-weight:500}
@media(max-width:346px){.field-label{font-size:12px}}
@media(max-width:375px){.hint{font-size:12px}}
