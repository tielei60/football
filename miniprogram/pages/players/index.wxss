.players-page{padding-top:30rpx}
.players-heading{padding:2rpx 2rpx 24rpx}
.players-title{font-size: var(--type-page);font-weight:700;line-height:1.3;color:var(--ink)}
.players-subtitle{margin-top:8rpx;font-size:25rpx;line-height:1.5;color:var(--muted)}
.players-tabs{display:flex;align-items:stretch;gap:8rpx;padding:5rpx;border-radius:19rpx;background:#ede8f0}
.players-tab{flex:1;min-width:0;min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:10rpx 6rpx;border-radius:15rpx;color:var(--muted);font-size:25rpx;line-height:1.35;text-align:center}
.players-tab.is-active{background:#fff;color:var(--brand-ink);font-weight:650;box-shadow:0 2rpx 9rpx rgba(55,35,62,.08)}
.player-filters{display:flex;align-items:stretch;gap:12rpx;margin-top:22rpx}
.player-search{display:flex;align-items:center;flex:1;min-width:0;min-height:88rpx;padding-left:20rpx;border:1rpx solid var(--control-border);border-radius:16rpx;background:#fff}
.search-icon{position:relative;width:25rpx;height:25rpx;flex:none;border:2rpx solid #81748b;border-radius:50%;margin-right:16rpx}
.search-icon::after{content:"";position:absolute;right:-7rpx;bottom:-5rpx;width:10rpx;height:2rpx;border-radius:2rpx;background:#81748b;transform:rotate(45deg)}
.search-input{flex:1;min-width:0;height:86rpx;padding:0;border:0;background:transparent;font-size:26rpx;color:var(--ink)}
.search-placeholder{color:#827789}
.page button.search-clear[size="mini"]{display:flex;align-items:center;justify-content:center;flex:none;width:88rpx;min-width:88rpx;min-height:88rpx;margin:0;padding:0;border:0;background:transparent;box-shadow:none;color:var(--muted);font-size:38rpx;font-weight:400;line-height:1}
.page button.search-clear::after{border:0}
.position-filter{flex:0 0 220rpx;width:220rpx;min-width:0}
.players-page .position-picker{min-height:88rpx;border-radius:16rpx;font-size:25rpx;color:var(--brand-ink)}
.list-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;padding:32rpx 2rpx 16rpx}
.list-heading-title{font-size: var(--type-section);font-weight:650;line-height:1.4;color:var(--ink)}
.list-count{font-size:24rpx;color:var(--muted);font-variant-numeric:tabular-nums}
.player-list{overflow:hidden;border:1rpx solid #eae2ee;border-radius:22rpx;background:#fff}
.player-row{display:flex;align-items:center;gap:18rpx;min-height:124rpx;margin:0 24rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line)}
.player-row:last-child{border-bottom:0}.player-row-pressed{opacity:.7}
.player-list-avatar{width:82rpx;height:82rpx;border-radius:50%;border:1rpx solid var(--line)}
.player-info{flex:1;min-width:0}.player-name-line{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx 12rpx;min-width:0}
.player-name{font-size: var(--type-card);font-weight:600;line-height:1.4;overflow-wrap:anywhere;color:var(--ink)}
.player-origin{flex:none;padding:3rpx 8rpx;border-radius:7rpx;background:#f2eaf6;color:var(--brand-ink);font-size: 24rpx;line-height:1.4}
.player-position{margin-top:5rpx;font-size: var(--type-meta);line-height:1.5;color:var(--muted);overflow-wrap:anywhere}
.player-number{flex:none;max-width:100rpx;color:var(--brand-ink);font-size:30rpx;font-weight:650;line-height:1.4;white-space:nowrap;font-variant-numeric:tabular-nums}
.number-unit{margin-left:3rpx;font-size:22rpx;font-weight:400}
.player-chevron{flex:none;color:#9c90a3;font-size:32rpx;line-height:1}
.players-empty{padding:70rpx 24rpx;text-align:center}
.empty-title{font-size: var(--type-card);font-weight:600;line-height:1.5;color:var(--ink)}
.empty-caption{margin-top:8rpx;font-size: var(--type-field);line-height:1.6;color:var(--muted)}
@media(max-width:360px){.players-subtitle,.players-tab,.search-input,.position-picker,.list-count,.player-position,.number-unit,.empty-caption{font-size:12px}.position-filter{flex-basis:190rpx;width:190rpx}}

/* V3：俱乐部品牌与内容分层，数据及操作由原页面维护。 */
.players-page{padding-top:28rpx}.players-heading{position:relative;overflow:hidden;min-height:280rpx;margin:-28rpx -28rpx 0;padding:34rpx 30rpx 70rpx;background:#580e6d}.jersey-art{position:absolute;right:0;top:0;width:45%;height:100%}.players-heading-shade{position:absolute;inset:0;background:linear-gradient(90deg,#500960 25%,#641177bb 65%,#64117733)}.players-heading-copy{position:relative;max-width:85%}.club-eyebrow{color:#bde6ff;font-size:22rpx;letter-spacing:5rpx;margin-bottom:14rpx}.players-title{font-size:44rpx;color:#fff;overflow-wrap:anywhere}.players-subtitle{color:#eddcf5;font-size:24rpx}.squad-counts{position:relative;margin:-42rpx 0 28rpx;display:flex;gap:16rpx}.squad-counts>view{flex:1;min-width:0;padding:24rpx 8rpx;text-align:center;border:1rpx solid #dfc8ed;border-radius:26rpx;background:linear-gradient(135deg,#fff,#f4edff);box-shadow:0 6rpx 16rpx #6a006815}.squad-counts text{display:block;font-size:24rpx;color:var(--muted)}.squad-counts text:first-child{font-size:48rpx;font-weight:700;color:var(--brand);line-height:1.3;margin-bottom:8rpx}.players-tabs{background:#ede4fa;border:1rpx solid #e2d4f2}.players-tab.is-active{background:linear-gradient(110deg,#a326c8,#61026f);color:#fff}.player-list{border-radius:30rpx;box-shadow:0 6rpx 16rpx #6a00680c}.player-row{min-height:150rpx}.player-list-avatar{width:92rpx;height:92rpx;border:4rpx solid #fff;box-shadow:0 0 0 2rpx #e4d2ee}.player-number{font-size:46rpx;max-width:none}.player-position{display:inline-block;background:#f2e7fb;color:var(--brand-ink);padding:3rpx 10rpx;border-radius:8rpx}.list-heading-title{border-left:6rpx solid var(--brand);padding-left:14rpx}
