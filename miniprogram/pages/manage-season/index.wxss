/* UI v3：管理页共享视觉由 app.wxss 令牌与品牌横幅提供。 */
.admin-header { gap:16rpx; flex-wrap:wrap; margin:24rpx 0; }
.field-label { font-size:26rpx; font-weight:500; color:var(--muted); margin-bottom:12rpx; }
.hint,.subtitle { font-size:24rpx; line-height:1.65; color:var(--muted); }
.section-title { font-size:32rpx; font-weight:650; line-height:1.4; }
.card { padding:34rpx; }
.error { overflow-wrap:anywhere; }
 .card .field { margin-bottom:32rpx; }
.card .hint { padding:0; border-radius:0; background:transparent; color:var(--muted); line-height:1.65; }

/* V3：阵容管理是带方向提示的白色入口卡，不与保存主操作竞争。 */
.page button.season-roster-entry.ui-button.ui-block[size="mini"]{display:flex;align-items:center;gap:20rpx;padding:24rpx;background:var(--surface);border:1rpx solid var(--line);text-align:left;color:var(--ink);min-height:56px}
.season-roster-entry image{width:44rpx;height:44rpx;flex-shrink:0}
.season-roster-entry text{min-width:0;overflow-wrap:anywhere}
.season-roster-entry .entry-chevron{margin-left:auto;color:var(--brand);font-size:40rpx}
.page button.season-roster-entry.ui-button.ui-block[size="mini"][disabled]{opacity:.5;box-shadow:none}

/* V3 原图：日期是表单字段值，使用正文色，不作为品牌强调项。 */
.card .picker-value { color:var(--ink); }

.season-media .section-title{margin-bottom:20rpx}
.season-media-row{display:flex;align-items:center;gap:20rpx;padding:16rpx 0;border-top:1rpx solid var(--line)}
.season-media-copy{flex:1;min-width:0;display:flex;align-items:center;gap:10rpx;flex-wrap:wrap}
.season-media-copy .field-label{flex-basis:100%}
.season-media-copy button{margin:0}
.season-icon-preview,.season-image-preview{width:88rpx;height:88rpx;flex:none;border-radius:16rpx;background:var(--canvas)}
.season-image-preview{width:126rpx}
