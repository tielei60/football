:host{display:block;min-width:0}.state{box-sizing:border-box;padding:44rpx 28rpx;text-align:center;color:var(--muted,#6e617a);font-size:var(--type-field,26rpx);line-height:1.65;border-radius:24rpx;background:var(--surface,#fff);border:1rpx solid var(--line,#e8def5)}.state-title{display:block;color:var(--ink,#24182f);font-size:var(--type-card,30rpx);font-weight:600}.state-message{display:block;margin-top:16rpx;word-break:break-word;white-space:pre-wrap}.state-symbol{width:56rpx;height:56rpx;line-height:56rpx;margin:0 auto 18rpx;border-radius:18rpx;background:var(--danger-soft,#fff0f3);color:var(--danger,#b33951);font-weight:700;font-size:32rpx}.state button.retry{display:inline-flex;justify-content:center;align-items:center;box-sizing:border-box;width:auto;max-width:100%;min-width:176rpx;min-height:80rpx;margin:24rpx 0 0;padding:16rpx 28rpx;color:var(--brand-ink,#61046f);background:var(--brand-soft,#f0e6fa);border-radius:16rpx;font-size:26rpx;line-height:1.4;font-weight:600}.state button::after{border:0}.state button:focus-visible{outline:3rpx solid var(--focus,#760b88);outline-offset:3rpx}.empty-mark{width:60rpx;padding:14rpx 12rpx;margin:0 auto 20rpx;background:var(--brand-soft,#f0e6fa);border-radius:14rpx;box-sizing:border-box}.empty-mark view{height:4rpx;margin:6rpx 0;border-radius:4rpx;background:#bca7c7}.empty-mark view:last-child{width:70%}

.state button.retry{border:1rpx solid #dfcdee;background:#f4edfc;box-shadow:0 4rpx 12rpx rgba(63,33,78,.05)}
.state button.retry.button-hover{opacity:.72}

/* 重试属于主要动作；宽屏保留原有 80rpx 高度。 */
@media(max-width:412.5px){.state button.retry{min-height:44px}}

/* v3 组件表面与页面主题一致，交互仍由原组件管理。 */
.state{border-radius:30rpx;border-color:#e5d7f3;box-shadow:0 6rpx 18rpx rgba(110,43,131,.04)}.state button.retry{min-height:44px;border-radius:22rpx}
