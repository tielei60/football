/* 一张比赛信息面板，后续内容以留白和细分隔线组织。 */
.match-detail-page{min-height:100vh;background:var(--surface);padding-top:20rpx}
.match-cover{display:block;width:100%;height:280rpx;object-fit:cover;border-radius:20rpx;margin-bottom:18rpx;background:var(--brand-soft)}
.match-sheet{padding:8rpx 28rpx 0;border-radius:24rpx;background:#f8f5fa}
.match-topline{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:88rpx}
.match-context{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx 14rpx;min-width:0}
.match-status{color:var(--brand-ink);font-size:24rpx;font-weight:600;white-space:nowrap}
.match-status.cancelled{color:var(--danger)}
.match-competition{color:var(--muted);font-size:24rpx;line-height:1.5;overflow-wrap:anywhere}
.match-hero-meta{flex:none}
.page button.match-share-button[size="mini"]{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;min-height:88rpx;padding:0;margin:0 -20rpx 0 0;border:0;background:transparent;color:var(--brand-ink);box-shadow:none;font-size:34rpx;line-height:1}
.page button.match-share-button::after{border:0}
.page button.match-share-button.share-wait{opacity:.6;font-size:26rpx}
.share-symbol{position:relative;width:30rpx;height:32rpx}
.share-dot{position:absolute;width:8rpx;height:8rpx;border:3rpx solid var(--brand-ink);border-radius:50%;background:#f8f5fa;z-index:1}
.share-dot-left{left:0;top:9rpx}.share-dot-top{right:0;top:0}.share-dot-bottom{right:0;bottom:0}
.share-line{position:absolute;left:9rpx;width:16rpx;height:3rpx;border-radius:3rpx;background:var(--brand-ink);transform-origin:left center}
.share-line-top{top:13rpx;transform:rotate(-29deg)}.share-line-bottom{top:17rpx;transform:rotate(29deg)}
.teams{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:16rpx;align-items:start;padding:16rpx 0 30rpx;text-align:center}
.match-team{display:flex;min-width:0;flex-direction:column;align-items:center;gap:12rpx}
.team-crest{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;flex:none}
.team-crest image{display:block;width:100%;height:100%}
.team-name{max-width:100%;font-size:var(--type-card);font-weight:600;line-height:1.4;overflow-wrap:anywhere;word-break:break-word}
.match-result{display:flex;min-width:100rpx;flex-direction:column;align-items:center;gap:6rpx;padding-top:13rpx}
.score{font-size:40rpx;font-weight:700;line-height:1.2;color:var(--brand-ink);white-space:nowrap;font-variant-numeric:tabular-nums}
.match-side{color:var(--muted);font-size:var(--type-meta);line-height:1.4;white-space:nowrap}
.default-crest{width:84rpx;height:84rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #e5d9eb;border-radius:50%;background:#fff}
.default-ball{position:relative;width:46rpx;height:46rpx;border:3rpx solid #846591;border-radius:50%;overflow:hidden}
.ball-center{position:absolute;left:15rpx;top:15rpx;width:11rpx;height:11rpx;border-radius:3rpx;background:#846591}
.ball-seam{position:absolute;left:19rpx;top:20rpx;width:3rpx;height:20rpx;background:#846591;transform-origin:top center}
.ball-seam-one{transform:rotate(0deg)}.ball-seam-two{transform:rotate(72deg)}.ball-seam-three{transform:rotate(144deg)}.ball-seam-four{transform:rotate(216deg)}.ball-seam-five{transform:rotate(288deg)}
.match-facts{border-top:1rpx solid #e9e1ed;padding:8rpx 0}
.fact-row,.fact-notice{display:flex;align-items:flex-start;gap:20rpx;padding:14rpx 0}
.fact-label{flex:0 0 56rpx;color:var(--muted);font-size:var(--type-field);line-height:1.55}
.fact-content{flex:1;min-width:0;display:flex;flex-direction:column;gap:3rpx}
.fact-primary{font-size:var(--type-body);font-weight:500;line-height:1.5;color:var(--ink);overflow-wrap:anywhere}
.fact-subtitle{font-size:24rpx;line-height:1.5;color:var(--muted);overflow-wrap:anywhere}
.fact-notice .prewrap{flex:1;min-width:0;font-size:var(--type-body);line-height:1.65}
.page button.fact-navigation[size="mini"]{flex:none;width:auto;min-height:88rpx;margin:-22rpx -12rpx;padding:0 12rpx;border:0;background:transparent;color:var(--brand-ink);box-shadow:none;font-size:25rpx;line-height:88rpx;white-space:nowrap}
.page button.fact-navigation::after{border:0}
.match-utilities{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0 12rpx;border-top:1rpx solid #e9e1ed}
.match-management{display:flex;align-items:center;gap:20rpx}
.page button.match-management-button[size="mini"],.page button.match-media-button[size="mini"]{width:auto;min-height:88rpx;padding:0;margin:0;border:0;background:transparent;color:var(--brand-ink);box-shadow:none;font-size:25rpx;font-weight:500;line-height:1.4}
.page button.match-management-button::after,.page button.match-media-button::after{border:0}
.page button.match-control-pressed[size="mini"]{opacity:.65}
.content-section{padding:34rpx 0 30rpx;border-bottom:1rpx solid var(--line)}
.section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12rpx}
.section-heading-title{font-size:var(--type-section);font-weight:650;line-height:1.4;color:var(--ink)}
.section-heading-note{font-size:24rpx;color:var(--muted);text-align:right;line-height:1.5}
.attendance-summary{display:flex;flex-wrap:wrap;gap:8rpx 30rpx;margin-top:18rpx;font-size:26rpx;font-weight:600;line-height:1.6}
.attendance-summary text{white-space:nowrap}
.reply-group{margin-top:28rpx}.reply-group+.reply-group{padding-top:22rpx;border-top:1rpx solid var(--line)}
.reply-group-heading{font-size:var(--type-field);font-weight:600;color:var(--ink)}
.reply-group-count{margin-left:6rpx;color:var(--muted);font-weight:400}
.reply-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24rpx 12rpx;margin-top:18rpx}
.reply-player{min-width:0;display:flex;flex-direction:column;align-items:center;gap:10rpx}
.reply-avatar{width:80rpx;height:80rpx;border-radius:50%;overflow:hidden;display:flex;align-items:center;justify-content:center;background:var(--brand-soft);color:var(--brand-ink);font-size:30rpx;font-weight:600}
.reply-avatar-image{width:100%;height:100%}
.reply-name{max-width:100%;font-size:25rpx;color:var(--ink);line-height:1.4;text-align:center;overflow-wrap:anywhere;word-break:break-word}
.section-empty{padding:26rpx 0 2rpx;font-size:var(--type-field);line-height:1.6;color:var(--muted)}
.roster-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:22rpx 0;border-bottom:1rpx solid var(--line)}
.roster-row:last-of-type{border-bottom:0}
.roster-main{flex:1;min-width:0}.roster-name{font-size:var(--type-body);font-weight:600;line-height:1.45;overflow-wrap:anywhere}
.roster-meta,.roster-stats{font-size:24rpx;line-height:1.5;color:var(--muted);overflow-wrap:anywhere}
.roster-meta{margin-top:6rpx}.roster-aside{flex:none;max-width:48%;display:flex;flex-direction:column;align-items:flex-end;gap:6rpx;text-align:right}
.roster-selection{font-size:24rpx;color:var(--brand-ink)}
.section-footnote{padding-top:18rpx;font-size:24rpx;line-height:1.6;color:var(--muted)}
.section-copy{padding-top:16rpx;font-size:var(--type-body);line-height:1.75}
.tactic-row{display:flex;justify-content:space-between;gap:16rpx;padding:22rpx 0;font-size:27rpx;line-height:1.5;border-bottom:1rpx solid var(--line)}
.tactic-row:last-child{border-bottom:0}.tactic-source{color:var(--muted);font-size:24rpx;white-space:nowrap}
.reply-pending{margin-bottom:18rpx}.reply-pending button.ui-block[size="mini"]{min-height:88rpx}
.page .bottom-space{height:210rpx}
.page .fixed-actions{background:#fff;padding-top:16rpx;box-shadow:0 -8rpx 30rpx rgba(41,36,49,.04)}
.reply-bar-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:12rpx;line-height:1.4}
.reply-bar-title{font-size:25rpx;font-weight:600;color:var(--ink)}
.reply-bar-status{font-size:24rpx;color:var(--muted)}
.page .fixed-actions .reply-options{gap:4rpx;padding:6rpx;border-radius:22rpx;background:#f3eff5}
.page .fixed-actions .actions>button.reply-button[size="mini"]{display:flex;align-items:center;justify-content:center;gap:8rpx;min-height:88rpx;padding:0 8rpx;border:0;border-radius:17rpx;background:transparent;color:#62566a;box-shadow:none;font-size:27rpx;font-weight:500;line-height:1.3}
.page .fixed-actions .actions>button.reply-button.primary[size="mini"]{background:#fff;color:var(--brand-ink);font-weight:650;box-shadow:0 2rpx 10rpx rgba(69,41,78,.12)}
.reply-check{display:flex;align-items:center;justify-content:center;width:27rpx;height:27rpx;flex:none;border-radius:50%;background:var(--brand-ink);color:#fff;font-size:19rpx;font-weight:700;line-height:1}
.page .fixed-actions .actions>button.reply-button[disabled]{opacity:.6}
.share-canvas{position:fixed;left:-2000px;top:0;width:500px;height:400px;pointer-events:none}
@media(max-width:360px){.match-status,.match-competition,.match-side,.fact-label,.fact-subtitle,.section-heading-note,.reply-group-heading,.reply-name,.roster-meta,.roster-stats,.roster-selection,.section-footnote,.reply-bar-title,.reply-bar-status{font-size:12px}}

/* V3：俱乐部品牌与内容分层，数据及操作由原页面维护。 */
.match-detail-page{background:var(--canvas);padding-top:0}.match-sheet{margin:0 -28rpx;padding:0;background:transparent;border-radius:0}.match-brand-hero{position:relative;overflow:hidden;padding:12rpx 32rpx 40rpx;background:#570a6b;color:#fff}.match-atmosphere,.match-brand-shade{position:absolute;inset:0;width:100%;height:100%}.match-brand-shade{background:linear-gradient(120deg,#4c075ff0,#731c83c9)}.match-brand-hero .match-topline,.match-brand-hero .teams{position:relative}.match-brand-hero .match-status{background:#f0dff8;color:#70237f;padding:6rpx 12rpx;border-radius:8rpx}.match-brand-hero .match-status.cancelled{background:#fae5eb;color:#962c45}.match-brand-hero .match-competition,.match-brand-hero .match-side{color:#f1dfff}.match-brand-hero .team-name{color:#fff}.match-brand-hero .score{color:#fff;font-size:66rpx}.match-brand-hero .team-crest{width:124rpx;height:124rpx}.match-brand-hero .default-crest{width:104rpx;height:114rpx;border-radius:12rpx 12rpx 32rpx 32rpx;background:#e2f4ff}.match-brand-hero .teams{padding:22rpx 0 18rpx}.match-brand-hero .match-result{padding-top:26rpx}.page .match-brand-hero button.match-share-button[size="mini"]{color:#fff}.match-brand-hero .share-dot{border-color:#fff;background:#6a1a7c}.match-brand-hero .share-line{background:#fff}.match-facts{position:relative;margin:-20rpx 28rpx 0;padding:14rpx 28rpx 18rpx;background:#fff;border:1rpx solid #e2d1f2;border-radius:30rpx;box-shadow:0 8rpx 20rpx #6a006812}.match-utilities{margin:0 28rpx;padding:8rpx 16rpx;border:0}.content-section{background:#fff;border:1rpx solid #e4d5f1;border-radius:28rpx;padding:28rpx;margin-top:24rpx;box-shadow:0 5rpx 15rpx #6a006808}.section-heading-title{border-left:6rpx solid var(--brand);padding-left:12rpx}.reply-group{background:#fcf9ff;border-radius:22rpx;padding:22rpx}.reply-group+.reply-group{border:0}.page .fixed-actions .reply-options{gap:12rpx;background:transparent;padding:0}.page .fixed-actions .actions>button.reply-button[size="mini"]{background:#f1e5fa;border:1rpx solid #e3cff0;border-radius:22rpx}.page .fixed-actions .actions>button.reply-button.primary[size="mini"]{background:linear-gradient(110deg,#a326c8,#61026f);color:#fff}.reply-button.primary .reply-check{background:#fff;color:var(--brand)}@media(max-width:350px){.match-brand-hero .score{font-size:54rpx}.match-brand-hero .team-crest{width:104rpx;height:104rpx}.section-heading{flex-wrap:wrap}}

/* 320px 下 56rpx 略小于两个 12px 汉字，标签保持横排。 */
.fact-label{min-width:2em;white-space:nowrap}

/* V3 实际命中区：仅扩大控件盒子，不改变业务坐标。 */
.page button.match-management-button[size="mini"],.page button.match-media-button[size="mini"],.page button.fact-navigation[size="mini"],.page .fixed-actions .actions>button.reply-button[size="mini"]{min-height:44px}
.page button.match-share-button[size="mini"]{min-width:44px;min-height:44px}

/* ZIP 07：须知相册入口归入白色地点须知卡；管理员操作仍独立保留。 */
.page .match-facts button.match-media-button[size="mini"] { display:flex; align-items:center; justify-content:flex-start; min-height:44px; margin:12rpx 0 0; padding:12rpx 0; color:var(--brand); background:transparent; border:0; box-shadow:none; }

/* ZIP 07：时间归入主视觉，报名标题及摘要位于分组卡片外。 */
.match-hero-time{position:relative;text-align:center;font-size:26rpx;line-height:1.6;color:#efddf8;margin-top:14rpx;overflow-wrap:anywhere}
.match-detail-page .attendance-section{background:transparent;border:0;border-radius:0;padding:20rpx 0 0;box-shadow:none}
.attendance-section .reply-group{background:var(--surface);border-radius:24rpx;padding:24rpx;margin-top:24rpx}
.attendance-section .reply-group+.reply-group{border:0}
.attendance-section .reply-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:24rpx 12rpx}
@media(max-width:350px){.attendance-section .reply-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}

/* V3：须知与场地分区；仅参加分组使用成功色。 */
.match-facts .fact-row+.fact-notice{border-top:1rpx solid var(--line);margin-top:18rpx;padding-top:28rpx}
.reply-group-heading.reply-group-heading-yes,.reply-group-heading-yes .reply-group-count{color:var(--success)}

/* 报名未知结果沿用原核对路径，警告区别于失败和成功状态。 */
.page .reply-pending.card{margin:24rpx 0;padding:24rpx;background:var(--warning-soft);border:1rpx solid #efd79c;border-radius:24rpx;color:var(--warning)}
.reply-pending-title{font-size:var(--type-field);font-weight:600;line-height:1.5;margin-bottom:12rpx}
.page .reply-pending .hint{color:var(--warning);margin:0 0 16rpx}
.page .reply-pending button.reply-reconcile-button.ui-button[size="mini"]{background:var(--surface);border:1rpx solid var(--control-border);color:var(--brand);box-shadow:none;min-height:44px}
.page .fixed-actions .actions>button.reply-button[size="mini"][disabled],.page .fixed-actions .actions>button.reply-button.primary[size="mini"][disabled]{background:#e9e3ef;color:#95899f;border-color:#e1d8eb;box-shadow:none;opacity:1}
.page .fixed-actions .actions>button.reply-button.primary[size="mini"][disabled] .reply-check{background:transparent;color:#95899f}

/* 管理操作回到资料卡内；取消态明确说明报名不可更改。 */
.match-facts .match-management{display:flex;gap:20rpx;margin-top:20rpx;margin-bottom:12rpx}
.page .match-facts button.match-management-button[size="mini"]{flex:1;min-width:0;min-height:44px;padding:16rpx 12rpx;border:2rpx solid var(--control-border);border-radius:24rpx;background:var(--surface);color:var(--brand);font-size:var(--type-field);font-weight:600}
.match-cancelled-notice{margin-top:24rpx;padding:24rpx;border:1rpx solid #efd79c;border-radius:24rpx;background:var(--warning-soft);color:var(--warning);font-size:var(--type-body);line-height:1.6}
.page .match-facts button.match-management-button[size="mini"][disabled]{opacity:.5}

/* 名单仅呈现比赛留存身份的首字和号码，不读取当前球员头像。 */
.roster-row{display:grid;grid-template-columns:44px minmax(0,1fr) minmax(0,94px);column-gap:12rpx}
.roster-snapshot-avatar{position:relative;display:flex;align-items:center;justify-content:center;width:44px;height:44px;box-sizing:border-box;border:2px solid var(--surface,#fff);border-radius:50%;box-shadow:0 0 0 1px var(--line);background:var(--brand-soft);color:var(--brand-ink);font-size:28rpx;font-weight:600}
.roster-snapshot-avatar .roster-snapshot-number{position:absolute;right:-3px;bottom:-2px;max-width:44px;box-sizing:border-box;padding:1px 4px;border-radius:6px;background:var(--brand);color:#fff;font-size:11px;line-height:1.4;overflow-wrap:anywhere}
.roster-row .roster-aside{max-width:100%;min-width:0}
@media(max-width:350px){.roster-row{grid-template-columns:38px minmax(0,1fr) minmax(0,82px);column-gap:8px}.roster-snapshot-avatar{width:38px;height:38px}.roster-snapshot-avatar .roster-snapshot-number{max-width:38px}}

.roster-stats .roster-stat{display:block;white-space:nowrap}

/* 报名成功沿用业务弹层视觉，分享必须由原生分享按钮的用户点击触发。 */
.signup-share-layer{position:fixed;inset:0;z-index:1200;display:flex;align-items:center;justify-content:center;padding:40rpx;box-sizing:border-box}
.signup-share-shade{position:absolute;inset:0;background:rgba(25,16,34,.42)}
.signup-share-dialog{position:relative;width:100%;max-width:600rpx;box-sizing:border-box;padding:36rpx;border:1px solid var(--line);border-radius:28rpx;background:var(--surface);box-shadow:0 24rpx 72rpx rgba(32,14,44,.2)}
.signup-share-title{font-size:34rpx;font-weight:650;color:var(--ink)}
.signup-share-copy{margin:22rpx 0 30rpx;font-size:28rpx;line-height:1.6;color:var(--muted)}
.signup-share-actions{display:flex;gap:16rpx}
.signup-share-actions button.ui-button[size="mini"]{flex:1;min-width:0;width:0;min-height:44px;margin:0;padding:20rpx 8rpx;font-size:28rpx;white-space:normal}
.signup-share-later{background:var(--canvas);color:var(--muted)}
