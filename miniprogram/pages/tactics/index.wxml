<view class="page"><view class="tactical-header"><view class="tactical-eyebrow">战术工作台</view><view class="title">{{historical?'本场战术留档':'球队战术'}}</view><view class="tactical-subtitle">{{historical?'保留本场站位与战术安排':'每一次配合，从这里开始'}}</view></view><page-state id="page-state" skeleton-type="list" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error}}"><view class="tactical-actions"><button wx:if="{{canManage}}" disabled="{{loading}}" id="new-tactic" bindtap="create" class="primary ui-button ui-block section" size="mini">新建战术</button><button disabled="{{loading}}" wx:if="{{canManage}}" class="small section ui-button ui-compact" id="tactic-transfer" bindtap="transfer" size="mini">导入 / 导出战术</button></view><input disabled="{{loading}}" class="input section" placeholder="搜索战术或阵型" value="{{search}}" bindinput="search"/><view aria-role="button" class="card section tactic-card" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="pitch-symbol" aria-hidden="true"><view class="pitch-lines"><view class="pitch-midline"/><view class="pitch-circle"/></view></view><view class="tactic-info"><view class="between"><text class="bold">{{item.title}}</text><text class="link">查看 ›</text></view><view class="muted">{{item.format}} 人制 · {{item.formation}}</view><text class="tag">{{item.source}} · {{canManage?'可编辑':'只读'}}</text></view></view><view wx:if="{{!visible.length}}" class="empty">暂无匹配的战术</view><view class="hint tactic-help">竖向球场查看站位与演示，管理员可编辑战术。</view></block></view>

<business-dialog id="business-dialog"/>
