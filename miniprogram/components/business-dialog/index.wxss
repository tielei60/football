.dialog-layer,.transient-layer{position:fixed;inset:0;z-index:10000;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;box-sizing:border-box}.shade,.loading-shade{position:absolute;inset:0;background:rgba(36,24,48,.36)}.dialog-layer{display:flex;align-items:center;justify-content:center;padding:36rpx 28rpx calc(36rpx + env(safe-area-inset-bottom))}.dialog{position:relative;width:100%;max-width:620rpx;background:#fff;border:1rpx solid #eee6f2;border-radius:32rpx;padding:34rpx;box-shadow:0 24rpx 90rpx rgba(56,28,72,.2)}.eyebrow{font-size:24rpx;letter-spacing:1rpx;color:var(--brand-ink,#61046f);margin-bottom:12rpx}.heading{font-size:34rpx;line-height:1.4;font-weight:650;color:#24182f;word-break:break-word}.body-scroll{max-height:48vh;margin-top:22rpx}.body{font-size:28rpx;line-height:1.65;color:var(--ink,#24182f);white-space:pre-wrap;word-break:break-word}.dialog-input{box-sizing:border-box;margin-top:22rpx;width:100%;height:92rpx;padding:0 22rpx;border:2rpx solid var(--control-border,#8d6a9e);background:#faf7fc;border-radius:16rpx;font-size:30rpx;color:#24182f}.buttons{display:grid;gap:16rpx;margin-top:32rpx}.buttons.two{grid-template-columns:repeat(2,minmax(0,1fr))}.buttons.one{grid-template-columns:minmax(0,1fr)}.dialog-control{box-sizing:border-box;margin:0;width:100%;min-width:0;min-height:88rpx;border:0;border-radius:18rpx;padding:22rpx 12rpx;font-size:28rpx;line-height:1.5;font-weight:600}.dialog-control::after{border:0}.cancel{background:#f2edf5;color:#75647e}.confirm{background:#760b88;color:#fff}.confirm.danger{background:#b33951}.transient-layer{z-index:9999;pointer-events:none}.transient-layer.masked{pointer-events:auto}.loading-shade{background:rgba(36,24,48,.18)}.notice{position:absolute;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:18rpx;box-sizing:border-box;width:max-content;max-width:620rpx;padding:24rpx 30rpx;border:1rpx solid #e5dceb;border-radius:22rpx;background:#fff;box-shadow:0 12rpx 48rpx rgba(56,28,72,.16)}.toast{top:calc(28rpx + env(safe-area-inset-top))}.loading{top:42%;min-width:280rpx}.notice-text{font-size:27rpx;line-height:1.5;color:#42334d;word-break:break-word}.notice-icon{font-size:35rpx;font-weight:700;flex-shrink:0}.success{color:var(--success,#157b4c)}.danger-text{color:#b33951}.spinner{width:34rpx;height:34rpx;flex-shrink:0;border:4rpx solid #e7d8ee;border-top-color:var(--brand-ink,#61046f);border-radius:50%;animation:business-spin .8s linear infinite}@keyframes business-spin{to{transform:rotate(360deg)}}.dialog{box-sizing:border-box;max-height:calc(100vh - 72rpx - env(safe-area-inset-bottom));display:flex;flex-direction:column;min-height:0}.heading,.eyebrow,.buttons{flex-shrink:0}.body-scroll{min-height:0;flex:1;max-height:48vh}.heading{max-height:18vh;overflow:hidden}@media (max-height:450px){.dialog-layer{padding:12rpx 24rpx}.dialog{max-height:calc(100vh - 24rpx);padding:18rpx 28rpx}.eyebrow{display:none}.heading{font-size:30rpx;max-height:14vh}.body-scroll{margin-top:12rpx;max-height:40vh}.buttons{margin-top:16rpx}}

.picker-dialog{max-width:680rpx}.picker-heading{display:flex;align-items:center;gap:10rpx;margin-bottom:18rpx}.nav-step{width:64rpx;min-height:64rpx;flex-shrink:0;padding:4rpx;font-size:40rpx;background:#f2edf5;color:#61046f}.calendar-heading{flex:1;min-width:0;min-height:64rpx;background:#fff;color:#61046f;padding:12rpx;font-size:28rpx}.option-list{display:flex;flex-direction:column;gap:10rpx}.option{display:flex;align-items:center;justify-content:space-between;gap:12rpx;box-sizing:border-box;width:100%;min-width:0;min-height:78rpx;margin:0;padding:18rpx 22rpx;background:#f7f4f9;color:#42334d;text-align:left;font-size:27rpx;font-weight:500}.option-label{flex:1;min-width:0;word-break:break-word}.option.selected,.day.selected{background:#760b88;color:#fff}.option.control-disabled,.day.control-disabled{opacity:.32}.year-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx}.year-grid .option{justify-content:center;padding:14rpx 6rpx;font-size:25rpx}.year-scroll{height:340rpx}.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8rpx}.weekdays{color:var(--muted,#6e617a);text-align:center;font-size:24rpx;margin-bottom:12rpx}.day{min-width:0;width:100%;min-height:64rpx;padding:14rpx 0;margin:0;font-size:25rpx;font-weight:500;background:#f7f4f9;color:#42334d;border-radius:12rpx}.time-labels,.time-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.time-labels{text-align:center;color:var(--muted,#6e617a);font-size:24rpx;margin-bottom:10rpx}.time-scroll{height:320rpx}.time-option{justify-content:center;margin-bottom:8rpx}.picker-summary{padding:20rpx 4rpx 0;color:#61046f;font-size:25rpx;text-align:center;word-break:break-word}.picker-error{color:#b33951;padding:12rpx 0;font-size:26rpx}.picker-empty{padding:30rpx;color:var(--muted,#6e617a);text-align:center;font-size:26rpx}

.body-scroll{flex:0 1 auto}

/* Explicit sizes keep native scroll-view/.dialog-control intrinsic widths inside the card. */
.dialog,.body-scroll,.picker-panel,.time-columns,.time-scroll,.buttons{box-sizing:border-box;min-width:0}
.body-scroll,.picker-panel,.time-columns,.buttons{width:100%;max-width:100%}
.buttons,.buttons.two,.buttons.one{display:flex;gap:16rpx}
.buttons>.dialog-control{flex:1 1 0;width:0;min-width:0;max-width:100%;box-sizing:border-box;margin:0}
.time-columns{display:flex;gap:20rpx}
.time-scroll{flex:1 1 0;width:0;min-width:0}
.time-option{width:100%;max-width:100%;min-width:0;box-sizing:border-box}

/* 使用类选择器显式约束原生按钮宽度，避免隔离组件忽略标签选择器。 */
.picker-panel .picker-heading{display:flex;width:100%;min-width:0;box-sizing:border-box;gap:10rpx}
.picker-panel .nav-step{flex:0 0 64rpx;width:64rpx;min-width:64rpx;max-width:64rpx;margin:0;box-sizing:border-box}
.picker-panel .calendar-heading{flex:1 1 0;width:0;min-width:0;max-width:100%;margin:0;box-sizing:border-box;white-space:nowrap}
.picker-panel .calendar-grid{display:flex;flex-wrap:wrap;flex-direction:row;width:100%;min-width:0;gap:0;box-sizing:border-box}
.picker-panel .calendar-grid .day,.picker-panel .calendar-grid.weekdays>.weekday{flex:0 0 calc(14.285714% - 8rpx);width:calc(14.285714% - 8rpx);min-width:0;max-width:calc(14.285714% - 8rpx);margin:4rpx;box-sizing:border-box;text-align:center}
.picker-panel .year-grid{display:flex;flex-wrap:wrap;flex-direction:row;width:100%;min-width:0;gap:0;box-sizing:border-box}
.picker-panel .year-grid .option{flex:0 0 calc(33.333333% - 10rpx);width:calc(33.333333% - 10rpx);min-width:0;max-width:calc(33.333333% - 10rpx);margin:5rpx;box-sizing:border-box}
.picker-panel .option-list:not(.year-grid) .option,.picker-panel .time-option{width:100%;min-width:0;max-width:100%;box-sizing:border-box}
.picker-panel .year-scroll{width:100%;max-width:100%;min-width:0;box-sizing:border-box}

.dialog .control-disabled{opacity:.48;box-shadow:none}
.dialog .dialog-control:focus-visible{outline:3rpx solid var(--focus,#760b88);outline-offset:3rpx}
.dialog .confirm{box-shadow:0 4rpx 12rpx rgba(99,50,119,.12)}
.dialog .dialog-control{word-break:break-word}
@media(prefers-reduced-motion:reduce){.spinner{animation:none}}

/* Mini is only an opt-out of WeChat default width, not a source of control spacing. */
.dialog .dialog-control{box-sizing:border-box;font-size:28rpx;line-height:1.5}
.dialog .buttons>.dialog-control{flex:1 1 0;width:0;min-width:0;min-height:88rpx;margin:0;padding:22rpx 12rpx;white-space:normal}
.dialog .picker-panel .nav-step{flex:0 0 64rpx;width:64rpx;min-width:64rpx;max-width:64rpx;height:64rpx;min-height:64rpx;padding:0;margin:0;line-height:64rpx;font-size:36rpx;white-space:nowrap}
.dialog .picker-panel .calendar-heading{flex:1 1 0;width:0;min-width:0;height:64rpx;min-height:64rpx;padding:0 8rpx;margin:0;line-height:64rpx;font-size:28rpx;white-space:nowrap}
.dialog .picker-panel .calendar-grid .day{flex:0 0 calc(14.285714% - 8rpx);width:calc(14.285714% - 8rpx);min-width:0;max-width:calc(14.285714% - 8rpx);height:64rpx;min-height:64rpx;max-height:64rpx;margin:4rpx;padding:0;line-height:64rpx;font-size:25rpx;white-space:nowrap;word-break:normal;overflow:hidden}
.dialog .picker-panel .year-grid .option{flex:0 0 calc(33.333333% - 10rpx);width:calc(33.333333% - 10rpx);min-width:0;max-width:calc(33.333333% - 10rpx);min-height:78rpx;margin:5rpx;padding:14rpx 4rpx;line-height:1.5;font-size:25rpx;white-space:nowrap;word-break:normal}
.dialog .picker-panel .option-list:not(.year-grid) .option{width:100%;min-width:0;max-width:100%;min-height:78rpx;margin:0;padding:18rpx 22rpx;line-height:1.5;font-size:27rpx;white-space:normal}
.dialog .picker-panel .time-option{width:100%;min-width:0;max-width:100%;min-height:78rpx;margin:0 0 8rpx;padding:18rpx 12rpx;line-height:1.5;font-size:27rpx;white-space:nowrap;word-break:normal}

/* Ordinary choices use a quiet bottom sheet; date/time geometry stays unchanged. */
.dialog-layer.selector-layer{align-items:flex-end;padding:0 16rpx calc(16rpx + env(safe-area-inset-bottom))}
.dialog.selector-dialog{max-width:720rpx;border-radius:30rpx;padding:30rpx 28rpx 26rpx;box-shadow:0 -12rpx 64rpx rgba(56,28,72,.12)}
.selector-dialog .heading{font-size:32rpx;line-height:1.45}
.selector-count{margin-top:8rpx;font-size:var(--type-meta,24rpx);line-height:1.5;color:var(--muted,#6e617a)}
.selector-dialog .body-scroll{margin-top:20rpx;max-height:48vh}
.selector-dialog .option-list{gap:8rpx}
.dialog.selector-dialog .picker-panel .option-list .option{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:84rpx;padding:18rpx 18rpx;border:1rpx solid var(--line,#e8def5);border-radius:16rpx;background:var(--surface,#fff);color:var(--ink,#24182f);font-size:27rpx;font-weight:500;text-align:left}
.dialog.selector-dialog .picker-panel .option-list .option.selected{background:var(--brand-soft,#f0e6fa);color:var(--brand-ink,#61046f);border-color:#d8c2e2;font-weight:600}
.selector-dialog .option-label{display:block;flex:1 1 0;min-width:0;white-space:normal;word-break:break-word;line-height:1.6}
.selection-mark{display:flex;align-items:center;justify-content:center;flex:0 0 34rpx;width:34rpx;height:34rpx;box-sizing:border-box;border:2rpx solid var(--control-border,#8d6a9e);border-radius:50%;font-size:23rpx;line-height:1;background:var(--surface,#fff)}
.selection-mark.checked{border-color:var(--brand,#760b88);background:var(--brand,#760b88);color:#fff}
.selector-dialog .buttons{margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid var(--line,#e8def5)}

.dialog-input:focus-visible{outline:3rpx solid var(--focus,#760b88);outline-offset:3rpx}

/* 仅确认、取消和普通选择行提高小屏触控下限，不改变日历与时间单元。 */
@media(max-width:375px){.dialog .buttons>.dialog-control{min-height:44px}}
@media(max-width:392.857px){.dialog.selector-dialog .picker-panel .option-list .option{min-height:44px}}

/* Modal actions align with page controls without changing picker geometry. */
.dialog .buttons>.cancel{background:#f4edfc;color:#61046f;box-shadow:inset 0 0 0 1rpx #dfcdee}
.dialog .buttons>.confirm{box-shadow:0 5rpx 14rpx rgba(99,50,119,.16)}
.dialog .buttons>.button-hover{opacity:.72}

/* v3 组件表面与页面主题一致，交互仍由原组件管理。 */
.dialog{border-color:#e5d7f3;border-radius:34rpx;box-shadow:0 24rpx 80rpx rgba(74,7,95,.2)}.heading{color:#30143e;font-weight:700}.confirm{background:linear-gradient(115deg,#a326c8,#7a0b8c 58%,#61026f);border-color:#72037e}.confirm.danger{background:#b33951}.cancel{background:#f0e6fa;color:#61046f}.option.selected,.day.selected{background:#760b88;color:#fff}.dialog-input{border-radius:22rpx}.selector-dialog{border-radius:34rpx 34rpx 0 0}.buttons .dialog-control{min-height:44px;border-radius:22rpx}.confirm.control-disabled{background:#e9e4ef;color:#766a80;box-shadow:none}

/* 微信隔离组件只使用类选择器；尺寸下限以 CSS px 计算。 */
.dialog-input{min-height:44px}.dialog .dialog-control{min-height:44px}.dialog .picker-panel .nav-step{flex:0 0 44px;width:44px;min-width:44px;max-width:44px;height:44px;line-height:44px}.dialog .picker-panel .calendar-heading{height:44px;min-height:44px;line-height:44px}.dialog .picker-panel .calendar-grid .day{height:44px;min-height:44px;max-height:44px;line-height:44px}
.dialog .buttons>.dialog-control,.dialog .picker-panel .time-option,.dialog .picker-panel .year-grid .option,.dialog .picker-panel .option-list:not(.year-grid) .option,.dialog.selector-dialog .picker-panel .option-list .option{min-height:44px}
