<view class="page players-page">
  <view class="players-heading"><view><view class="players-title">球队名册</view><view class="players-subtitle">找到并了解你的队友</view></view></view>
  <view class="players-tabs"><view aria-role="button" class="players-tab {{status==='active'?'is-active':''}}" data-status="active" bindtap="changeTab">在队球员</view><view aria-role="button" class="players-tab {{status==='inactive'?'is-active':''}}" data-status="inactive" bindtap="changeTab">历史队员</view><view aria-role="button" class="players-tab {{status==='unconfirmed'?'is-active':''}}" data-status="unconfirmed" bindtap="changeTab">待确认</view></view>
  <view class="player-filters"><view class="player-search"><view class="search-icon" aria-hidden="true"/><input disabled="{{loading}}" class="search-input" placeholder="搜索姓名或号码" placeholder-class="search-placeholder" value="{{search}}" bindinput="search" maxlength="100"/><button wx:if="{{search}}" class="ui-button search-clear" size="mini" disabled="{{loading}}" bindtap="clearSearch" aria-label="清除搜索">×</button></view><business-picker title="球员位置" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" class="position-filter" range="{{positions}}" value="{{positionIndex}}" bindchange="position"><view class="picker position-picker"><text class="picker-value">{{positions[positionIndex]}}</text></view></business-picker></view>
  <page-state id="page-state" skeleton-type="list" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/>
  <block wx:if="{{!loading && !error}}">
    <view class="list-heading"><text class="list-heading-title">{{status==='active'?'在队球员':status==='inactive'?'历史队员':'待确认球员'}}</text><text class="list-count">{{visible.length}} 人</text></view>
    <view wx:if="{{visible.length}}" class="player-list"><view aria-role="button" wx:for="{{visible}}" wx:key="id" class="player-row" data-id="{{item.id}}" bindtap="openPlayer" hover-class="player-row-pressed"><view class="avatar player-list-avatar {{!item.avatar?'player-placeholder':''}}"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" data-target="list" data-index="{{index}}" binderror="imageError" mode="aspectFill"/><text wx:else>{{item.initial}}</text></view><view class="player-info"><view class="player-name-line"><text class="player-name">{{item.name}}</text><text wx:if="{{item.avatarGenerated}}" class="generated-origin player-origin">{{item.avatarOriginLabel}}</text></view><view class="player-position">{{item.positionLabel}}</view></view><text wx:if="{{item.number!==null && item.number!==undefined}}" class="player-number">{{item.number}}<text class="number-unit">号</text></text><text class="player-chevron" aria-hidden="true">›</text></view></view>
    <view wx:else class="players-empty"><view class="empty-title">{{search || selectedPosition ? '没有找到球员' : '暂无球员'}}</view><view class="empty-caption">{{search || selectedPosition ? '试试调整搜索内容或位置' : '球员信息会显示在这里'}}</view></view>
  </block>
</view>
<business-dialog id="business-dialog"/>
