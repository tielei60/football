/* UI v3：管理页共享视觉由 app.wxss 令牌与品牌横幅提供。 */
.admin-header { gap:16rpx; flex-wrap:wrap; margin:24rpx 0; }
.field-label { font-size:26rpx; font-weight:500; color:var(--muted); margin-bottom:12rpx; }
.hint,.subtitle { font-size:24rpx; line-height:1.65; color:var(--muted); }
.section-title { font-size:32rpx; font-weight:650; line-height:1.4; }
.card { padding:34rpx; }
.error { overflow-wrap:anywhere; }
 .portrait-editor { gap:24rpx; padding-bottom:20rpx; }
.picture-preview,.portrait-editor>.avatar { width:140rpx; height:140rpx; flex-shrink:0; border-radius:50%; border:4rpx solid white; box-shadow:0 0 0 1px var(--line); }
.portrait-editor .stack { flex:1; min-width:0; gap:12rpx; }
.portrait-editor .stack button { width:100%; }
.position-options { display:flex; flex-wrap:wrap; gap:12rpx; }
.position-options button.ui-button.ui-compact[size="mini"] { flex:0 1 auto; width:auto; min-height:44px; min-width:44px; margin:0; padding:16rpx 20rpx; font-size:26rpx; font-weight:400; color:var(--muted); border:1px solid var(--line); background:var(--canvas); white-space:normal; }
.position-options button.ui-button.ui-compact.selected[size="mini"] { font-weight:600; background:var(--brand-soft)!important; border-color:var(--brand)!important; color:var(--brand-ink); }
.account-heading { gap:16rpx; flex-wrap:wrap; margin-bottom:24rpx; }
.account-heading .bold { font-size:32rpx; }
.account-card { margin-top:36rpx; }
.tag.status-pending { color:var(--warning); background:var(--warning-soft); }
.tag.status-active { color:var(--success); background:var(--success-soft); }
.tag.status-inactive { color:var(--muted); background:var(--canvas); }

/* V3 管理表单：持久标签与实际命中区，不改输入事件。 */
.page .portrait-editor .stack button.ui-button.ui-compact[size="mini"]{min-height:44px;min-width:44px;box-sizing:border-box}

/* 紧凑入口保留原视觉，显式覆盖全局 compact 的 rpx 最小触控尺寸。 */
.page button.ui-button.ui-compact.account-toggle[size="mini"]{min-height:44px;min-width:44px;box-sizing:border-box}

/* V3 编辑页原稿：浅底标题，紧凑头像操作，不额外插入品牌横幅。 */
.editor-heading{margin:16rpx 0 36rpx}
.editor-title{font-size:40rpx;font-weight:700;line-height:1.4;color:var(--brand-ink)}
.editor-subtitle{margin-top:16rpx;font-size:26rpx;line-height:1.6;color:var(--muted)}
.page .portrait-editor .stack{flex:0 1 auto;align-items:flex-start}
.page .portrait-editor .stack button{width:auto;margin:0;padding:0 20rpx}
.page .portrait-editor>.tag{margin-left:auto;flex-shrink:0}
.page .portrait-editor>.avatar,.page .portrait-editor>.picture-preview{width:128rpx;height:128rpx;border-radius:32rpx}
.page .portrait-editor .stack>button.ui-button.ui-compact[size="mini"]{width:auto;max-width:100%}
@media(max-width:340px){.page .portrait-editor{flex-wrap:wrap}.page .portrait-editor>.tag{margin-left:0}}

/* ZIP 12：选择头像描边，移除头像弱文字，不改变禁用条件。 */
.page .portrait-editor .stack>button.ui-button.ui-compact[size="mini"]{background:var(--surface);border:1rpx solid var(--control-border);color:var(--brand-ink);box-shadow:none}
.page .portrait-editor .stack>button.ghost.ui-button.ui-compact[size="mini"]{background:transparent;border-color:transparent;color:var(--muted)}
.page .portrait-editor .stack>button.ui-button.ui-compact[size="mini"][disabled]{color:var(--muted);opacity:.55}
.page .position-options button.ui-button.ui-compact[size="mini"][disabled]{opacity:.5;box-shadow:none}

/* V3 12：照片与邀请共用白色入口卡；保留原事件与忙碌禁用。 */
.page .player-service-card{margin-top:28rpx;padding:0 28rpx}
.page .player-service-card button.player-service-entry[size="mini"]{display:flex;align-items:center;gap:24rpx;width:100%;min-height:64px;margin:0;padding:24rpx 0;border:0;border-radius:0;background:transparent;box-shadow:none;text-align:left;color:var(--ink);white-space:normal}
.player-service-entry+ .player-service-entry{border-top:1px solid var(--line)!important}
.player-service-entry .service-label{flex:1;min-width:0;overflow-wrap:anywhere;font-size:30rpx;font-weight:600}
.player-service-entry .service-icon{width:36rpx;height:36rpx;flex:none;box-sizing:border-box}
.player-service-entry .service-chevron{flex:none;font-size:40rpx;font-weight:400;color:var(--brand-ink)}
.service-envelope{position:relative;border:2px solid var(--brand);border-radius:5rpx;height:28rpx!important;overflow:hidden}
.service-envelope::after{content:"";position:absolute;left:18%;top:-45%;width:58%;height:75%;border:2px solid var(--brand);border-top:0;border-left:0;transform:rotate(45deg)}
.page .player-service-card button.player-service-entry[size="mini"][disabled]{opacity:.5;color:var(--muted)}

.player-identity-card .identity-heading{gap:20rpx;align-items:center;flex-wrap:wrap;margin-bottom:12rpx}
.player-identity-card .field-label{margin:0}
.identity-value{color:var(--brand-ink);font-size:28rpx;font-weight:600}
.player-identity-card .promote-player{margin-top:20rpx;min-height:44px;white-space:normal}
