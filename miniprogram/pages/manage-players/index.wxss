.position-options{display:flex;flex-wrap:wrap;gap:14rpx}.position-options .selected{background:var(--brand);color:#fff}.admin-header{margin-bottom:28rpx}.picture-preview{width:140rpx;height:140rpx;border-radius:28rpx;background:var(--brand-soft)}
/* Page-specific density, hierarchy and long-content safeguards. */
.admin-header{gap:16rpx;align-items:center;margin-bottom:22rpx}.admin-header .title{min-width:0;font-size:34rpx}.admin-header button{width:auto;flex-shrink:0;margin:0}.card{padding:22rpx 24rpx}.card .grow{min-width:0}.card .bold{overflow-wrap:anywhere}.card .tag{flex-shrink:0}.card .muted{line-height:1.6;font-size:24rpx}

/* 管理文字层级：仅文字与组间留白，不改原生输入及业务布局。 */
.admin-header .title{font-size:34rpx;font-weight:650;color:var(--ink)}
.card .bold{font-size:30rpx;font-weight:600;line-height:1.4;color:var(--ink)}
.card .muted{font-size:25rpx;font-weight:400;line-height:1.6;margin-top:6rpx;color:var(--muted)}
.card .tag{font-size:24rpx;font-weight:500}
.tabs .tab{font-size:26rpx;font-weight:500}
@media(max-width:360px){.card .muted{font-size:12px}}
@media(max-width:375px){.card .tag{font-size:12px}}

/* 球员列表：姓名优先、号码次级；账号状态不压缩姓名。 */
.admin-header { flex-wrap:wrap; gap:var(--space-2); margin-bottom:var(--space-3); }
.admin-header .title { font-size:var(--type-page); line-height:1.35; }
.card.row { align-items:flex-start; gap:var(--space-2); }
.card .grow { flex:1; min-width:0; }
.card .bold { font-size:var(--type-card); line-height:1.45; }
.player-number-note { display:block; font-size:var(--type-meta); font-weight:400; color:var(--muted); margin-top:var(--space-1); }
.card .muted { font-size:var(--type-field); margin-top:var(--space-1); }
.card .tag { max-width:160rpx; white-space:normal; text-align:center; font-size:var(--type-meta); background:var(--canvas); color:var(--muted); }
.tabs { margin-top:var(--space-2); }
