/* V3 shared color, surface and control tokens remain owned by app.wxss. */
.catalog-toolbar{display:flex;gap:20rpx;align-items:center;margin:28rpx 0}
.catalog-toolbar .input{flex:1;min-width:0;margin:0}
.catalog-toolbar .ui-button{flex:none;margin:0}
.catalog-row{display:flex;align-items:center;gap:20rpx;margin-bottom:20rpx;padding:28rpx}
.catalog-body{flex:1;min-width:0}
.catalog-name{font-size:30rpx;line-height:1.45;font-weight:650;color:var(--ink);overflow-wrap:anywhere}
.catalog-summary{font-size:25rpx;line-height:1.6;color:var(--muted);margin-top:10rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}
.catalog-logo{width:80rpx;height:80rpx;flex:none;border-radius:16rpx;background:var(--canvas)}
.catalog-state{display:flex;align-items:center;gap:14rpx;flex:none;color:var(--muted)}
.catalog-inactive{background:var(--canvas);color:var(--muted)}
.catalog-empty{text-align:center;padding:48rpx 24rpx;color:var(--muted);font-size:27rpx}
.catalog-editor{margin-top:28rpx;padding:32rpx}
.catalog-editor .section-title{font-size:32rpx;font-weight:650;margin-bottom:32rpx}
.field-label{display:block;font-size:26rpx;color:var(--muted);margin-bottom:14rpx}
.catalog-textarea{width:100%;min-height:180rpx;height:180rpx;box-sizing:border-box;line-height:1.6}
.catalog-notice{height:360rpx}
.catalog-image-actions{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}
.catalog-image-actions .ui-button{margin:0}
.catalog-logo-preview{width:100rpx;height:100rpx}
.catalog-actions{display:flex;gap:20rpx;margin-top:32rpx}
.catalog-actions .ui-button{flex:1;min-width:0;margin:0}
.catalog-archive{display:block;margin:28rpx auto 0;color:var(--muted)}
.catalog-warning{color:var(--muted);font-size:26rpx;line-height:1.65;overflow-wrap:anywhere;margin-bottom:24rpx}
.catalog-warning .ui-button{margin-top:16rpx}
.error{overflow-wrap:anywhere}
