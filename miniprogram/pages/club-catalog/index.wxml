<view class="page">
  <view class="club-page-banner"><view class="club-eyebrow">BERLIN FC</view><view class="club-banner-title">{{title}}管理</view><view class="club-banner-subtitle">球队常用资料</view><image class="club-banner-mark" src="/assets/team-badge.png" mode="aspectFit" aria-hidden="true"/></view>
  <page-state id="page-state" loading="{{loading}}" error="{{error}}" skeleton-type="list" bind:retry="refresh"/>
  <block wx:if="{{!loading && !error && authorized}}">
    <block wx:if="{{!editor}}">
      <view class="catalog-toolbar"><input class="input" placeholder="搜索{{title}}" value="{{search}}" bindinput="search" maxlength="200"/><button class="primary ui-button" size="mini" bindtap="create" disabled="{{busy || uncertain}}">＋ 新增</button></view>
      <view wx:if="{{uncertain}}" class="card catalog-warning"><text>上次新增结果待核对，请检查下方列表。</text><button class="ui-button" size="mini" bindtap="recover" disabled="{{busy}}">已核对，解除提醒</button></view>
      <view wx:if="{{!visible.length}}" class="card catalog-empty">{{search?'没有找到匹配的记录':'暂无记录，点击新增开始添加'}}</view>
      <view wx:for="{{visible}}" wx:key="id" class="card catalog-row" data-id="{{item.id}}" bindtap="edit" aria-role="button" hover-class="club-card-pressed">
        <image wx:if="{{item.logo}}" class="catalog-logo" src="{{item.logo}}" mode="aspectFit"/>
        <view class="catalog-body"><view class="catalog-name">{{item.label}}</view><view wx:if="{{item.summary}}" class="catalog-summary">{{item.summary}}</view></view>
        <view class="catalog-state"><text class="tag {{item.status==='inactive'?'catalog-inactive':''}}">{{item.status==='inactive'?'已停用':'可选'}}</text><text aria-hidden="true">›</text></view>
      </view>
    </block>
    <view wx:else class="card catalog-editor">
      <view class="section-title">{{editing?'编辑':'新增'}}{{title}}</view>
      <view class="field"><text class="field-label">{{type==='notice'?'标题':'名称'}} *</text><input class="input" value="{{type==='notice'?form.title:form.name}}" data-field="{{type==='notice'?'title':'name'}}" bindinput="input" maxlength="200" disabled="{{busy}}" placeholder="填写{{type==='notice'?'模板标题':title+'名称'}}"/></view>
      <block wx:if="{{type!=='notice'}}">
        <view class="field"><text class="field-label">{{type==='opponent'?'队徽':'赛事标志'}} · 选填</text><view class="catalog-image-actions"><image wx:if="{{logo}}" class="catalog-logo catalog-logo-preview" src="{{logo}}" binderror="imageError" mode="aspectFit"/><button class="ui-button" size="mini" bindtap="chooseLogo" disabled="{{busy}}">{{logo?'更换图片':'选择图片'}}</button><button wx:if="{{logo}}" class="ui-button" size="mini" bindtap="clearLogo" disabled="{{busy}}">移除</button></view></view>
        <view class="field"><text class="field-label">简介 · 选填</text><textarea class="input catalog-textarea" value="{{form.introduction}}" data-field="introduction" bindinput="input" maxlength="10000" disabled="{{busy}}" placeholder="填写简要介绍"/></view>
        <view wx:if="{{type==='opponent'}}" class="field"><text class="field-label">队员资料 · 选填</text><textarea class="input catalog-textarea" value="{{form.playerSummary}}" data-field="playerSummary" bindinput="input" maxlength="10000" disabled="{{busy}}" placeholder="记录常用号码、位置或需关注的球员"/></view>
      </block>
      <view wx:else class="field"><text class="field-label">须知内容 *</text><textarea class="input catalog-textarea catalog-notice" value="{{form.content}}" data-field="content" bindinput="input" maxlength="10000" disabled="{{busy}}" placeholder="填写比赛注意事项"/></view>
      <view wx:if="{{uncertain && !editing}}" class="catalog-warning">上次新增结果待核对，请返回列表检查。</view>
      <view wx:if="{{conflict}}" class="catalog-warning">记录已变化，请重新载入后再修改。<button class="ui-button" size="mini" bindtap="reload" disabled="{{busy}}">重新载入</button></view>
      <view class="catalog-actions"><button class="ui-button" size="mini" bindtap="list" disabled="{{busy}}">返回列表</button><button class="primary ui-button" size="mini" bindtap="save" loading="{{busy}}" disabled="{{busy || conflict || (uncertain && !editing)}}">保存</button></view>
      <button wx:if="{{editing}}" class="ui-button catalog-archive" size="mini" bindtap="archive" disabled="{{busy || conflict}}">{{form.status==='active'?'停用此记录':'恢复此记录'}}</button>
    </view>
    <view wx:if="{{actionError}}" class="error" role="alert">{{actionError}}</view>
  </block>
</view>
<business-dialog id="business-dialog"/>
