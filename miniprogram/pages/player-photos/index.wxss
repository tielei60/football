/* 球员照片集沿用现有紫色主题，不改变原生输入几何。 */
.title{font-size:var(--type-page);font-weight:650;color:var(--ink);line-height:1.35}
.photo{width:100%;height:360rpx;border-radius:18rpx;background:var(--canvas);margin-bottom:16rpx}
.section-title{margin-top:24rpx;font-size:var(--type-section);font-weight:600}
.card .between{gap:14rpx;align-items:flex-start}
.photo-caption{flex:1;min-width:0;font-size:var(--type-body);font-weight:500;color:var(--ink);overflow-wrap:anywhere;line-height:1.55}
.tag{flex-shrink:0;font-size:24rpx;font-weight:500}
/* 独立动作组避开全局.actions规则：主要操作两列，排序与移除三列。 */
.photo-actions-main,.photo-actions-secondary{display:flex;gap:12rpx;margin-top:16rpx;min-width:0}
.page .photo-actions-main>button.ui-button[size="mini"],.page .photo-actions-secondary>button.ui-button[size="mini"]{box-sizing:border-box;flex:1 1 0;width:0;min-width:0;max-width:100%;min-height:44px;margin:0;font-size:25rpx;padding:16rpx 12rpx;line-height:1.5;white-space:normal}
.card>.input{margin:16rpx 0}
.hint{font-size:var(--type-meta);line-height:1.6;color:var(--muted)}
.upload-uncertain{font-weight:500;color:var(--ink)}
.error{font-size:var(--type-field);font-weight:500}
@media(max-width:375px){.tag{font-size:12px}}
@media(max-width:360px){.hint{font-size:12px}}
@media(max-width:346px){.error{font-size:12px}}
@media(max-width:333px){.photo-caption{font-size:var(--type-body)}}
@media(max-width:321px){.section-title{font-size:var(--type-section)}}

/* v3 照片卡：图片、来源、说明、操作逐层排列。 */
.card { padding:28rpx; border-radius:30rpx; }
.photo { height:420rpx; border-radius:24rpx; }
.section-title { margin:36rpx 0 18rpx; padding-left:18rpx; border-left:6rpx solid var(--brand); }
.card .between { padding:4rpx 0 12rpx; flex-wrap:wrap; }
.photo-caption { flex-basis:50%; }
.photo-actions-secondary { padding-top:16rpx; border-top:1px solid var(--line); }
.generated-origin { color:var(--warning); background:var(--warning-soft); }
