<view class="page"><view class="club-page-banner"><view class="club-eyebrow">BERLIN FC</view><view class="club-banner-title">赛季管理</view><view class="club-banner-subtitle">球队管理</view><image class="club-banner-mark" src="/assets/team-badge.png" mode="aspectFit" aria-hidden="true"/></view><view class="admin-create-action"><button disabled="{{loading}}" wx:if="{{authorized}}" class="primary ui-button ui-block" bindtap="create" size="mini">新增赛季</button></view><page-state skeleton-type="list" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error&&authorized}}"><view class="hint">自定义起止周期，可跨年。比赛归属需单独选择。</view><view aria-role="button" wx:for="{{seasons}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="edit" hover-class="club-card-pressed"><view class="bold">{{item.name}}</view><view class="muted">{{item.startDate}} 至 {{item.endDate}} ›</view></view><view wx:if="{{!seasons.length}}" class="empty">还没有赛季</view></block></view>
<business-dialog id="business-dialog"/>
