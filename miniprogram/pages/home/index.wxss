/* 本页文字层级；不改变输入、按钮、列数或画布几何。 */
.hero {
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg,var(--surface),var(--brand-soft));
  border: 1rpx solid #e8dcef;
  border-color: var(--line);
}
.hero .title {
  font-size: var(--type-page);
  margin-top: 6rpx;
  line-height: 1.35;
  font-weight: 700;
}
.hero-metrics {
  display: grid;
  margin-top: 28rpx;
  gap: 16rpx;
  color: var(--muted);
  font-size: 24rpx;
  grid-template-columns: repeat(3,minmax(0,1fr));
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}
.hero-number {
  display: block;
  font-size: 40rpx;
  color: var(--brand-ink);
  font-weight: 700;
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
}
.next {
  border-color: var(--brand-soft);
}
.match-title {
  font-size: var(--type-section);
  font-weight: 600;
  margin: 20rpx 0 12rpx;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.hero .subtitle {
  font-size: 24rpx;
  letter-spacing: 0;
  line-height: 1.6;

  color: var(--muted);
}
.hero .avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
}
.hero .grow {
  min-width: 0;
}
.card .score {
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
  font-size: 36rpx;
  font-weight: 650;
}
.match-time {
  font-size: var(--type-body);
  font-weight: 500;
  line-height: 1.6;
  color: var(--ink);
}
.match-place {
  font-size: var(--type-field);
  line-height: 1.6;
}
.recent-name {
  font-size: var(--type-card);
  font-weight: 600;
  line-height: 1.4;
}
.section-title {
  font-size: var(--type-section);
  font-weight: 600;
}
.card .muted, .card .tag, .section .link {
  font-size: 24rpx;
}
.card .muted.match-place {
  font-size: 26rpx;
}

/* 小屏正文下限 12px，仅覆盖以上内容文字，不影响控件。 */
@media (max-width: 375.000px) {
  .hero .subtitle, .hero-metrics, .card .muted, .card .tag, .section .link { font-size: 12px; }
}
@media (max-width: 346.154px) {
  .card .muted.match-place { font-size: 12px; }
}
@media (max-width: 321.429px) {
  .match-time { font-size: var(--type-body); }
}

/* Schedule link keeps a full tap area while looking like a light navigation action. */
.page .between>button.home-schedule-link[size="mini"]{min-height:44px;padding:0 12rpx;margin:0 -12rpx 0 0;border:0;background:transparent;color:var(--brand-ink);font-size:24rpx;font-weight:600;line-height:1.4;box-shadow:none;white-space:nowrap}
.page .between>button.home-schedule-link[size="mini"]::after{border:0}

.signup-summary{align-items:flex-start;gap:12rpx}.signup-counts{display:flex;flex:1;min-width:0;flex-wrap:wrap;gap:6rpx 18rpx;color:var(--muted);font-size:25rpx;line-height:1.6}.signup-counts text{white-space:nowrap}.signup-summary>.tag{flex-shrink:0}@media(max-width:360px){.signup-counts{font-size:12px}}

/* V3：俱乐部品牌与内容分层，数据及操作由原页面维护。 */
.club-home-hero{position:relative;overflow:hidden;margin:-28rpx -28rpx 0;padding:0;border:0;border-radius:0 0 36rpx 36rpx;min-height:368rpx;background:#510961}.hero-atmosphere,.hero-shade{position:absolute;inset:0;width:100%;height:100%}.hero-shade{background:linear-gradient(90deg,rgba(63,5,77,.94),rgba(87,10,105,.78))}.hero-content{position:relative;padding:30rpx 32rpx 42rpx;color:#fff}.hero-brand{display:flex;align-items:center;gap:14rpx;font-size:28rpx;font-weight:600}.hero-brand image{width:62rpx;height:62rpx}.hero-tagline{display:inline-block;margin-top:28rpx;padding:6rpx 14rpx;border:1rpx solid #c58fd3;border-radius:8rpx;font-size:24rpx;color:#f2dffc;background:#ffffff18}.hero-headline{white-space:pre-line;font-size:52rpx;font-weight:800;line-height:1.4;margin-top:20rpx}.hero-caption{font-size:24rpx;color:#e6d5ed;margin-top:24rpx}.hero-metrics{position:relative;margin: -8rpx 0 0;padding:24rpx;background:#fff;border:1rpx solid var(--line);border-radius:26rpx;gap:12rpx;text-align:center;box-shadow:0 8rpx 24rpx #6a006810}.hero-metrics>view+view{border-left:1rpx solid var(--line)}.hero-number{font-size:44rpx}.next{overflow:hidden;padding:0 28rpx 24rpx;border-radius:30rpx;box-shadow:0 8rpx 22rpx #6a006811}.next>.between:first-child{margin:0 -28rpx;padding:16rpx 24rpx;background:#f2e5fc}.fixture-teams{display:flex;align-items:center;gap:14rpx;margin:28rpx 0}.fixture-team{flex:1;min-width:0;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12rpx;font-weight:600;font-size:28rpx;overflow-wrap:anywhere}.fixture-team image,.fixture-symbol{width:94rpx;height:100rpx}.fixture-symbol{display:flex;align-items:center;justify-content:center;background:#dff3ff;border:2rpx solid #91bdd2;border-radius:14rpx 14rpx 30rpx 30rpx;font-size:38rpx;color:#39677e}.fixture-versus{font-size:52rpx;font-weight:800;color:var(--brand);text-align:center;flex:none}.fixture-versus text{display:block;font-size:24rpx;color:var(--muted);font-weight:400}.fixture-team .match-title{margin:0;font-size:28rpx}.fixture-cta{margin-top:24rpx;padding:24rpx 12rpx;text-align:center;border-radius:22rpx;background:linear-gradient(110deg,#a326c8,#61026f);color:#fff;font-size:28rpx;font-weight:600;min-height:88rpx}.card .score{font-size:44rpx}.section-title{border-left:6rpx solid var(--brand);padding-left:14rpx}

.opponent-ball{position:relative;width:44rpx;height:44rpx;border:3rpx solid #39677e;border-radius:50%}.opponent-ball:before{content:"";position:absolute;left:11rpx;top:11rpx;width:16rpx;height:16rpx;border:3rpx solid #39677e;border-radius:5rpx;transform:rotate(45deg)}

.hero-badge-fallback{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;flex:none;border:2rpx solid #d9b4e7;border-radius:12rpx;background:#ffffff20;font-size:30rpx;color:#fff}

.club-quick,.member-shortcuts{display:flex;gap:12rpx;margin:26rpx 0}.page .club-quick button.ui-button[size="mini"],.page .member-shortcuts button.ui-button[size="mini"]{display:flex;flex:1;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;min-height:132rpx;padding:20rpx 4rpx;margin:0;background:linear-gradient(125deg,#fff,#f5edff);border:1rpx solid #e1cdef;border-radius:24rpx;font-size:24rpx;box-shadow:0 6rpx 18rpx #6a006810}.club-quick image,.member-shortcuts image{width:44rpx;height:44rpx}.member-shortcuts{margin-top:-24rpx}.membership-hero{flex-wrap:wrap}.member-shirt{max-width:100%;margin-left:auto}.member-shirt text:first-child{font-size:60rpx}.membership-hero .grow{min-width:180rpx}

/* 自然年数据置于近期赛果之后，避免打断下一场报名路径。 */
.annual-record .hero-metrics{margin-top:0}

/* 横向赛果保留全部记录，窄屏滑动查看，不推断未知比分胜负。 */
.result-strip{width:100%;white-space:nowrap}.result-tickets{display:flex;gap:16rpx;padding:4rpx 0 12rpx}.result-ticket{display:flex;flex:0 0 calc((100% - 32rpx)/3);min-width:196rpx;flex-direction:column;gap:14rpx;padding:22rpx 14rpx;box-sizing:border-box;border:1rpx solid var(--line);border-radius:24rpx;background:#fff;white-space:normal;overflow-wrap:anywhere;text-align:center}.result-date{font-size:12px;color:var(--muted);line-height:1.5}.result-score{font-size:38rpx;font-weight:700;color:var(--brand-ink);line-height:1.3}.result-opponent{font-size:var(--type-field);font-weight:500;line-height:1.5}

/* 赛果标记遵循已有我方/对方比分口径，未知不推断胜负。 */
.result-outcome{display:block;font-size:24rpx;line-height:1.5;color:var(--muted)}
.result-outcome.win{color:var(--success)}
.result-outcome.loss{color:var(--danger)}
.result-outcome.draw{color:var(--brand-ink)}

/* 下一场标题融入卡片；赛事/人数制可换行，不改变整卡详情事件。 */
.fixture-heading{display:flex;align-items:stretch;margin:0 -28rpx;background:var(--brand-soft);gap:12rpx}.fixture-heading-title{display:flex;align-items:center;flex:none;padding:18rpx 24rpx;background:var(--brand);color:#fff;font-size:var(--type-card);font-weight:700}.fixture-heading-meta{display:flex;flex:1;min-width:0;flex-wrap:wrap;align-content:center;justify-content:flex-end;gap:4rpx 12rpx;padding:14rpx 18rpx 14rpx 0;font-size:var(--type-field);color:var(--brand-ink);overflow-wrap:anywhere}
.result-ticket{text-align:left}.result-ticket-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:8rpx;flex-wrap:wrap}.result-ticket-heading .result-date{min-width:0;flex:1;text-align:right;overflow-wrap:anywhere}.result-outcome{padding:4rpx 10rpx;border-radius:10rpx;background:var(--surface);font-weight:600}.result-outcome.win{background:#e2f5eb}.result-outcome.loss{background:#fff0f3}.result-outcome.draw{background:var(--brand-soft)}
