<view class="page"><page-state skeleton-type="form" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error&&authorized}}"><view class="editor-heading"><view class="editor-title">{{id?'编辑球员':'新增球员'}}</view><view class="editor-subtitle">资料、照片与账号分开管理。</view></view><view class="card"><view class="row portrait-editor"><image wx:if="{{avatar}}" class="picture-preview" src="{{avatar}}" mode="aspectFill" binderror="imageError"/><view wx:else class="avatar large player-placeholder">{{initial}}</view><view class="stack"><button class="small ui-button ui-compact" bindtap="choose" disabled="{{loading || (busy)}}" size="mini">选择头像</button><button class="small ghost ui-button ui-compact" bindtap="remove" disabled="{{loading || (busy||!avatar)}}" size="mini">移除头像</button></view><text class="tag {{membershipConfirmed===false?'status-pending':status==='active'?'status-active':'status-inactive'}}">{{membershipConfirmed===false?'状态未确认':status==='active'?'在队':'已归档'}}</text></view><view class="hint">PNG / JPG，最大 2 MB</view><view class="field"><text class="field-label">姓名 *</text><input class="input" value="{{form.name}}" data-field="name" bindinput="input" maxlength="200" disabled="{{loading || (busy)}}"/></view><view class="field"><text class="field-label">号码</text><input class="input" type="number" value="{{form.number}}" data-field="number" bindinput="input" maxlength="4" placeholder="未知可留空" disabled="{{loading || (busy)}}"/></view><view class="field"><text class="field-label">位置 · 可多选</text><view class="position-options"><button wx:for="{{positionOptions}}" wx:key="name" class="small {{item.selected?'selected':''}} ui-button ui-compact" data-name="{{item.name}}" bindtap="position" disabled="{{loading || (busy)}}" size="mini">{{item.name}}</button></view></view><view class="field"><text class="field-label">惯用脚</text><business-picker title="惯用脚" bind:pickeropen="openBusinessPicker" range="{{feet}}" value="{{footIndex}}" bindchange="foot" disabled="{{loading || (busy)}}"><view class="picker"><text class="picker-value">{{feet[footIndex]}}</text></view></business-picker></view><view class="field"><text class="field-label">成员状态</text><business-picker title="成员状态" bind:pickeropen="openBusinessPicker" range="{{membershipOptions}}" value="{{membershipIndex}}" bindchange="membership" disabled="{{loading||busy||conflict||uncertain}}"><view class="picker"><text class="picker-value">{{membershipOptions[membershipIndex]}}</text></view></business-picker></view><text class="field-label">备注</text><textarea value="{{form.note}}" data-field="note" bindinput="input" maxlength="20000" disabled="{{loading || (busy)}}"/></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><button disabled="{{loading}}" wx:if="{{conflict}}" bindtap="reload" class="ui-button ui-block" size="mini">重新载入</button><button disabled="{{loading}}" wx:if="{{uncertain}}" bindtap="backToList" class="ui-button ui-block" size="mini">到球员列表核对</button><button disabled="{{loading || busy}}" wx:if="{{uncertain&&!id}}" bindtap="confirmCreated" class="ui-button ui-block" size="mini">已核对，记录已存在</button><button disabled="{{loading}}" wx:if="{{uncertain&&!id}}" bindtap="confirmNotCreated" class="ui-button ui-block" size="mini">已核对，确认未创建</button><button class="primary ui-button ui-block" bindtap="save" loading="{{busy}}" disabled="{{loading || (busy||conflict||uncertain)}}" size="mini">保存球员</button><view wx:if="{{id}}" class="card player-service-card"><button bindtap="openPhotos" disabled="{{busy}}" class="ui-button ui-block player-service-entry" size="mini"><image src="/assets/photos-shortcut.png" class="service-icon" mode="aspectFit" aria-hidden="true"/><text class="service-label">管理出场照片</text><text class="service-chevron" aria-hidden="true">›</text></button><button bindtap="openWechat" disabled="{{busy}}" class="ui-button ui-block player-service-entry" size="mini"><view class="service-icon service-envelope" aria-hidden="true"/><text class="service-label">微信邀请与绑定</text><text class="service-chevron" aria-hidden="true">›</text></button></view><view wx:if="{{id}}" class="card section account-card"><view class="between account-heading"><text class="bold">登录账号</text><text class="tag">{{hasAccount?'已开通':'未开通'}}</text></view><button wx:if="{{status==='active'&&(!hasAccount||passwordEnabled)}}" class="small ui-button ui-compact account-toggle" bindtap="toggleAccount" disabled="{{loading || (busy)}}" size="mini">{{accountOpen?'收起':hasAccount?'重置密码':'开通账号'}}</button><view wx:if="{{accountOpen&&(!hasAccount||passwordEnabled)}}" class="section"><label wx:if="{{!hasAccount}}" class="field-label" for="player-account-name">登录账号</label><input id="player-account-name" wx:if="{{!hasAccount}}" class="input field" value="{{username}}" data-field="username" bindinput="accountInput" placeholder="新账号" maxlength="80" disabled="{{loading || (busy)}}"/><label class="field-label" for="player-account-password">新密码</label><input id="player-account-password" class="input field" password value="{{password}}" data-field="password" bindinput="accountInput" placeholder="至少 10 位密码" maxlength="256" disabled="{{loading || (busy)}}"/><button bindtap="account" disabled="{{loading || (busy||conflict||uncertain)}}" class="ui-button ui-block" size="mini">{{hasAccount?'确认重置密码':'创建账号'}}</button></view></view><button wx:if="{{id&&membershipConfirmed}}" class="danger ui-button ui-block" style="margin-top:24rpx" bindtap="archive" disabled="{{loading || (busy||conflict||uncertain)}}" size="mini">{{status==='active'?'归档球员':'恢复球员'}}</button></block></view>
<business-dialog id="business-dialog"/>

<invite-sheet id="invite-sheet" player="{{id}}"/>
