/* 本页文字层级；不改变输入、按钮、列数或画布几何。 */
.login {
  padding-top: 100rpx;
}
.brand-mark {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 750;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(99,50,119,.1);
  line-height: 88rpx;
}
/* 打包队徽保留原图背景，适应原标识占位，不挪动登录表单。 */
.brand-image {
  width: 88rpx;
  height: 88rpx;
  display: block;
}
.brand-fallback {
  font-size: 20rpx;
  line-height: 1.3;
  text-align: center;
}
.login-card {
  margin-top: 42rpx;
  padding: 30rpx;
  border-radius: 24rpx;
}
.login>.title {
  font-size: 38rpx;
  letter-spacing: 1rpx;
  font-weight: 650;
  line-height: 1.4;
}
.login>.subtitle {
  font-size: 25rpx;
  line-height: 1.65;
  margin-top: 10rpx;
}
.login-card .field {
  margin-bottom: 24rpx;
}
.login .hint {
  font-size: 24rpx;
  line-height: 1.65;
  margin-top: 24rpx;
}
.field-label {
  font-size: 26rpx;
  font-weight: 500;
}
.error {
  font-size: 26rpx;
  font-weight: 500;
}

/* 小屏正文下限 12px，仅覆盖以上内容文字，不影响控件。 */
@media (max-width: 375.000px) {
  .login .hint { font-size: 12px; }
}
@media (max-width: 360.000px) {
  .login>.subtitle { font-size: 12px; }
}
@media (max-width: 346.154px) {
  .field-label, .error { font-size: 12px; }
}

/* 微信入口复用主布局，不改变密码输入几何。 */
.wechat-entry{padding-top:0}
