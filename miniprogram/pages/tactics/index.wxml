<view class="page"><view class="club-page-banner"><view class="club-eyebrow">BERLIN FC</view><view class="club-banner-title">{{historical?'本场战术留档':'球队战术'}}</view><view class="club-banner-subtitle">{{historical?'保留本场站位与战术安排':'每一次配合，从这里开始'}}</view><image class="club-banner-mark" src="/assets/team-badge.png" mode="aspectFit" aria-hidden="true"/></view><page-state id="page-state" skeleton-type="list" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error}}"><view class="tactical-actions"><button wx:if="{{canManage}}" disabled="{{loading}}" id="new-tactic" bindtap="create" class="primary ui-button ui-block section" size="mini">＋ 新建战术</button><button disabled="{{loading}}" wx:if="{{canManage}}" class="small section ui-button ui-compact" id="tactic-transfer" bindtap="transfer" size="mini">导入 / 导出战术</button></view><view class="tactic-search"><view class="search-symbol" aria-hidden="true"/><input disabled="{{loading}}" class="input section" placeholder="搜索战术或阵型" value="{{search}}" bindinput="search"/></view><view aria-role="button" class="card section tactic-card" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="open" hover-class="club-card-pressed"><view class="pitch-symbol" aria-hidden="true"><view class="pitch-lines"><view class="pitch-midline"/><view class="pitch-circle"/></view></view><view class="tactic-info"><view class="between"><text class="bold">{{item.title}}</text></view><view class="muted">{{item.format}} 人制 · {{item.formation}}</view><text class="tag">{{item.source}} · {{canManage?'可编辑':'只读'}}</text></view><text class="tactic-chevron" aria-hidden="true">›</text></view><view wx:if="{{!visible.length}}" class="empty">{{items.length ? '没有找到匹配的战术，请调整搜索内容' : historical ? '本场比赛尚未留存战术' : '还没有战术'}}</view><view class="hint tactic-help">竖向球场查看站位与演示，管理员可编辑战术。</view></block></view>

<business-dialog id="business-dialog"/>
