
/* Page-specific density, hierarchy and long-content safeguards. */
.field-label{font-size:24rpx;line-height:1.5;margin-bottom:10rpx}.filter-row{align-items:flex-start;gap:16rpx}.filter-row>.grow{min-width:0}.card .picker{white-space:normal;line-height:1.45;overflow-wrap:anywhere}.card textarea{min-height:180rpx;line-height:1.65}.title{font-size:34rpx}.subtitle{line-height:1.6}.actions{gap:14rpx}.page button.small.ghost{font-size:24rpx}

/* 比赛文字层级：标签与说明，不覆盖控件文字或原生输入几何。 */
.title{font-size:34rpx;font-weight:650}
.field-label{font-size:26rpx;font-weight:500;color:var(--ink)}
.section-title{font-size:28rpx;font-weight:600}
.subtitle,.hint{font-size:25rpx;line-height:1.6;color:var(--muted)}
.error{font-size:26rpx;font-weight:500}
@media(max-width:360px){.subtitle,.hint{font-size:12px}}
@media(max-width:346px){.field-label,.error{font-size:12px}}
@media(max-width:321px){.section-title{font-size:12px}}

.capacity-hint{margin-top:8rpx;color:var(--muted);font-size:24rpx;line-height:1.5}
