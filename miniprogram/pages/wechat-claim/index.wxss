.title{font-size:34rpx;font-weight:650;color:var(--ink)}
.section-title{font-size:28rpx;font-weight:600}
.field-label{font-size:26rpx;font-weight:500}
.hint{font-size:25rpx;line-height:1.6;color:var(--muted)}
.confirmation{font-size:36rpx;font-weight:650;letter-spacing:4rpx;color:var(--brand-ink);margin:24rpx 0;overflow-wrap:anywhere}
.input{margin:14rpx 0}
.error{font-size:26rpx;line-height:1.6}
@media(max-width:360px){.hint{font-size:12px}}
@media(max-width:346px){.field-label,.error{font-size:12px}}

/* 邀请认领：核验编号是核心信息，状态与操作保留明确文字。 */
.title { font-size:var(--type-page); line-height:1.35; }
.section-title { font-size:var(--type-section); line-height:1.45; }
.field-label { font-size:var(--type-field); font-weight:400; color:var(--muted); }
.hint { font-size:var(--type-meta); line-height:1.6; }
.confirmation { font-size:44rpx; font-weight:600; font-variant-numeric:tabular-nums; letter-spacing:4rpx; padding:var(--space-2); background:var(--brand-soft); border-radius:16rpx; }
.claim-status { padding-left:var(--space-2); border-left:3px solid var(--line); }
.claim-status.is-waiting { border-color:var(--warning); }
.claim-status.is-approved { border-color:var(--success); }
.error { font-size:var(--type-field); overflow-wrap:anywhere; }

/* v3：凭证输入与申请结果分卡，核验编号独立可读。 */
.card { padding:32rpx; border-radius:30rpx; }
.confirmation { font-size:48rpx; line-height:1.5; text-align:center; padding:28rpx 20rpx; border:1px solid var(--line); border-radius:24rpx; }
.claim-status { font-size:32rpx; margin-bottom:20rpx; }
.card .hint { margin:20rpx 0; }

/* 对齐 V3 关闭态：明确能力状态，不展示尚不可用的操作引导。 */
.card.capability-disabled { padding:40rpx 28rpx 48rpx; text-align:center; background:linear-gradient(135deg,#fff,var(--canvas)); }
.capability-symbol { position:relative; display:flex; align-items:center; justify-content:center; width:120rpx; height:120rpx; margin:0 auto 32rpx; border:1px solid var(--line); border-radius:34rpx; background:linear-gradient(135deg,var(--brand-soft),#e4f2ff); color:var(--brand); box-sizing:border-box; }
.capability-title { font-size:var(--type-page); font-weight:700; line-height:1.4; color:var(--ink); overflow-wrap:anywhere; }
.capability-caption { margin:24rpx auto 0; max-width:540rpx; font-size:var(--type-body); line-height:1.7; color:var(--muted); overflow-wrap:anywhere; }
 .capability-claim::before { content:""; width:44rpx; height:32rpx; border:4rpx solid currentColor; border-radius:4rpx; }
.capability-claim::after { content:""; position:absolute; top:40rpx; width:26rpx; height:26rpx; border-right:3rpx solid currentColor; border-bottom:3rpx solid currentColor; transform:rotate(45deg); }

/* V3：已有申请结果优先，不移除原认领与恢复入口。 */
.claim-status-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; margin-bottom:24rpx; }
.claim-status-heading .section-title { margin:0; min-width:0; }
.claim-status-heading .claim-status { margin:0; padding:10rpx 16rpx; max-width:60%; border:0; border-radius:14rpx; font-size:var(--type-meta); line-height:1.5; background:var(--canvas); color:var(--muted); overflow-wrap:anywhere; }
.claim-status-heading .claim-status.is-waiting { background:var(--warning-soft); color:var(--warning); }
.claim-status-heading .claim-status.is-approved { background:var(--success-soft); color:var(--success); }

/* V3 设计逐页复核：仅展示层，保留条件、事件与禁用态。 */
.confirmation{background:transparent;border:0;border-radius:0;font-size:60rpx;font-weight:700;letter-spacing:8rpx;padding:36rpx 0;overflow-wrap:anywhere}
.claim-status-heading .section-title{border-left:0;padding-left:0}
.page button.ui-button.ui-block:not(.primary):not([disabled]){background:var(--surface);border-color:var(--control-border);color:var(--brand-ink)}
