.preview{width:100%;height:600rpx;background:#fff;border-radius:20rpx}.export-canvas{position:fixed;left:-10000px;top:0;width:826px;height:1330px;pointer-events:none}.actions button{margin-top:18rpx}.hint{margin:16rpx 0}
.export-options{display:flex;flex-direction:column;align-items:stretch;gap:18rpx;min-width:0}
.export-buttons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;width:100%;min-width:0}
.export-buttons button{box-sizing:border-box;width:100%;min-width:0;margin:0;padding:22rpx 12rpx}

/* Page-specific density, hierarchy and long-content safeguards. */
.title{font-size:32rpx;line-height:1.4;overflow-wrap:anywhere}.export-options{gap:16rpx}.export-buttons{gap:12rpx}.export-buttons button{font-size:25rpx;line-height:1.45;padding:18rpx 10rpx}.preview{border:1rpx solid var(--line);border-radius:18rpx;background:var(--canvas)}.hint{font-size:24rpx;line-height:1.65}.export-options .row{gap:12rpx}
