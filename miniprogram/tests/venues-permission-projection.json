    "changes": [
      {
        "before": "Page({onHide(){ui.abort(this);},",
        "after": "Page({onHide(){ui.abort(this);this._hidden=true;this.setData({admin:false,venues:[]});return s.hide.apply(this,arguments);},"
      },
      {
        "before": "error: \"\", venues: [], search: \"\"",
        "after": "error: \"\", venues: [], search: \"\", admin: false"
      },
      {
        "before": "  onShow() {\n    this.refresh();",
        "after": "  onShow() {\n    this._hidden = false;\n    return this.refresh();"
      },
      {
        "before": "  refresh() {\n    return s.load",
        "after": "  refresh() {\n    const owner = s.api.getSession()?.token;\n    this._venueOwner = owner;\n    this.setData({admin:false});\n    return s.load"
      },
      {
        "before": "      if (session.user.role !== \"admin\")",
        "after": "      if (!owner || owner !== s.api.getSession()?.token) return {};\n      if (session.user.role !== \"admin\")"
      },
      {
        "before": "return { venues: await s.api.request(\"/venues\") };",
        "after": "return { venues: await s.api.request(\"/venues\"), admin: true };"
