/* 本页文字层级；不改变输入、按钮、列数或画布几何。 */
.page>.between {
  gap: 20rpx;
  align-items: center;
}
.page>.between>view {
  min-width: 0;
  flex: 1;
}
.page>.between button {
  width: auto;
  flex-shrink: 0;
  margin: 0;
}
.card .between {
  gap: 16rpx;
}
.card .grow {
  min-width: 0;
}
.card .tag {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 500;
}
.card .score {
  font-size: 40rpx;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
}
.card .link {
  font-size: 25rpx;
  text-align: right;
  flex-shrink: 0;
}
.section-title {
  font-size: var(--type-field);
  font-weight: 500;

  color: var(--muted);
}
.card .muted {
  line-height: 1.6;
  overflow-wrap: anywhere;
  font-size: var(--type-field);
}
.page>.between>button.ui-button[size="mini"]{flex:0 0 auto;width:auto;min-width:148rpx;min-height:76rpx;padding:18rpx 22rpx;line-height:1.4;white-space:nowrap;align-self:center;}
.page>.between>.title,.page>.between>view {
  min-width: 0;
}
.page>.between .title {
  font-size: var(--type-page);
  font-weight: 650;
  line-height: 1.4;
}
.subtitle {
  font-size: 24rpx;
  line-height: 1.6;
}
.card .match-name {
  color: var(--ink);
  font-size: var(--type-card);
  font-weight: 600;
  line-height: 1.4;
}
.card .muted.match-time {
  font-size: var(--type-body);
  font-weight: 500;
  color: var(--ink);
}

/* 小屏正文下限 12px，仅覆盖以上内容文字，不影响控件。 */
@media (max-width: 375.000px) {
  .subtitle, .card .tag { font-size: 12px; }
}
@media (max-width: 360.000px) {
  .card .muted, .card .link { font-size: 12px; }
}
@media (max-width: 346.154px) {
  .section-title { font-size: 12px; }
}

.schedule-location{line-height:1.6;overflow-wrap:anywhere}.schedule-signup{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx;margin-top:16rpx}.schedule-counts{display:flex;flex:1;min-width:0;flex-wrap:wrap;gap:6rpx 18rpx;color:var(--muted);font-size:25rpx;line-height:1.6}.schedule-counts text{white-space:nowrap}.schedule-response{flex-shrink:0;color:var(--brand-ink);font-size:25rpx;line-height:1.6;white-space:nowrap}@media(max-width:360px){.schedule-counts,.schedule-response{font-size:12px}}

