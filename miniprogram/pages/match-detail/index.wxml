<view class="page"
  ><page-state id="page-state" skeleton-type="detail"
    loading="{{loading}}"
    error="{{error}}"
    bind:retry="refresh"
  /><view wx:if="{{replyPending}}" class="card"><view class="hint">{{busy?'正在提交报名…':reconciling?'正在核对上次报名，请稍候…':'上次报名结果待核对。'}}</view><button wx:if="{{!busy && !reconciling}}" id="reply-reconcile" class="ui-button ui-block" size="mini" bindtap="refresh">核对报名状态</button></view><block wx:if="{{!loading && !error && match}}"
    ><image wx:if="{{cover}}" class="match-cover" src="{{cover}}" mode="aspectFill" bindtap="media"/><view class="card match-hero"
      ><view class="between"
        ><text class="tag {{match.status}}">{{match.statusLabel}}</text
        ><text class="muted"
          >{{match.competition || '球队比赛'}}{{match.format?' · '+match.format+'人制':''}}</text
        ></view
      ><view class="teams"
        ><view>{{team.name}}</view
        ><text class="score"
          >{{match.status==='completed'?match.scoreLabel:'VS'}}</text
        ><view>{{match.opponent}}</view></view
      ><view class="muted"
        >{{match.side==='home'?'主场':match.side==='away'?'客场':match.side==='neutral'?'中立场':'主客场待定'}}</view
      ></view
    ><view class="card match-facts"
      ><view class="detail-line"
        ><text class="muted">比赛日期</text
        ><text>{{match.dateLabel}}</text></view
      ><view class="detail-line"
        ><text class="muted">开球时间</text
        ><text>{{match.kickoff || '待定'}}</text></view
      ><view class="detail-line"
        ><text class="muted">比赛地点</text
        ><text class="break">{{match.location || '待定'}}</text></view
      ></view
    ><view class="card venue-location-card"><view class="section-title">球场位置</view><view class="bold venue-location-title">{{venueLocation.title}}</view><view wx:if="{{venueLocation.address}}" class="muted venue-location-address">{{venueLocation.address}}</view><block wx:if="{{venueLocation.valid}}"><map id="match-venue-map" hidden="{{businessUiBlocking}}" class="match-venue-map" latitude="{{venueLocation.latitude}}" longitude="{{venueLocation.longitude}}" markers="{{venueLocation.markers}}" scale="16" show-location="{{false}}" aria-label="比赛球场位置"/><button id="match-open-location" size="mini" class="ui-button ui-block venue-location-open" disabled="{{loading}}" bindtap="openLocation">查看地图与导航</button><view class="venue-location-note">在微信地图中选择导航</view></block><view wx:else class="venue-location-empty">{{venueLocation.message}}</view></view><button disabled="{{loading}}" wx:if="{{admin}}" class="primary ui-button ui-block" bindtap="edit" size="mini">编辑比赛与比分</button><button disabled="{{loading}}" wx:if="{{admin}}" bindtap="rosterEdit" class="ui-button ui-block" size="mini">名单、出场与进球助攻</button><view wx:if="{{notice}}" class="card prewrap"><view class="bold">比赛须知</view>{{notice}}</view><button disabled="{{loading}}" bindtap="media" class="ui-button ui-block" size="mini">比赛须知与相册</button><view class="section"
      ><view class="section-title">报名情况</view
      ><view class="metrics"
        ><view class="metric"
          ><text class="number">{{match.yesCount}}</text
          ><text class="label">参加</text></view
        ><view class="metric"
          ><text class="number">{{match.noCount}}</text
          ><text class="label">请假</text></view
        ><view class="metric"
          ><text class="number">{{match.maybeCount}}</text
          ><text class="label">待定</text></view
        ></view
      ><view class="card" style="margin-top: 20rpx"
        ><view wx:for="{{replies}}" wx:key="playerId" class="detail-line"
          ><text>{{item.name}}</text
          ><text class="tag">{{item.label}}</text></view
        ><view wx:if="{{!replies.length}}" class="empty"
          >还没有报名回应</view
        ></view
      ></view
    ><view class="section"
      ><view class="section-title">比赛名单与实际表现</view
      ><view wx:for="{{roster}}" wx:key="playerId" class="card"
        ><view class="between"
          ><view class="bold roster-name">{{item.number}} · {{item.name}}</view
          ><text class="tag">{{item.selectionLabel}}</text></view
        ><view class="muted roster-meta"
          >{{item.position || '位置未记录'}} · {{item.appearedLabel}}</view
        ><view class="roster-stats" style="margin-top: 16rpx"
          >进球 {{item.goalsLabel}} · 助攻 {{item.assistsLabel}}</view
        ><text wx:if="{{item.snapshotSource==='migration'}}" class="muted"
          >身份资料为迁移时留存</text
        ></view
      ><view wx:if="{{!roster.length}}" class="card empty"
        >名单尚未录入</view
      ></view
    ><view class="section" wx:if="{{match.analysis}}"
      ><view class="section-title">赛后复盘</view
      ><view class="card prewrap">{{match.analysis}}</view></view
    ><view class="section" wx:if="{{snapshots.length}}"
      ><view class="section-title">战术留档</view
      ><view class="card"
        ><view aria-role="button" wx:for="{{snapshots}}" wx:key="id" class="detail-line" data-id="{{item.id}}" bindtap="tactic"
          ><text>{{item.name}}</text
          ><text class="muted">{{item.source}}</text></view
        ><view class="hint">点击战术查看原生画布及演示步骤。</view></view
      ></view
    ><view class="hint">报名不等于实际出场；“—”表示未记录。</view
    ><view wx:if="{{actionError}}" class="error">{{actionError}}</view
    ><view wx:if="{{canReply}}" class="bottom-space"></view
    ><view wx:if="{{canReply}}" class="fixed-actions"
      ><view class="between" style="margin-bottom: 14rpx"
        ><text class="bold">我的报名</text
        ><text class="muted">当前：{{match.responseLabel}}</text></view
      ><view class="actions"
        ><button
          class="{{match.response==='yes'?'primary':''}} ui-button"
          data-response="yes"
          bindtap="reply"
          disabled="{{loading || (busy)}}"
         size="mini">参加</button><button
          class="{{match.response==='maybe'?'primary':''}} ui-button"
          data-response="maybe"
          bindtap="reply"
          disabled="{{loading || (busy)}}"
         size="mini">待定</button><button
          class="{{match.response==='no'?'primary':''}} ui-button"
          data-response="no"
          bindtap="reply"
          disabled="{{loading || (busy)}}"
         size="mini">请假</button></view
      ></view
    ></block
  ></view
>

<business-dialog id="business-dialog"/>
