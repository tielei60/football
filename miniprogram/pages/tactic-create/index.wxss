.title {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.hint {
  font-size: 24rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.feedback {
  color: var(--brand-ink);
  margin-top: 20rpx;
}
button.ui-block {
  width: 100%;
  min-width: 0;
  min-height: 44px;
  white-space: normal;
  box-sizing: border-box;
}
@media (max-width: 375px) {
  .hint {
    font-size: 12px;
  }
}

/* 深度视觉层级：保留既有专注与操作几何。 */
.title{font-size:var(--type-page,38rpx);font-weight:600;line-height:1.35}
.field-label{font-size:var(--type-field,26rpx);font-weight:400;color:var(--muted);line-height:1.55}
.hint{font-size:var(--type-meta,24rpx);line-height:1.65}
.feedback{font-size:var(--type-field,26rpx);font-weight:500;color:var(--warning,#805600)}
.feedback-error{color:var(--danger)}
@media(max-width:375px){.hint{font-size:12px}.feedback{font-size:var(--type-field,26rpx)}}
@media(max-width:346px){.feedback{font-size:12px}}
