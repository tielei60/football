<view class="page"><page-state id="page-state" skeleton-type="cards" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error}}"><view class="section-title">比赛须知</view><view class="card"><textarea wx:if="{{admin}}" class="input notice" value="{{notice}}" data-field="notice" bindinput="input" maxlength="10000" disabled="{{loading || (busy||uncertain)}}" placeholder="集合要求、装备提醒、比赛注意事项…"/><text wx:else class="prewrap">{{notice||'暂无须知'}}</text><button wx:if="{{admin}}" class="primary ui-button ui-block" bindtap="saveNotice" disabled="{{loading || (busy||conflict||uncertain)}}" size="mini">保存须知</button></view><view class="section-title">比赛相册 · {{admin?photos.length+' / 9':photos.length+' 张'}}</view><view class="hint">{{admin?'仅上传有权分享的照片。每张最多 2 MB。':(photos.length?'点击照片查看大图。':'')}}</view><view wx:for="{{photos}}" wx:key="id" class="card"><image wx:if="{{item.src}}" class="photo" mode="aspectFill" src="{{item.src}}" data-id="{{item.id}}" bindtap="previewPhoto" binderror="photoError"/><view wx:else class="empty"><text>{{item.imageError||'照片加载中'}}</text><button wx:if="{{item.imageError}}" data-id="{{item.id}}" bindtap="retryPhoto" disabled="{{item.loading}}" class="ui-button ui-block" size="mini">重试照片</button></view><view class="between"><text class="photo-caption">{{item.caption||'比赛照片'}}</text><text wx:if="{{coverPhotoId===item.id}}" class="tag">封面</text></view><view wx:if="{{admin}}" class="actions"><button data-id="{{item.id}}" bindtap="cover" disabled="{{loading || (busy||conflict||uncertain||coverPhotoId===item.id)}}" class="ui-button" size="mini">设为封面</button><button class="danger ui-button" data-id="{{item.id}}" bindtap="remove" disabled="{{loading || (busy||conflict||uncertain)}}" size="mini">移除</button></view></view><view wx:if="{{!photos.length}}" class="card empty">还没有比赛照片</view><view wx:if="{{admin&&(photos.length<9||uncertain)}}" class="card"><image wx:if="{{preview}}" class="photo" src="{{preview}}" mode="aspectFit"/><button id="choose-photo" bindtap="choose" disabled="{{loading || (busy||uncertain)}}" class="ui-button ui-block" size="mini">选择照片</button><input class="input" value="{{caption}}" data-field="caption" bindinput="input" maxlength="200" disabled="{{loading || (busy||uncertain)}}" placeholder="照片说明（可选）"/><view wx:if="{{uncertain}}" class="hint upload-uncertain">上次上传结果未确认，可安全重试同一张照片。</view><button class="primary ui-button ui-block" id="upload-photo" bindtap="upload" loading="{{busy}}" disabled="{{loading || (!preview||busy||conflict)}}" size="mini">{{uncertain?'核对并重试上传':'上传照片'}}</button></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><button wx:if="{{admin}}" bindtap="reload" disabled="{{loading || (busy)}}" class="ui-button ui-block" size="mini">重新载入</button></block></view>

<business-dialog id="business-dialog"/>
