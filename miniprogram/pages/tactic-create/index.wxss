.field { margin-bottom: 28rpx; }
.field-label { font-size: 26rpx; color: var(--muted); margin-bottom: 12rpx; line-height: 1.55; }
.hint { font-size: 24rpx; line-height: 1.7; overflow-wrap: anywhere; }
.feedback { color: var(--warning); background: var(--warning-soft); border-radius: 18rpx; padding: 20rpx; margin-top: 20rpx; }
.feedback-error { color: var(--danger); background: var(--danger-soft); }
button.ui-block { width: 100%; min-width: 0; min-height: 44px; white-space: normal; box-sizing: border-box; }

.formation-info{padding:24rpx;background:#e8f5ff;border:1px solid #cde6fb;border-radius:22rpx;color:#305e70;margin:24rpx 0}

/* V3 设计逐页复核：仅展示层，保留条件、事件与禁用态。 */
.field{margin-bottom:32rpx}.field-label{font-weight:600}
