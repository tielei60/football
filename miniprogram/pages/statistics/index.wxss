/* 本页文字层级；不改变输入、按钮、列数或画布几何。 */
.rank-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eee8f1;
  gap: 18rpx;
}
.rank-row:last-child {
  border: 0;
}
.rank {
  width: 34rpx;
  color: var(--muted);
  font-weight: 500;
  min-width: 56rpx;
  font-size: 26rpx;
}
.rank-value {
  font-size: 38rpx;
  font-weight: 650;
  color: var(--brand-ink);
  font-variant-numeric: tabular-nums;
}
.score-summary {
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 25rpx;
}
.score-summary > text {
  white-space: nowrap;
}
.metrics {
  gap: 12rpx;
}
.metric .number {
  font-size: 38rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
}
.rank-row .grow {
  min-width: 0;
}
.rank-row .bold {
  overflow-wrap: anywhere;
}
.rank-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
}
.ranking-header, .ranking-values {
  display: flex;
  align-items: center;
}
.ranking-header {
  padding: 0 0 10rpx;
  color: var(--muted);
  font-size: var(--type-meta);
}
.ranking-header-name { flex: 1; }
.ranking-header > text:not(.ranking-header-name), .ranking-values > text {
  width: 62rpx;
  flex-shrink: 0;
  text-align: center;
  font-variant-numeric: tabular-nums;
}
.ranking-values { color: var(--brand-ink); font-size: 28rpx; font-weight: 600; }
.card>.bold {
  overflow-wrap: anywhere;
  line-height: 1.5;
  word-break: break-word;
}
.filter-row .picker {
  white-space: normal;
  line-height: 1.45;
}
.card .between {
  gap: 16rpx;
}
.card .between>.muted {
  min-width: 0;
  overflow-wrap: anywhere;
}
.card .between>text:last-child {
  flex-shrink: 0;
}
.rank,.rank-value {
  flex-shrink: 0;
  white-space: nowrap;
}
.score-summary>text {
  white-space: normal;
  overflow-wrap: anywhere;
  min-width: 0;
}
.page>.title {
  font-size: var(--type-page);
  font-weight: 650;
  line-height: 1.4;
}
.subtitle {
  font-size: 24rpx;
  line-height: 1.6;
}
.scope-title, .opponent-name, .rank-row .bold {
  font-size: var(--type-card);
  font-weight: 600;
  line-height: 1.4;
}
.metric .label {
  font-size: 25rpx;
}
.card .muted, .hint {
  font-size: var(--type-field);
  line-height: 1.6;
}
.section-title {
  font-size: var(--type-section);
  font-weight: 600;
}
.tag {
  font-size: 24rpx;
  font-weight: 500;
}

/* 小屏正文下限 12px，仅覆盖以上内容文字，不影响控件。 */
@media (max-width: 375.000px) {
  .subtitle, .tag { font-size: 12px; }
}
@media (max-width: 360.000px) {
  .metric .label, .card .muted, .hint, .score-summary { font-size: 12px; }
}
@media (max-width: 346.154px) {
  .rank { font-size: 12px; }
}
@media (max-width: 321.429px) {
  .section-title { font-size: var(--type-section); }
}

/* V3：俱乐部品牌与内容分层，数据及操作由原页面维护。 */
.statistics-page{padding-top:28rpx}.statistics-banner{position:relative;overflow:hidden;margin:-28rpx -28rpx 0;padding:34rpx 34rpx 68rpx;background:linear-gradient(110deg,#5e0a72,#963bae);color:#fff}.statistics-banner:after{content:"";position:absolute;width:250rpx;height:250rpx;border:3rpx solid #c990d74d;right:-65rpx;top:20rpx;border-radius:50%;pointer-events:none}.statistics-eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#c5e6ff}.statistics-banner .title{font-size:44rpx;color:#fff;margin-top:12rpx}.statistics-banner .subtitle{color:#efddf8;font-size:24rpx;margin-top:10rpx}.record-card{position:relative;margin-top:-32rpx;border:1rpx solid #e1cff1;border-radius:34rpx;background:linear-gradient(135deg,#fff,#faf5ff 65%,#eceaff);box-shadow:0 10rpx 24rpx #71258318;padding:32rpx}.record-card .metric{padding:24rpx 6rpx}.record-card .metric+.metric{border-left:1rpx solid #dfcfea}.record-card .number{font-size:68rpx;color:var(--brand);font-weight:750}.record-card .score-summary{padding-top:24rpx;border-top:1rpx solid #e2d5f1;color:#684e77}.record-coverage{font-size:24rpx;line-height:1.6;color:var(--muted);margin-top:16rpx}.stats-filter-section{margin:28rpx 0 36rpx}.filter-label{font-size:26rpx;font-weight:600;color:var(--muted);margin-bottom:10rpx}.ranking-card{border-radius:30rpx;border-color:#e4d5f1;box-shadow:0 6rpx 18rpx #6a00680c}.rank-row{min-height:136rpx;gap:14rpx}.rank{display:flex;align-items:center;justify-content:center;min-width:42rpx;width:42rpx;height:46rpx;border-radius:50%;background:#ece7f7;color:#654d75;font-weight:700}.rank-row:nth-child(2) .rank{background:linear-gradient(145deg,#fff0b0,#ebbd5a);color:#735119}.rank-avatar{width:70rpx;height:70rpx;border-radius:50%;border:3rpx solid white;box-shadow:0 0 0 1rpx #e4d2ee}.rank-row .bold{font-size:28rpx}.ranking-values>text,.ranking-header>text:not(.ranking-header-name){width:54rpx}.section-title{border-left:6rpx solid var(--brand);padding-left:14rpx}@media(max-width:350px){.rank-row{gap:10rpx}.rank-avatar{width:58rpx;height:58rpx}.ranking-values>text,.ranking-header>text:not(.ranking-header-name){width:46rpx}}

/* ZIP 04：队徽水印替换无语义圆环，范围标签各自对应选择器。 */
.statistics-banner:after { display:none; }
.statistics-watermark { position:absolute; right:-20rpx; top:24rpx; width:224rpx; height:224rpx; opacity:.12; pointer-events:none; }
.statistics-eyebrow,.statistics-banner .title,.statistics-banner .subtitle { position:relative; }

/* V3 原生核验：统计共用整卡，数字列只保留竖分隔，避免全局 metric 圆角卡污染。 */
.statistics-page .record-card .metrics{gap:0}
.statistics-page .record-card .metrics>.metric{background:transparent;border:0;border-radius:0;box-shadow:none}
.statistics-page .record-card .metrics>.metric+.metric{border-left:1rpx solid var(--line)}

/* 原生 320 宽复验：中文表头不竖排，与数据列共享宽度下限。 */
.statistics-page .ranking-header>text:not(.ranking-header-name),.statistics-page .ranking-values>text{min-width:30px;white-space:nowrap}
