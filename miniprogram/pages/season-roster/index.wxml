<view class="page"><page-state skeleton-type="list" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error}}"><view class="club-page-banner"><view class="club-eyebrow">BERLIN FC</view><view class="club-banner-title">赛季阵容</view><view class="club-banner-subtitle">保留赛季身份与号码</view><image class="club-banner-mark" src="/assets/team-badge.png" mode="aspectFit" aria-hidden="true"/></view><view class="heading"><view class="title">{{name}}</view><view class="hint">赛季阵容 · {{rows.length}} 人{{admin?'':' · 只读'}}</view></view><view wx:if="{{admin}}" class="card row picker-row"><business-picker title="添加赛季球员" bind:pickeropen="openBusinessPicker" wx:if="{{candidates.length}}" range="{{candidates}}" range-key="label" value="{{candidateIndex}}" bindchange="choose" disabled="{{loading || (busy||conflict)}}"><view class="picker"><text class="picker-value">{{candidates[candidateIndex].label}}</text></view></business-picker><text wx:else class="hint">没有更多队员可添加</text><button class="small ui-button ui-compact" bindtap="add" disabled="{{loading || (busy||conflict||!candidates.length)}}" size="mini">添加</button></view><view wx:if="{{!rows.length}}" class="empty">本赛季暂未设置阵容</view><view wx:else class="card roster-card {{admin?'':'roster-readonly'}}"><view class="member" wx:for="{{rows}}" wx:key="playerId"><view class="row"><view class="grow"><view class="member-name">{{item.name}}</view><view class="hint member-meta">{{item.positions||'位置未设置'}}{{item.status==='inactive'?' · 已归档':''}}</view><view wx:if="{{item.historical}}" class="hint">赛季留存资料</view></view><view wx:if="{{admin}}" class="number"><text class="hint">赛季号码</text><input class="input" type="number" maxlength="4" value="{{item.number}}" placeholder="未知" data-id="{{item.playerId}}" bindinput="number" disabled="{{loading || (busy||conflict)}}"/></view><text wx:else class="read-number">{{item.number===''?'—':item.number}}</text><button wx:if="{{admin}}" class="small ghost ui-button ui-compact" data-id="{{item.playerId}}" bindtap="remove" disabled="{{loading || (busy||conflict)}}" size="mini">移出</button></view></view></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><button disabled="{{loading}}" wx:if="{{conflict}}" bindtap="reload" class="ui-button ui-block" size="mini">重新载入</button><view wx:if="{{admin}}" class="footer"><view class="hint">保存不改变球员当前资料或历史比赛快照。</view><button class="primary ui-button ui-block" bindtap="save" loading="{{busy}}" disabled="{{loading || (busy||conflict)}}" size="mini">保存赛季阵容</button></view></block></view>
<business-dialog id="business-dialog"/>
