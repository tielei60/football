<view class="page"><page-state skeleton-type="form" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error&&authorized}}"><view class="title admin-header">{{id?'编辑赛季':'新增赛季'}}</view><view class="card"><view class="field"><text class="field-label">赛季名称 *</text><input class="input" value="{{form.name}}" data-field="name" bindinput="input" maxlength="200" placeholder="例如：2026–2027 赛季" disabled="{{loading || (busy)}}"/></view><view class="field"><text class="field-label">开始日期 *</text><business-picker title="赛季开始日期" bind:pickeropen="openBusinessPicker" mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="date" disabled="{{loading || (busy)}}"><view class="picker"><text class="picker-value">{{form.startDate||'选择开始日期'}}</text></view></business-picker></view><view class="field"><text class="field-label">结束日期 *</text><business-picker title="赛季结束日期" bind:pickeropen="openBusinessPicker" mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="date" disabled="{{loading || (busy)}}"><view class="picker"><text class="picker-value">{{form.endDate||'选择结束日期'}}</text></view></business-picker></view><view class="hint">日期包含起止当天。已有比赛日期不能被排除在赛季之外。</view></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><button disabled="{{loading}}" wx:if="{{conflict}}" bindtap="reload" class="ui-button ui-block" size="mini">重新载入</button><button disabled="{{loading}}" wx:if="{{uncertain}}" bindtap="backToList" class="ui-button ui-block" size="mini">到赛季列表核对</button><button disabled="{{loading}}" wx:if="{{uncertain&&!id}}" bindtap="confirmNotCreated" class="ui-button ui-block" size="mini">已核对，确认未创建</button><button wx:if="{{id}}" bindtap="openRoster" disabled="{{loading || (busy)}}" class="ui-button ui-block" size="mini">管理赛季阵容</button><button class="primary ui-button ui-block" bindtap="save" disabled="{{loading || (busy||conflict||uncertain)}}" loading="{{busy}}" size="mini">保存赛季</button></block></view>
<business-dialog id="business-dialog"/>
