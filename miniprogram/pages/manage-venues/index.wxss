
/* Page-specific density, hierarchy and long-content safeguards. */
.page>.between{gap:16rpx;align-items:center}.page>.between .title{font-size:34rpx;min-width:0}.page>.between button{width:auto;flex-shrink:0;margin:0}.card .between{gap:16rpx}.card .bold{min-width:0;overflow-wrap:anywhere}.card .tag{flex-shrink:0}.card .muted{margin:10rpx 0;line-height:1.65;overflow-wrap:anywhere}.card .link{font-size:24rpx}

/* 管理文字层级：仅文字与组间留白，不改原生输入及业务布局。 */
.page>.between .title{font-size:34rpx;font-weight:650;color:var(--ink)}
.card .bold{font-size:30rpx;font-weight:600;line-height:1.4;color:var(--ink)}
.card .muted{font-size:26rpx;font-weight:400;line-height:1.6;color:var(--muted)}
.card .tag{font-size:24rpx;font-weight:500}
.card .link{font-size:25rpx;font-weight:500;color:var(--brand-ink)}
.subtitle{font-size:25rpx;line-height:1.6;color:var(--muted)}
@media(max-width:346px){.card .muted{font-size:12px}}
@media(max-width:360px){.card .link,.subtitle{font-size:12px}}
@media(max-width:375px){.card .tag{font-size:12px}}
