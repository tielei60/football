.heading{margin-bottom:24rpx}.member{padding:24rpx;border-bottom:1rpx solid var(--line)}.member:last-child{border-bottom:0}.member-name{font-size:29rpx;font-weight:650}.number{width:140rpx;min-width:0}.number input{text-align:center}.member .grow{flex:1;min-width:0}.member button{margin:0;width:auto;min-width:0}.roster-card{padding:0;overflow:hidden}.picker-row business-picker{flex:1;min-width:0}.picker-row button{margin:0;width:auto}.member-meta{margin-top:8rpx}.footer{margin-top:24rpx}.read-number{font-size:32rpx;font-weight:650;color:var(--brand)}
/* Page-specific density, hierarchy and long-content safeguards. */
.heading{margin-bottom:22rpx}.member{padding:24rpx 22rpx}.member-name{font-size:28rpx;line-height:1.4;overflow-wrap:anywhere}.member-meta{font-size:24rpx;line-height:1.55}.member .row{gap:14rpx}.member button.small{padding:14rpx 16rpx;font-size:24rpx}.number{width:120rpx;flex-shrink:0}.number input{padding:0 8rpx;font-variant-numeric:tabular-nums}.picker-row{gap:14rpx}.footer .hint{line-height:1.65}

.member .row{flex-wrap:wrap}.member .row .grow{min-width:180rpx}.member button.ui-button[size="mini"]{white-space:nowrap}

/* 管理文字层级：仅文字与组间留白，不改原生输入及业务布局。 */
.heading .title{font-size:34rpx;font-weight:650;color:var(--ink)}
.member-name{font-size:29rpx;font-weight:600;line-height:1.4;color:var(--ink)}
.member-meta{font-size:24rpx;font-weight:400;line-height:1.6;margin-top:6rpx;color:var(--muted)}
.member .grow>.hint{font-size:24rpx;font-weight:400;line-height:1.6;margin-top:6rpx}
.read-number{font-size:32rpx;font-weight:600;color:var(--brand-ink)}
.roster-readonly .member{padding-top:22rpx;padding-bottom:22rpx}
.heading>.hint,.footer .hint{font-size:25rpx;line-height:1.65;color:var(--muted)}
@media(max-width:375px){.member-meta,.member .grow>.hint{font-size:12px}}
@media(max-width:360px){.heading>.hint,.footer .hint{font-size:12px}}

/* 赛季阵容：姓名优先，号码与历史资料说明分层，编辑与只读同一节奏。 */
.heading { margin-bottom:var(--space-3); }
.heading .title { font-size:var(--type-page); line-height:1.35; overflow-wrap:anywhere; }
.heading>.hint { font-size:var(--type-field); margin-top:var(--space-1); }
.member { padding:var(--space-3); }
.member-name { font-size:var(--type-card); font-weight:600; }
.member-meta,.member .grow>.hint,.number>.hint,.footer .hint { font-size:var(--type-meta); line-height:1.6; }
.member .row,.picker-row { gap:var(--space-2); }
.member .row .grow { min-width:160rpx; }
.read-number { font-size:36rpx; font-weight:600; }
.member button.ghost { color:var(--danger); }
.footer { margin-top:var(--space-4); }

.roster-card {border-radius:30rpx;}
.member {padding:28rpx 30rpx;}
.heading .title {font-size:32rpx;color:var(--brand-ink);}
.read-number {font-size:44rpx;}

/* V3 管理表单：持久标签与实际命中区，不改输入事件。 */
.page .picker-row button.ui-button.ui-compact[size="mini"],.page .member button.ui-button.ui-compact[size="mini"]{min-height:44px;min-width:44px;box-sizing:border-box}
.picker-row{flex-wrap:wrap}.picker-row .candidate-label{flex:0 0 100%;margin-bottom:0}
