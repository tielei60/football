<view class="page"><page-state skeleton-type="form" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error&&authorized}}"><view class="club-page-banner"><view class="club-eyebrow">BERLIN FC</view><view class="club-banner-title">{{id?'编辑赛季':'新增赛季'}}</view><view class="club-banner-subtitle">自定义时间周期，保留历史阵容</view><image class="club-banner-mark" src="/assets/team-badge.png" mode="aspectFit" aria-hidden="true"/></view><view class="card"><view class="field"><text class="field-label">赛季名称 *</text><input class="input" value="{{form.name}}" data-field="name" bindinput="input" maxlength="200" placeholder="例如：2026–2027 赛季" disabled="{{loading || (busy)}}"/></view><view class="field"><text class="field-label">开始日期 *</text><business-picker title="赛季开始日期" bind:pickeropen="openBusinessPicker" mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="date" disabled="{{loading || (busy)}}"><view class="picker"><text class="picker-value">{{form.startDate||'选择开始日期'}}</text></view></business-picker></view><view class="field"><text class="field-label">结束日期 *</text><business-picker title="赛季结束日期" bind:pickeropen="openBusinessPicker" mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="date" disabled="{{loading || (busy)}}"><view class="picker"><text class="picker-value">{{form.endDate||'选择结束日期'}}</text></view></business-picker></view><view class="hint">日期包含起止当天。已有比赛日期不能被排除在赛季之外。</view></view><view class="card season-media"><view class="section-title">赛季图像（选填）</view>
<view class="season-media-row"><image wx:if="{{iconPreview}}" class="season-icon-preview" src="{{iconPreview}}" mode="aspectFit"/><view class="season-media-copy"><text class="field-label">赛季图标</text><button class="ui-button" size="mini" data-asset="icon" bindtap="chooseAsset" disabled="{{busy||conflict||uncertain}}">{{iconPreview?'替换图标':'选择图标'}}</button><button wx:if="{{iconPreview}}" class="ghost ui-button" size="mini" data-asset="icon" bindtap="clearAsset" disabled="{{busy||conflict||uncertain}}">移除</button></view></view>
<view class="season-media-row"><image wx:if="{{imagePreview}}" class="season-image-preview" src="{{imagePreview}}" mode="aspectFill"/><view class="season-media-copy"><text class="field-label">赛季图片</text><button class="ui-button" size="mini" data-asset="image" bindtap="chooseAsset" disabled="{{busy||conflict||uncertain}}">{{imagePreview?'替换图片':'选择图片'}}</button><button wx:if="{{imagePreview}}" class="ghost ui-button" size="mini" data-asset="image" bindtap="clearAsset" disabled="{{busy||conflict||uncertain}}">移除</button></view></view>
<view class="hint">PNG 或 JPG，每张最多 2 MB；也可以全部留空。</view></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><button disabled="{{loading}}" wx:if="{{conflict}}" bindtap="reload" class="ui-button ui-block" size="mini">重新载入</button><button disabled="{{loading}}" wx:if="{{uncertain}}" bindtap="backToList" class="ui-button ui-block" size="mini">到赛季列表核对</button><button disabled="{{loading || busy}}" wx:if="{{uncertain&&!id}}" bindtap="confirmCreated" class="ui-button ui-block" size="mini">已核对，记录已存在</button><button disabled="{{loading}}" wx:if="{{uncertain&&!id}}" bindtap="confirmNotCreated" class="ui-button ui-block" size="mini">已核对，确认未创建</button><button wx:if="{{id}}" bindtap="openRoster" disabled="{{loading || (busy)}}" class="ui-button ui-block season-roster-entry" size="mini"><image src="/assets/ui-v3-people.png" mode="aspectFit" aria-hidden="true"/><text>管理赛季阵容</text><text class="entry-chevron" aria-hidden="true">›</text></button><button class="primary ui-button ui-block" bindtap="save" disabled="{{loading || (busy||conflict||uncertain)}}" loading="{{busy}}" size="mini">保存赛季</button></block></view>
<business-dialog id="business-dialog"/>
