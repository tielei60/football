.roster-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20rpx; margin-top: 18rpx; }
.row { gap: 18rpx; }
.roster-grid input { width: 100%; }

/* Page-specific density, hierarchy and long-content safeguards. */
.title{font-size:34rpx}.roster-grid{gap:16rpx}.roster-grid>view{min-width:0}.field-label{font-size:23rpx;line-height:1.5}.card .between{gap:16rpx;align-items:flex-start}.card .bold{min-width:0;overflow-wrap:anywhere}.card .between button{width:auto;flex-shrink:0;margin:0}.card.row{gap:14rpx}.card.row button{width:auto;flex-shrink:0;margin:0}.picker{font-size:25rpx;line-height:1.5;white-space:normal}.hint{font-size:23rpx;line-height:1.65}
