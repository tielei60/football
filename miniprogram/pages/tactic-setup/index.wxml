<view class="page {{previewFocus?'preview-focus':''}}"><page-state skeleton-type="form" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error}}">
<button id="setup-focus" class="small preview-toggle" bindtap="togglePreview" disabled="{{busy}}">{{previewFocus?'返回阵容设置':'放大查看球场'}}</button><block wx:if="{{!previewFocus}}"><view class="title">战术信息</view><view class="card"><label>名称<input disabled="{{loading}}" id="setup-title" maxlength="300" value="{{title}}" data-key="title" bindinput="input"/></label><label>标签（每行一个）<textarea disabled="{{loading}}" id="setup-tags" maxlength="10100" value="{{tagsText}}" data-key="tagsText" bindinput="input" auto-height/></label><view class="row"><label>收藏 <switch id="setup-favorite" checked="{{favorite}}" data-key="favorite" bindchange="input"/></label><button id="metadata-save" class="small" bindtap="saveMetadata" disabled="{{loading || (busy||conflict)}}">保存信息</button></view></view>
<view class="title section">阵型与双方阵容</view><view class="row"><business-picker title="比赛制式" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" id="setup-count" class="grow" range="{{counts}}" value="{{countIndex}}" data-key="countIndex" bindchange="select"><view class="picker"><text class="picker-value">{{counts[countIndex]}} 人制</text></view></business-picker><business-picker title="阵容归属" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" id="setup-team" class="grow" range="{{teams}}" value="{{teamIndex}}" data-key="teamIndex" bindchange="select"><view class="picker"><text class="picker-value">{{teams[teamIndex]}}</text></view></business-picker></view>
<business-picker title="阵型方案" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" id="setup-formation" range="{{formations}}" range-key="label" value="{{formationIndex}}" data-key="formationIndex" bindchange="select"><view class="picker"><text class="picker-value">{{formations[formationIndex].label||'暂无阵型'}}</text></view></business-picker>
<view class="hint">{{crossFormat && otherCount?'切换人数会同时调整双方阵容：另一方优先保留现有人选，缺员补匿名球员，确认时显示增减人数。':'只改变所选方，另一方不自动增减。'}}{{hasAnimation?'已有演示保持旧参与者与阶段，不会自动同步新阵容。':''}}</view>
<view class="roster"><view wx:for="{{slots}}" wx:key="index" class="slot"><text>{{index+1}} · {{item.role}}</text><business-picker title="槽位球员" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" id="setup-slot-{{index}}" class="grow" range="{{options}}" value="{{item.optionIndex}}" data-index="{{index}}" bindchange="slot"><view class="picker"><text class="picker-value">{{item.label}}</text></view></business-picker></view></view>
<view class="hint">同一球员只能占一个位置。新匿名球员可在“阶段与属性”中改名；主队也可直接选择球队球员。</view>
<button id="formation-apply" class="primary" bindtap="applyFormation" disabled="{{loading || (busy||conflict||!slots.length)}}">{{busy?'保存中…':'应用所选方阵型与阵容'}}</button>
<view wx:if="{{actionError}}" class="error">{{actionError}}</view><button disabled="{{loading}}" wx:if="{{conflict}}" id="setup-reload" bindtap="reload">核对后重新载入</button>
</block><view class="preview"><canvas hidden="{{businessUiBlocking}}" id="setup-preview" type="2d" style="width:{{previewWidth}}px;height:{{previewHeight}}px"/></view><view wx:if="{{renderError}}" class="error">{{renderError}}</view><view class="hint">预览为初始画布。保存不会修改历史比赛的战术快照。</view>
</block></view>

<business-dialog id="business-dialog"/>
