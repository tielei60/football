/* 本页文字层级；不改变输入、按钮、列数或画布几何。 */
.card .between {
  gap: 16rpx;
}
.card .grow {
  min-width: 0;
}
.card .tag {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 500;
}
.card .score {
  font-size: 40rpx;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
}
.card .link {
  font-size: 25rpx;
  text-align: right;
  flex-shrink: 0;
}
.section-title {
  font-size: var(--type-field);
  font-weight: 500;

  color: var(--muted);
}
.card .muted {
  line-height: 1.6;
  overflow-wrap: anywhere;
  font-size: var(--type-field);
}
.subtitle {
  font-size: 24rpx;
  line-height: 1.6;
}
.card .match-name {
  color: var(--ink);
  font-size: var(--type-card);
  font-weight: 600;
  line-height: 1.4;
}
.card .muted.match-time {
  font-size: var(--type-body);
  font-weight: 500;
  color: var(--ink);
}

/* 小屏正文下限 12px，仅覆盖以上内容文字，不影响控件。 */
@media (max-width: 375.000px) {
  .subtitle, .card .tag { font-size: 12px; }
}
@media (max-width: 360.000px) {
  .card .muted, .card .link { font-size: 12px; }
}
@media (max-width: 346.154px) {
  .section-title { font-size: 12px; }
}

.schedule-location{line-height:1.6;overflow-wrap:anywhere}.schedule-signup{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx;margin-top:16rpx}.schedule-counts{display:flex;flex:1;min-width:0;flex-wrap:wrap;gap:6rpx 18rpx;color:var(--muted);font-size:25rpx;line-height:1.6}.schedule-counts text{white-space:nowrap}.schedule-response{flex-shrink:0;color:var(--brand-ink);font-size:25rpx;line-height:1.6;white-space:nowrap}@media(max-width:360px){.schedule-counts,.schedule-response{font-size:12px}}

/* V3：俱乐部品牌与内容分层，数据及操作由原页面维护。 */
.fixture-focus{position:relative;overflow:hidden;border-radius:32rpx;margin-top:28rpx;margin-bottom:30rpx;background:#590c6b;color:#fff;border:1rpx solid #c6a4d8;box-shadow:0 10rpx 26rpx #55126929}.focus-image,.focus-shade{position:absolute;inset:0;width:100%;height:100%}.focus-shade{background:linear-gradient(110deg,#4e085ff0,#6d1a82c9)}.focus-content{position:relative;padding:28rpx 32rpx}.focus-context{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10rpx;font-size:24rpx;color:#f1def9}.focus-label{padding:6rpx 12rpx;border-radius:10rpx;background:#f0dff9;color:#6c1b7d;font-weight:600}.focus-teams{display:flex;gap:20rpx;align-items:center;margin:30rpx 0 24rpx}.focus-teams>view{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:12rpx;text-align:center;font-size:28rpx;font-weight:600;overflow-wrap:anywhere}.focus-teams image,.focus-fallback{width:100rpx;height:108rpx}.focus-fallback{display:flex;align-items:center;justify-content:center;background:#e2f4ff;color:#39677e;border-radius:12rpx 12rpx 30rpx 30rpx;font-size:36rpx}.focus-vs{font-size:60rpx;font-weight:800;font-style:italic;flex:none}.focus-meta{text-align:center;font-size:26rpx;margin-top:6rpx;overflow-wrap:anywhere}.focus-link{padding:22rpx 16rpx;min-height:88rpx;margin:24rpx auto 0;border:1rpx solid #deb8f6;border-radius:44rpx;background:linear-gradient(110deg,#b442d1,#780987);text-align:center;font-size:28rpx;font-weight:600}.date-ticket{width:96rpx;flex:none;border-radius:20rpx;background:linear-gradient(145deg,#f2e6ff,#ede7fd);padding:14rpx 8rpx;text-align:center;color:var(--brand)}.date-ticket text{display:block;font-size:24rpx}.date-ticket text:first-child{font-size:52rpx;line-height:1.2;font-weight:750}.card{border-radius:28rpx;border-color:#e2d3f1;box-shadow:0 7rpx 18rpx #70218512}.page>.section-title{font-size:28rpx;font-weight:600;color:var(--brand-ink);margin-top:32rpx}.fixture-main{align-items:center}.card .score{font-size:44rpx}.card .match-name{font-size:30rpx}

.opponent-ball{position:relative;width:44rpx;height:44rpx;border:3rpx solid #39677e;border-radius:50%}.opponent-ball:before{content:"";position:absolute;left:11rpx;top:11rpx;width:16rpx;height:16rpx;border:3rpx solid #39677e;border-radius:5rpx;transform:rotate(45deg)}

/* V3 赛程：待比赛展示焦点，历史/草稿展示品牌标题；管理入口保留管理员权限。 */
.schedule-page>.fixture-focus{margin-top:0}
.schedule-admin-action{margin:0 0 24rpx}
.page .schedule-admin-action button.schedule-create[size="mini"]{min-height:44px;width:100%;margin:0;background:var(--surface);color:var(--brand-ink);border:1rpx solid var(--control-border);box-shadow:none}
.fixture-main{display:flex;gap:20rpx;align-items:flex-start}
.fixture-details{flex:1;min-width:0}
.card .fixture-details .match-name{margin:0}
.fixture-competition{margin-top:8rpx}
.card .fixture-details .match-time{margin-top:8rpx;font-size:var(--type-field);font-weight:400;color:var(--muted);overflow-wrap:anywhere}
.fixture-status{display:flex;flex-direction:column;align-items:flex-end;gap:12rpx;flex:0 0 auto;max-width:34%}
.fixture-status .tag{white-space:normal;overflow-wrap:anywhere}
.card .fixture-status .score{white-space:normal;overflow-wrap:anywhere;text-align:right}
@media(max-width:350px){.fixture-main{gap:14rpx}.date-ticket{width:80rpx}.card .fixture-details .match-time{font-size:12px}}

/* ZIP 02：焦点信息图标、主客场与斜角装饰，保留整卡原点击入口。 */
.fixture-focus::after{content:"";position:absolute;right:0;bottom:0;width:36%;height:50rpx;background:#b49cdd;clip-path:polygon(100% 0,100% 100%,0 100%);pointer-events:none}
.focus-content{padding-bottom:40rpx}
.focus-teams>.focus-result{flex:0 0 auto;gap:8rpx}
.focus-side{font-size:24rpx;font-weight:400;color:#efddf8}
.focus-meta,.focus-link{display:flex;align-items:center;justify-content:center;gap:14rpx}
.focus-meta image,.focus-link image{width:28rpx;height:28rpx;flex:none;filter:brightness(0) invert(1)}
.focus-meta text,.focus-link text{min-width:0;overflow-wrap:anywhere}
.focus-link{max-width:84%;box-sizing:border-box}
.schedule-page .schedule-month{display:flex;align-items:center;gap:28rpx;border-left:0;padding-left:0;color:var(--brand-ink)}
.schedule-month::after{content:"";height:1rpx;flex:1;background:var(--line)}
.schedule-page .card .match-name{border-left:0;padding-left:0}
.match-time,.schedule-location{display:flex;align-items:center;gap:12rpx}
.match-time>text,.schedule-location>text{min-width:0;overflow-wrap:anywhere}
.schedule-location>image{width:26rpx;height:26rpx;flex:none}
.time-symbol{position:relative;width:22rpx;height:22rpx;border:2rpx solid var(--muted);border-radius:50%;flex:none;box-sizing:border-box}
.time-symbol::after{content:"";position:absolute;left:8rpx;top:4rpx;width:5rpx;height:7rpx;border-left:2rpx solid var(--muted);border-bottom:2rpx solid var(--muted)}

/* 状态 08/09：沿用全局品牌横幅与先创建、后筛选的阅读顺序。 */
.page .schedule-admin-action button.schedule-create[size="mini"]{display:flex;align-items:center;justify-content:center;gap:14rpx}
.schedule-create-plus{font-size:36rpx;font-weight:400;line-height:1}
