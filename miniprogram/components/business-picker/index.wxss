:host {
  display: block;
  min-width: 0;
}
.trigger {
  display: block;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent !important;
  color: inherit;
  text-align: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
}
.trigger::after {
  border: 0;
}
.trigger.control-disabled {
  opacity: 1;
  color: inherit;
}

.trigger{display:block;width:100%;min-width:0;max-width:100%;box-sizing:border-box;line-height:inherit;padding:0;margin:0}
.trigger:focus-visible{outline:3rpx solid var(--focus,#760b88);outline-offset:3rpx;border-radius:12rpx}

.trigger{width:100%;min-width:0;max-width:100%;padding:0;margin:0;border-radius:12rpx;overflow:visible;line-height:inherit;font-size:inherit;box-sizing:border-box}
.trigger.trigger-pressed{box-shadow:inset 0 0 0 2rpx #d7c4e1}
.trigger.control-disabled{opacity:1;color:var(--muted,#6e617a);background:var(--canvas,#f5f3ff)!important}

/* 边框仅由 slot 内的 picker 绘制；触发按钮不裁剪其圆角或焦点轮廓。 */

/* 微信隔离组件只使用类选择器；尺寸下限以 CSS px 计算。 */
.trigger{min-height:44px}
