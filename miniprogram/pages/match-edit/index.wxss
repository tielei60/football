/* UI v3：管理页共享视觉由 app.wxss 令牌与品牌横幅提供。 */
.admin-header { gap:16rpx; flex-wrap:wrap; margin:24rpx 0; }
.field-label { font-size:26rpx; font-weight:500; color:var(--muted); margin-bottom:12rpx; }
.hint,.subtitle { font-size:24rpx; line-height:1.65; color:var(--muted); }
.section-title { font-size:32rpx; font-weight:650; line-height:1.4; }
.card { padding:34rpx; }
.error { overflow-wrap:anywhere; }
 .filter-row { align-items:flex-start; gap:24rpx; margin-bottom:32rpx; }
.filter-row>.grow { flex:1; min-width:0; }
.card .picker { white-space:normal; overflow-wrap:anywhere; }
.card .section-title { margin-bottom:28rpx; }
.card textarea { min-height:200rpx; }
.capacity-hint { margin-top:12rpx; font-size:24rpx; color:var(--muted); line-height:1.6; }
@media(max-width:340px) { .filter-row { flex-wrap:wrap; } .filter-row>.grow { flex-basis:240rpx; } }

/* 紧凑入口保留原视觉，显式覆盖全局 compact 的 rpx 最小触控尺寸。 */


/* 日期和时间保留完整信息，统一两行容量；清除仍为44px弱操作。 */
.date-time-row{align-items:stretch}
.date-time-row .picker{min-height:112rpx;min-height:max(56px,112rpx)}
.page button.ui-button.ui-compact.clear-kickoff[size="mini"]{min-height:44px;min-width:44px;box-sizing:border-box}
.page .card button.ui-button.ui-compact.clear-kickoff[size="mini"]{display:flex;justify-content:flex-start;width:auto;max-width:100%;margin:0 0 20rpx;padding:0 20rpx;background:transparent;border-color:transparent;box-shadow:none;color:var(--muted);font-weight:500;text-align:left}
.publication-note{margin:-12rpx 0 24rpx;line-height:1.65}
.page .card button.ui-button.ui-compact.clear-kickoff[size="mini"][disabled]{opacity:.5;box-shadow:none}

/* 保存冲突/结果未确认是待核对状态，恢复动作随提示归组；普通错误仍红。 */
.score-scope-note{margin-top:28rpx;line-height:1.65;color:var(--muted)}
.recovery-notice{padding:24rpx;border:1rpx solid #f1d9a3;border-radius:24rpx;background:var(--warning-soft);color:var(--warning);margin-top:24rpx}
.recovery-title{font-size:26rpx;font-weight:650;line-height:1.5;margin-bottom:12rpx}
.recovery-message{font-size:25rpx;line-height:1.65;overflow-wrap:anywhere}
.page .recovery-notice button.recovery-check[size="mini"]{background:var(--surface);border:1rpx solid var(--control-border);color:var(--brand-ink);box-shadow:none;min-height:44px;margin-top:16rpx}
.page .recovery-notice button.recovery-continue[size="mini"]{background:transparent;border-color:transparent;box-shadow:none;min-height:44px;margin-top:12rpx}
.page .recovery-notice button.ui-button[size="mini"][disabled]{background:var(--canvas);border-color:var(--line);color:var(--muted);opacity:.6;box-shadow:none}
