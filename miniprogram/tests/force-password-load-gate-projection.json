[
  {
    "ext": "js",
    "before": "if (!this.active(owner, turn) || this.data.busy || this.data.loading)",
    "after": "if (!this.active(owner, turn) || this.data.busy || this.data.loading || this.data.errorSource === \"load\")"
  },
  {
    "ext": "wxml",
    "before": "bindtap=\"submit\" disabled=\"{{busy}}\" loading=\"{{busy}}\"",
    "after": "bindtap=\"submit\" disabled=\"{{busy || loading || errorSource==='load'}}\" loading=\"{{busy}}\""
  }
]
