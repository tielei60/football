<view class="page"><view class="club-page-banner"><view class="club-eyebrow">BERLIN FC</view><view class="club-banner-title">球员管理</view><view class="club-banner-subtitle">球队管理</view><image class="club-banner-mark" src="/assets/team-badge.png" mode="aspectFit" aria-hidden="true"/></view><view class="admin-create-action"><button disabled="{{loading}}" wx:if="{{authorized}}" class="primary ui-button ui-block" bindtap="create" size="mini"><text class="create-symbol" aria-hidden="true">＋</text><text>新增球员</text></button></view><page-state skeleton-type="list" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{!loading&&!error&&authorized}}"><view class="player-search"><view class="search-symbol" aria-hidden="true"/><input disabled="{{loading}}" class="input" placeholder="搜索姓名或号码" value="{{search}}" bindinput="search"/></view><view class="tabs"><view aria-role="button" class="tab {{status==='active'?'active':''}}" data-status="active" bindtap="status">在队</view><view aria-role="button" class="tab {{status==='inactive'?'active':''}}" data-status="inactive" bindtap="status">已归档</view><view aria-role="button" class="tab {{status==='unconfirmed'?'active':''}}" data-status="unconfirmed" bindtap="status">待确认</view></view><view class="managed-player-list"><view aria-role="button" wx:for="{{visible}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="edit"><view class="avatar {{!item.avatar?'player-placeholder':''}}"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" data-target="list" data-index="{{index}}" data-id="{{item.id}}" data-src="{{item.avatar}}" data-epoch="{{imageEpoch}}" binderror="imageError"/><text wx:else>{{item.initial}}</text></view><view class="grow"><view class="bold"><text>{{item.name}}</text><view wx:if="{{item.membershipKind==='guest'}}" class="temporary-player-marker" aria-role="img" aria-label="临时球员"/><text class="player-number-note">{{item.numberDescription}}</text></view><view class="muted">{{item.positionLabel}}</view></view><text class="tag account-status {{item.hasAccount?'account-ready':'account-pending'}}">{{item.hasAccount?'已开通':'未开通'}}账号</text><text class="player-chevron" aria-hidden="true">›</text></view></view><view wx:if="{{!visible.length}}" class="empty"><view class="empty-title">{{searchHasText?'当前筛选下没有球员':status==='inactive'?'暂无已归档球员':status==='unconfirmed'?'暂无待确认球员':'暂无在队球员'}}</view><view wx:if="{{searchHasText}}" class="empty-hint">请尝试其他姓名或号码</view></view></block></view>
<business-dialog id="business-dialog"/>
