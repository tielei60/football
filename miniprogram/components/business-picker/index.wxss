:host {
  display: block;
  min-width: 0;
}
.trigger {
  display: block;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent !important;
  color: inherit;
  text-align: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
}
.trigger::after {
  border: 0;
}
.trigger[disabled] {
  opacity: 1;
  color: inherit;
}

button.trigger{display:block;width:100%;min-width:0;max-width:100%;box-sizing:border-box;line-height:inherit;padding:0;margin:0}
button.trigger:focus-visible{outline:3rpx solid var(--focus,#8845a0);outline-offset:3rpx;border-radius:16rpx}

button.trigger[size="mini"]{width:100%;min-width:0;max-width:100%;padding:0;margin:0;border-radius:16rpx;line-height:inherit;font-size:inherit;box-sizing:border-box}
button.trigger.trigger-pressed{box-shadow:inset 0 0 0 2rpx #d7c4e1}
button.trigger[disabled]{opacity:1;color:var(--muted,#716779);background:#f5f2f7!important}
