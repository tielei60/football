<view class="page"
  ><page-state id="page-state" skeleton-type="cards"
    loading="{{loading}}"
    error="{{error}}"
    bind:retry="refresh"
  /><block wx:if="{{!loading && !error}}"
    ><view class="hero"
      ><view class="row"
        ><view class="avatar large"
          ><image
            wx:if="{{team.crest}}"
            src="{{team.crest}}"
            data-target="team"
            binderror="imageError"
            mode="aspectFit"
          /><text wx:else>足</text></view
        ><view class="grow"
          ><view class="subtitle">{{roleLabel ? roleLabel + " · " : ""}}一起上场</view
          ><view class="title break">{{team.name}}</view></view
        ></view
      ><view wx:if="{{unconfirmedCount}}" class="hint">另有 {{unconfirmedCount}} 位成员状态未确认</view><view class="hero-metrics"
        ><view
          ><text class="hero-number">{{playerCount}}</text
          ><text>位在队队员</text></view
        ><view
          ><text class="hero-number">{{stats.team.matches}}</text
          ><text>本年完赛</text></view
        ><view
          ><text class="hero-number">{{stats.team.wins}}</text
          ><text>胜场</text></view
        ></view
      ></view
    ><view class="section"
      ><view class="between"
        ><view class="section-title">下一场，一起踢</view
        ><button class="ui-button home-schedule-link" size="mini" bindtap="schedule">全部赛程 ›</button></view
      ><view aria-role="button"
        wx:if="{{next}}"
        class="card next"
        data-id="{{next.id}}"
        bindtap="openMatch"
        ><view class="between"
          ><text class="tag">{{next.competition || '球队比赛'}}</text
          ><text class="muted"
            >{{next.format ? next.format + '人制' : '赛制待定'}}</text
          ></view
        ><view class="match-title">对阵 {{next.opponent}}</view
        ><view class="match-time">{{next.dateLabel}} · {{next.kickoff || '时间待定'}}</view
        ><view class="muted match-place">{{next.location || '地点待定'}}</view
        ><view class="divider"></view
        ><view class="between signup-summary"
          ><view class="signup-counts"><text class="signup-count-yes">参加 {{next.signupCountLabel}}</text><text class="signup-count-maybe">{{next.maybeCount}} 人待定</text><text class="signup-count-no">{{next.noCount}} 人请假</text></view
          ><text class="tag">{{next.responseLabel}}</text></view
        ></view
      ><view wx:else class="card empty">还没有即将开始的比赛</view></view
    ><view class="section"
      ><view class="section-title">最近赛果</view
      ><view aria-role="button"
        wx:for="{{recent}}"
        wx:key="id"
        class="card between"
        data-id="{{item.id}}"
        bindtap="openMatch"
        ><view class="grow"
          ><view class="bold break recent-name">{{item.opponent}}</view
          ><view class="muted">{{item.dateLabel}}</view></view
        ><view class="score">{{item.scoreLabel}}</view></view
      ><view wx:if="{{!recent.length}}" class="card empty"
        >赛后记录会出现在这里</view
      ></view
    ></block
  ></view
>

<business-dialog id="business-dialog"/>
