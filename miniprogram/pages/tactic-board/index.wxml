<view class="page {{editing||focusCanvas?'canvas-focus':'type-expanded'}}">
 <page-state id="page-state" skeleton-type="detail" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/>
 <block wx:if="{{!loading&&!error}}">
  <button wx:if="{{!editing}}" id="board-focus" class="focus-toggle" bindtap="toggleFocus" disabled="{{busy}}">{{focusCanvas?'展开工具':'专注球场'}}</button><block wx:if="{{!editing&&!focusCanvas}}"><view class="title">{{title}}</view><view class="muted tactic-meta">{{format}} 人制 · {{formation}}</view><view class="tag">{{editing?'当前模板 · 战术编辑中':source}}</view>
  <view class="row section"><business-picker title="查看阶段" bind:pickeropen="openBusinessPicker" class="grow" range="{{stages}}" range-key="label" value="{{stageIndex}}" bindchange="selectStage" disabled="{{loading || (editing||busy)}}"><view class="picker"><text class="picker-value">{{stages[stageIndex].label}}</text></view></business-picker><button class="small" bindtap="zoom" disabled="{{loading || (editing||busy)}}">{{zoomed?'适应宽度':'放大'}}</button></view>
  </block><view wx:if="{{!editing && playDuration>0}}" class="row playback-controls"><button disabled="{{loading}}" class="small" id="playback-toggle" bindtap="togglePlayback">{{playing?'暂停':'播放演示'}}</button><slider class="grow" min="0" max="{{playDuration}}" step="0.1" value="{{playTime}}" bindchange="seekPlayback"/><text>{{playTime}} / {{playDuration}} 秒</text></view><view wx:if="{{playWarning}}" class="hint">{{playWarning}}</view>
  <view wx:if="{{canEdit}}" class="{{editing?'section':''}}"><block wx:if="{{editing}}"><view class="row edit-actions"><button class="edit-action" bindtap="cancelEdit" disabled="{{loading || (busy)}}">取消</button><button class="edit-action edit-save" id="save-positions" bindtap="save" disabled="{{loading || (busy||conflict)}}">{{busy?'保存中…':'保存战术'}}</button></view><view class="editor-tools"><business-picker title="画布工具" bind:pickeropen="openBusinessPicker" id="editor-tool" range="{{tools}}" value="{{toolIndex}}" bindchange="chooseTool" disabled="{{loading || (busy||conflict)}}"><view class="picker"><text class="picker-value">{{tools[toolIndex]}}</text></view></business-picker><button class="small" id="editor-undo" bindtap="undo" disabled="{{loading || (!canUndo||busy||conflict)}}">撤销</button><button class="small" id="editor-redo" bindtap="redo" disabled="{{loading || (!canRedo||busy||conflict)}}">重做</button><button class="small" id="editor-properties" bindtap="toggleProperties" disabled="{{loading || (busy||conflict)}}">属性</button></view>
<view wx:if="{{propertiesOpen}}" class="properties"><view class="row"><business-picker title="标注颜色" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" range="{{colors}}" value="{{colorIndex}}" data-key="colorIndex" bindchange="property"><view class="picker"><view class="picker-swatch" style="background:{{colors[colorIndex]}}"/><text class="picker-value">颜色</text></view></business-picker><business-picker title="线条宽度" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" range="{{widths}}" value="{{widthIndex}}" data-key="widthIndex" bindchange="property"><view class="picker"><text class="picker-value">线宽 {{widths[widthIndex]}}</text></view></business-picker><label>虚线<switch checked="{{dashed}}" data-key="dashed" bindchange="property"/></label></view><input disabled="{{loading}}" id="editor-label" maxlength="1000" value="{{label}}" data-key="label" bindinput="property" placeholder="文字标注内容"/><view wx:if="{{selectedMarking}}" class="row"><button class="small" id="editor-apply" bindtap="applyProperties" disabled="{{loading || (busy||conflict)}}">应用属性</button><button class="small" id="editor-delete" bindtap="deleteSelected" disabled="{{loading || (busy||conflict)}}">删除标注</button></view></view><view wx:if="{{historyTrimmed}}" class="hint">已释放较早撤销记录，当前修改仍保留。</view><view class="selection-status" wx:if="{{selected}}">{{selected}}</view><button disabled="{{loading}}" wx:if="{{conflict}}" bindtap="reload">核对后重新载入</button></block><view wx:if="{{actionError}}" class="error">{{actionError}}</view></view>
  <scroll-view scroll-x="{{!editing}}" class="board-wrap"><canvas hidden="{{businessUiBlocking}}" type="2d" id="tactic-canvas" disable-scroll="{{editing}}" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px"/></scroll-view>
  <view wx:if="{{!editing&&!focusCanvas&&(canExport||canEdit)}}" class="board-shortcuts">
   <button wx:if="{{canExport}}" disabled="{{loading}}" class="shortcut" id="export-tactic" bindtap="exportImage">导出图片 / PDF</button>
   <button wx:if="{{canExport&&canEdit}}" disabled="{{loading}}" class="shortcut" id="setup-tactic" bindtap="setup">阵型与战术信息</button>
   <button wx:if="{{canEdit}}" disabled="{{loading}}" class="shortcut" id="compose-tactic" bindtap="compose">动画与球员</button>
   <button wx:if="{{canEdit}}" disabled="{{loading}}" class="shortcut shortcut-primary" id="edit-positions" bindtap="startEdit">编辑战术画布</button>
  </view>
  <view wx:if="{{renderError}}" class="error">{{renderError}}<button disabled="{{loading}}" bindtap="draw">重试画布</button></view><view wx:if="{{warning}}" class="hint">{{warning}}</view><view wx:if="{{note}}" class="card section prewrap">{{note}}</view><view wx:if="{{objective||instructions}}" class="card section"><view class="bold prewrap tactic-objective">{{objective}}</view><view class="prewrap">{{instructions}}</view></view>
  <view wx:if="{{!editing&&!focusCanvas}}" class="hint">{{canEdit?'可编辑画布、动画与阵型。':'当前为只读，可查看站位与播放已有演示。'}}</view>
 </block>
</view>

<business-dialog id="business-dialog"/>
