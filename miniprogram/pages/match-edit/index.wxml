<view class="page"
  ><page-state id="page-state" skeleton-type="form"
    loading="{{loading}}"
    error="{{error}}"
    bind:retry="refresh"
  /><block wx:if="{{!loading && !error}}"
    ><view class="club-page-banner"><view class="club-eyebrow">BERLIN FC</view><view class="club-banner-title">{{editing ? '编辑比赛' : '安排一场比赛'}}</view><view class="club-banner-subtitle">球队管理</view><image class="club-banner-mark" src="/assets/team-badge.png" mode="aspectFit" aria-hidden="true"/></view
    ><view class="card section"
      ><view class="field" wx:for="{{catalogFields}}" wx:key="kind">
        <text class="field-label">{{item.label}}{{item.required ? ' *' : ''}}</text>
        <view class="catalog-choice">
          <business-picker title="{{item.label}}" bind:pickeropen="openBusinessPicker" range="{{catalogs[item.kind]}}" range-key="name" value="{{catalogIndices[item.kind]}}" data-kind="{{item.kind}}" bindchange="pickCatalog" disabled="{{busy}}">
            <view class="picker"><text class="picker-value">{{catalogs[item.kind][catalogIndices[item.kind]].name}}</text></view>
          </business-picker>
          <button size="mini" class="ui-button catalog-new" data-kind="{{item.kind}}" bindtap="createCatalog" disabled="{{busy}}">新建</button>
        </view>
        <input wx:if="{{!catalogIndices[item.kind]}}" class="input catalog-manual" value="{{form[item.field]}}" data-field="{{item.field}}" bindinput="input" maxlength="200" placeholder="{{item.placeholder}}" disabled="{{busy}}"/>
      </view
      ><view class="filter-row date-time-row"
        ><view class="grow"
          ><text class="field-label">日期 *</text
          ><business-picker title="比赛日期" bind:pickeropen="openBusinessPicker"
            mode="date"
            value="{{form.date}}"
            bindchange="date"
            disabled="{{loading || (busy)}}"
            ><view class="picker"><text class="picker-value">{{dateLabel || '选择日期'}}</text></view></business-picker
          ></view
        ><view class="grow"
          ><text class="field-label">开球时间</text
          ><business-picker title="开球时间" bind:pickeropen="openBusinessPicker"
            mode="time"
            minute-step="{{5}}"
            value="{{form.kickoff}}"
            bindchange="time"
            disabled="{{loading || (busy)}}"
            ><view class="picker"><text class="picker-value">{{form.kickoff || '时间待定'}}</text></view></business-picker
          ></view
        ></view
      ><button
        wx:if="{{form.kickoff}}"
        class="small ghost ui-button ui-compact clear-kickoff"
        bindtap="clearTime"
        disabled="{{loading || (busy)}}"
       size="mini">清除开球时间</button><view class="field"><text class="field-label">选择球场</text><business-picker title="比赛球场" bind:pickeropen="openBusinessPicker" range="{{venues}}" range-key="displayName" value="{{venueIndex}}" data-field="venueIndex" bindchange="pick" disabled="{{loading || (busy)}}"><view class="picker"><text class="picker-value">{{venues[venueIndex].displayName}}</text></view></business-picker></view><view class="field"
        ><text class="field-label">地点</text
        ><input
          class="input"
          value="{{form.location}}"
          data-field="location"
          bindinput="input"
          maxlength="500"
          placeholder="球场名称或地址"
          disabled="{{loading || (busy || venueIndex>0)}}" /></view
      ><view class="filter-row"
        ><view class="grow"
          ><text class="field-label">人数制</text
          ><business-picker title="比赛制式" bind:pickeropen="openBusinessPicker"
            range="{{formats}}"
            range-key="label"
            value="{{formatIndex}}"
            data-field="formatIndex"
            bindchange="pick"
            disabled="{{loading || (busy)}}"
            ><view class="picker"><text class="picker-value">{{formats[formatIndex].label}}</text></view></business-picker
          ></view
        ><view class="grow"
          ><text class="field-label">主客场</text
          ><business-picker title="主客场" bind:pickeropen="openBusinessPicker"
            range="{{sides}}"
            range-key="label"
            value="{{sideIndex}}"
            data-field="sideIndex"
            bindchange="pick"
            disabled="{{loading || (busy)}}"
            ><view class="picker"><text class="picker-value">{{sides[sideIndex].label}}</text></view></business-picker
          ></view
        ></view
      ><view class="field"><text class="field-label">报名人数</text><input class="input" type="number" value="{{form.maxParticipants}}" data-field="maxParticipants" bindinput="input" maxlength="5" placeholder="不限（留空）" disabled="{{loading || (busy)}}"/><view class="capacity-hint">仅“参加”计入人数，留空表示不限。</view></view
      ><view class="field"
        ><text class="field-label">所属赛季</text
        ><business-picker title="所属赛季" bind:pickeropen="openBusinessPicker"
          range="{{seasons}}"
          range-key="name"
          value="{{seasonIndex}}"
          data-field="seasonIndex"
          bindchange="pick"
          disabled="{{loading || (busy)}}"
          ><view class="picker"><text class="picker-value">{{seasons[seasonIndex].name}}</text></view></business-picker
        ></view
      ><view class="field"
        ><view class="subtitle publication-note">草稿仅管理员可见，选择“发布报名”后球员才能报名</view><text class="field-label">比赛状态</text>
        <radio-group class="status-options" bindchange="changeStatus">
          <label wx:for="{{statuses}}" wx:key="value" class="status-option {{statusIndex===index?'is-current':''}}">
            <radio value="{{item.value}}" checked="{{statusIndex===index}}" disabled="{{busy}}" color="#742286"/>
            <text>{{item.label}}</text>
          </label>
        </radio-group>
      </view
      ></view
    ><view class="card notice-section">
      <view class="section-title">比赛须知</view>
      <view class="catalog-choice">
        <business-picker title="选择比赛须知模板" bind:pickeropen="openBusinessPicker" range="{{catalogs.notices}}" range-key="name" value="{{catalogIndices.notices}}" data-kind="notices" bindchange="pickCatalog" disabled="{{busy}}">
          <view class="picker"><text class="picker-value">{{catalogs.notices[catalogIndices.notices].name}}</text></view>
        </business-picker>
        <button size="mini" class="ui-button catalog-new" data-kind="notices" bindtap="createCatalog" disabled="{{busy}}">新建模板</button>
      </view>
      <label class="field-label notice-label" for="match-notice">本场须知（选填）</label>
      <textarea id="match-notice" value="{{form.notice}}" data-field="notice" bindinput="input" maxlength="10000" placeholder="集合时间、装备要求和比赛注意事项" disabled="{{busy}}"/>
      <view class="hint">报名时可查看。选用模板后仍可调整，只影响本场比赛。</view>
    </view
    ><view class="card"
      ><view class="section-title">比分与复盘</view
      ><view class="filter-row"
        ><view class="grow"
          ><text class="field-label">我方比分</text
          ><input
            class="input"
            type="number"
            value="{{form.homeScore}}"
            data-field="homeScore"
            bindinput="input"
            maxlength="3"
            placeholder="未知"
            disabled="{{loading || (busy)}}" /></view
        ><view class="grow"
          ><text class="field-label">对方比分</text
          ><input
            class="input"
            type="number"
            value="{{form.awayScore}}"
            data-field="awayScore"
            bindinput="input"
            maxlength="3"
            placeholder="未知"
            disabled="{{loading || (busy)}}" /></view></view
      ><text class="field-label">复盘</text
      ><textarea
        value="{{form.analysis}}"
        data-field="analysis"
        bindinput="input"
        maxlength="10000"
        placeholder="记录这场比赛的收获"
        disabled="{{loading || (busy)}}"
      /><view class="hint score-scope-note">只有“已完赛”比赛计入统计；比分未知时请留空。</view></view
    ><view wx:if="{{actionError&&!conflict&&!uncertain}}" class="error">{{actionError}}</view>
    <view wx:if="{{conflict||uncertain}}" class="recovery-notice">
      <view class="recovery-title">{{uncertain?'结果待核对':'有更新需要核对'}}</view>
      <view wx:if="{{actionError}}" class="recovery-message">{{actionError}}</view>
      <button disabled="{{loading}}" wx:if="{{uncertain}}" bindtap="checkSchedule" class="ui-button ui-block recovery-check" size="mini">前往赛程核对</button>
      <button disabled="{{loading || busy}}" wx:if="{{uncertain}}" class="ghost ui-button ui-block recovery-continue" bindtap="confirmExists" size="mini">已核对，比赛已存在</button>
      <button disabled="{{loading}}" wx:if="{{uncertain}}" class="ghost ui-button ui-block recovery-continue" bindtap="confirmAbsent" size="mini">已核对，继续编辑</button>
      <button disabled="{{loading}}" wx:if="{{conflict}}" bindtap="reload" class="ui-button ui-block recovery-check" size="mini">重新载入最新版本</button>
    </view>
    <button wx:if="{{savedId}}" disabled="{{loading||busy}}" class="primary ui-button ui-block" size="mini" bindtap="openSaved">进入已保存比赛</button><view class="bottom-space match-save-spacer"/><view class="fixed-actions match-save-bar"><button
      class="primary ui-button ui-block"
      disabled="{{loading || (busy || conflict || uncertain || savedId)}}"
      loading="{{busy}}"
      bindtap="save"
     size="mini">{{editing ? '保存修改' : statusIndex===0 ? '保存草稿' : statusIndex===1 ? '发布比赛' : '保存比赛'}}</button></view></block
  ></view
>

<business-dialog id="business-dialog"/>
