<view class="page {{focusCanvas&&tab===0?'canvas-focus':'type-expanded'}}">
<page-state skeleton-type="detail" loading="{{loading}}" error="{{error}}" bind:retry="refresh"/>
<block wx:if="{{!loading && !error}}">
<view wx:if="{{!focusCanvas||tab!==0}}" class="title">{{title}}</view>
<view class="compose-workspace"><text class="editor-field-label workspace-label">编辑内容</text><view id="compose-tab" class="workspace-segments"><button wx:for="{{tabs}}" wx:key="index" class="workspace-segment {{tab===index?'is-active':''}}" data-index="{{index}}" bindtap="chooseWorkspace" disabled="{{loading||busy||conflict||businessUiBlocking}}" aria-label="{{item}}" aria-pressed="{{tab===index}}">{{item}}</button></view><view class="row compose-actions"><button id="compose-undo" class="small" bindtap="undo" disabled="{{loading || (!canUndo||busy||conflict)}}">撤销</button><button id="compose-save" class="primary small" bindtap="save" disabled="{{loading || (!changes||busy||conflict)}}">{{busy?'保存中':'保存 ('+changes+')'}}</button></view></view>
<view wx:if="{{actionError}}" class="error">{{actionError}}</view><button disabled="{{loading}}" wx:if="{{conflict}}" bindtap="reload">核对后重新载入</button>
<block wx:if="{{tab===0}}">
<button wx:if="{{!hasDemo||!stages.length}}" id="demo-init" bindtap="initialize" disabled="{{loading || (busy||conflict)}}">{{hasDemo?'以现有演示参与者建立首阶段':'以当前画布建立演示'}}</button>
<block wx:else>
<view class="stage-settings {{focusCanvas?'':'card'}}"><text class="editor-field-label stage-selector-label">演示阶段</text><view class="row stage-selector-row"><business-picker title="演示阶段" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" id="stage-picker" class="grow" range="{{stages}}" range-key="label" value="{{stageIndex}}" data-key="stageIndex" bindchange="select"><view class="picker"><text class="picker-value">{{stages[stageIndex].label}}</text></view></business-picker><button id="compose-focus" class="small" bindtap="toggleFocus" disabled="{{busy}}">{{focusCanvas?'阶段设置':'专注球场'}}</button></view><view class="row stage-actions"><button wx:if="{{!focusCanvas}}" id="stage-add" class="small" bindtap="addStage" disabled="{{loading || (busy||conflict||stages.length>=120)}}">复制追加</button><button wx:if="{{!focusCanvas}}" id="stage-delete" class="small" bindtap="deleteStage" disabled="{{loading || (busy||conflict||stages.length<=1)}}">删除</button></view>
<view wx:if="{{!focusCanvas}}" class="stage-fields"><view class="grow stage-title-field"><text class="editor-field-label">阶段标题</text><input disabled="{{loading}}" id="stage-title" class="grow" value="{{stageTitle}}" maxlength="60" data-key="stageTitle" bindinput="input" placeholder="阶段标题"/></view><text class="editor-field-label">阶段时长</text><business-picker title="阶段时长" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" id="stage-duration" range="{{durations}}" value="{{durationIndex}}" data-key="durationIndex" bindchange="select"><view class="picker"><text class="picker-value">{{duration}} 秒</text></view></business-picker><button id="stage-apply" class="small" bindtap="applyStage" disabled="{{loading || (busy||conflict)}}">应用阶段设置</button></view></view>
<view class="row compose-tools"><business-picker title="画布工具" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" id="compose-tool" class="grow" range="{{tools}}" value="{{toolIndex}}" data-key="toolIndex" bindchange="select"><view class="picker"><text class="picker-value">{{tools[toolIndex]}}</text></view></business-picker><business-picker title="曲线参与者" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" wx:if="{{toolIndex===2}}" id="curve-piece" class="grow" range="{{players}}" range-key="label" value="{{playerIndex}}" data-key="playerIndex" bindchange="select"><view class="picker"><text class="picker-value">{{players[playerIndex].label||'选择参与者'}}</text></view></business-picker><button wx:if="{{toolIndex===2}}" id="curve-clear" class="small" bindtap="clearCurve" disabled="{{loading || (busy||conflict)}}">直线</button></view>
<view wx:if="{{!focusCanvas}}" class="hint">{{toolIndex===2?'选择参与者后点按/拖动红色曲线控制点。':'选择移动工具后，拖动当前阶段球员或球。'}} {{selected}}</view>
<view class="board-wrap"><canvas hidden="{{businessUiBlocking}}" type="2d" id="compose-canvas" disable-scroll="{{toolIndex>0}}" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px"/></view><view wx:if="{{renderError}}" class="error">{{renderError}}</view>
<view wx:if="{{!focusCanvas}}" class="hint">时长表示从上一阶段到本阶段的过渡；首阶段不计时。插入或删除阶段会移除受影响的相邻曲线。</view>
</block>
</block>
<block wx:else>
<view class="card properties-card"><text class="editor-field-label">属性作用范围</text><business-picker title="属性作用范围" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" id="piece-target" range="{{targets}}" value="{{targetIndex}}" data-key="targetIndex" bindchange="select"><view class="picker"><text class="picker-value">{{targets[targetIndex]}}</text></view></business-picker><view class="hint scope-warning">只修改所选范围，不自动同步另一范围，不修改球队球员档案或历史比赛。</view>
<text class="editor-field-label">选择球员</text><business-picker title="选择球员" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" id="piece-picker" range="{{players}}" range-key="label" value="{{playerIndex}}" data-key="playerIndex" bindchange="select"><view class="picker"><text class="picker-value">{{players[playerIndex].label||'该范围暂无球员'}}</text></view></business-picker>
<block wx:if="{{players.length}}"><label>名称<input disabled="{{loading}}" id="piece-label" value="{{label}}" maxlength="100" data-key="label" bindinput="input"/></label><label>号码<input disabled="{{loading}}" id="piece-number" value="{{shirtNumber}}" maxlength="3" type="number" data-key="shirtNumber" bindinput="input" placeholder="未编号"/></label><label>位置<business-picker title="球员位置" disabled="{{loading}}" bind:pickeropen="openBusinessPicker" id="piece-position" range="{{positions}}" value="{{positionIndex}}" data-key="positionIndex" bindchange="select"><view class="picker"><text class="picker-value">{{positions[positionIndex]}}</text></view></business-picker></label><button id="piece-apply" class="primary" bindtap="applyPlayer" disabled="{{loading || (busy||conflict)}}">应用属性</button></block></view>
</block>
</block>
</view>

<business-dialog id="business-dialog"/>
