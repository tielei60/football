.roster-page{padding-top:28rpx}
.roster-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;padding:8rpx 2rpx 30rpx}
.roster-heading-main{flex:1;min-width:0}
.roster-kicker{font-size:24rpx;font-weight:600;line-height:1.4;color:var(--brand-ink)}
.roster-opponent{margin-top:8rpx;font-size:38rpx;font-weight:650;line-height:1.35;color:var(--ink);overflow-wrap:anywhere}
.roster-total{display:flex;align-items:baseline;gap:8rpx;flex:none;padding-bottom:2rpx;color:var(--muted);white-space:nowrap}
.roster-total-number{font-size:36rpx;font-weight:650;line-height:1;color:var(--brand-ink);font-variant-numeric:tabular-nums}
.roster-total-label,.section-note{font-size:24rpx;line-height:1.5;color:var(--muted)}
.add-section{padding:26rpx;border:1rpx solid #eae2ee;border-radius:22rpx;background:#fff}
.section-heading,.list-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}
.section-title{margin:0;font-size:29rpx;font-weight:650;line-height:1.4;color:var(--ink)}
.add-row{display:flex;align-items:stretch;gap:14rpx;margin-top:20rpx;min-width:0}
.add-row .grow{flex:1;min-width:0}
.roster-page .picker{min-height:88rpx;padding:16rpx 20rpx;border-color:var(--control-border);border-radius:14rpx;background:#fff;color:var(--ink);font-size:26rpx;line-height:1.45}
.roster-page .add-picker{background:#faf8fc}
.page button.add-button[size="mini"]{flex:none;width:auto;min-width:132rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center;gap:6rpx;margin:0;padding:0 20rpx;border-radius:14rpx;background:var(--brand-ink);font-size:26rpx;font-weight:600;line-height:1.4}
.add-symbol{font-size:30rpx;font-weight:400;line-height:1}
.add-complete{padding-top:16rpx;font-size:25rpx;line-height:1.6;color:var(--muted)}
.list-heading{padding:34rpx 2rpx 16rpx}
.roster-empty{display:flex;flex-direction:column;align-items:center;gap:8rpx;padding:42rpx 24rpx 44rpx;border:1rpx dashed #dfd4e5;border-radius:22rpx;background:rgba(255,255,255,.55);text-align:center}
.empty-mark{position:relative;width:64rpx;height:64rpx;margin-bottom:8rpx;border-radius:50%;background:#eee6f2}
.empty-mark-head{position:absolute;left:24rpx;top:13rpx;width:16rpx;height:16rpx;border:2rpx solid #8f749c;border-radius:50%}
.empty-mark-body{position:absolute;left:17rpx;bottom:11rpx;width:30rpx;height:17rpx;border:2rpx solid #8f749c;border-radius:18rpx 18rpx 10rpx 10rpx}
.empty-title{font-size:28rpx;font-weight:600;line-height:1.5;color:var(--ink)}
.empty-copy{font-size:25rpx;line-height:1.6;color:var(--muted)}
.roster-card{margin-bottom:16rpx;padding:24rpx 26rpx 28rpx;border:1rpx solid #eae2ee;border-radius:22rpx;background:#fff}
.player-header{display:flex;align-items:center;gap:16rpx;min-width:0}
.player-avatar{width:76rpx;height:76rpx;flex:none;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:50%;background:var(--brand-soft);color:var(--brand-ink);font-size:29rpx;font-weight:650}
.player-avatar.player-placeholder{background:linear-gradient(145deg,var(--brand-soft),var(--surface));box-shadow:inset 0 0 0 1px var(--brand-soft)}
.player-avatar image{width:100%;height:100%}
.player-identity{flex:1;min-width:0}.player-name{font-size:29rpx;font-weight:650;line-height:1.4;overflow-wrap:anywhere;color:var(--ink)}
.player-number{font-size:24rpx;line-height:1.5;color:var(--muted)}
.page button.remove-button[size="mini"]{flex:none;width:auto;min-width:88rpx;min-height:88rpx;margin:-6rpx -12rpx;padding:0 12rpx;border:0;background:transparent;box-shadow:none;color:#a13f4e;font-size:25rpx;font-weight:500;line-height:1.4}
.page button.remove-button::after,.page button.add-button::after{border:0}
.identity-note{margin-top:16rpx;color:var(--muted);font-size:24rpx;line-height:1.5}
.roster-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16rpx;margin-top:22rpx}
.roster-grid>view{min-width:0}.field-label{display:block;margin-bottom:10rpx;font-size:25rpx;font-weight:500;line-height:1.45;color:var(--ink)}
.appearance-field{margin-top:20rpx}.stats-grid{margin-top:20rpx}
.roster-grid input.input{width:100%;height:88rpx;min-height:88rpx;padding:0 20rpx;border-radius:14rpx;background:#fff;font-size:27rpx}
.stats-note{margin-top:12rpx;font-size:24rpx;line-height:1.5;color:var(--muted)}
.roster-reminder,.save-note{padding:8rpx 2rpx 0;color:var(--muted);font-size:24rpx;line-height:1.6}
.clear-warning{margin-top:20rpx;padding:16rpx 20rpx;border-radius:14rpx;background:#fff4f0;color:#984333;font-size:25rpx;line-height:1.6}
.roster-error{margin-top:20rpx;font-size:25rpx}
.page button.roster-save[size="mini"]{min-height:92rpx;margin-top:24rpx;border-radius:16rpx;background:var(--brand-ink);font-size:28rpx;font-weight:600;line-height:1.4}
.page button.reload-button[size="mini"]{min-height:88rpx;margin-top:20rpx}
.save-note{text-align:center;padding-top:14rpx}
@media(max-width:360px){.roster-kicker,.roster-total-label,.section-note,.player-number,.identity-note,.stats-note,.roster-reminder,.save-note{font-size:12px}}

/* 名单：对手是标题，数量是次级核心数据，球员身份与操作不抢位。 */
.roster-heading { gap:var(--space-2); padding-bottom:var(--space-4); flex-wrap:wrap; }
.roster-opponent { font-size:var(--type-page); font-weight:600; }
.roster-total-number { font-size:40rpx; font-weight:600; }
.roster-kicker,.roster-total-label,.section-note { font-size:var(--type-meta); }
.section-heading,.list-heading { flex-wrap:wrap; gap:var(--space-1); }
.section-title { font-size:var(--type-section); font-weight:600; }
.add-section,.roster-card { padding:var(--space-3); background:var(--surface); border-color:var(--line); }
.player-name { font-size:var(--type-card); font-weight:600; }
.player-number,.identity-note,.stats-note,.save-note { font-size:var(--type-meta); line-height:1.6; }
.field-label { font-size:var(--type-field); color:var(--muted); font-weight:400; margin-bottom:var(--space-1); }
.roster-grid,.appearance-field { margin-top:var(--space-3); }
.page button.remove-button[size="mini"] { color:var(--danger); min-height:44px; }
.page button.add-button[size="mini"],.page button.reload-button[size="mini"] { min-height:44px; }
.clear-warning { background:var(--warning-soft); color:var(--warning); padding:var(--space-2); }
@media(max-width:340px) { .player-header { flex-wrap:wrap; } .player-identity { min-width:160rpx; } }
/* 移除按钮禁用时不能保留危险强调。 */
.page button.remove-button[size="mini"][disabled] { color:var(--muted); background:var(--canvas); }
