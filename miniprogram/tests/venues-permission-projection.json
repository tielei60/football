      },
      {
        "before": "  edit(e) {\n",
        "after": "  edit(e) {\n    if (this._disposed || this._hidden || this.data.loading || this.data.error || !this.data.admin || !this._venueOwner || this._venueOwner !== s.api.getSession()?.token) return;\n"
      }
