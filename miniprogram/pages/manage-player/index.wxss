.position-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}
.position-options button.small {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 12rpx 8rpx;
  line-height: 1.5;
}
.position-options .selected {
  background: var(--brand);
  color: #fff;
}
.admin-header { margin-bottom: 28rpx; }
.picture-preview {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  background: var(--brand-soft);
}
.row > .avatar { flex-shrink: 0; }
.row > .stack { flex: 1; min-width: 0; }
.row > .stack button { width: 100%; min-width: 0; margin: 0; }

/* Page-specific density, hierarchy and long-content safeguards. */
.admin-header{gap:16rpx;align-items:flex-start;margin-bottom:22rpx}.admin-header .title{font-size:34rpx}.picture-preview,.row>.avatar{width:116rpx;height:116rpx;border-radius:24rpx}.position-options{gap:10rpx}.position-options button.small{font-size:24rpx;min-height:72rpx}.field-label{font-size:24rpx;margin-bottom:10rpx}.card textarea{min-height:160rpx;line-height:1.65}.stack{gap:10rpx}

/* 管理文字层级：仅文字与组间留白，不改原生输入及业务布局。 */
.admin-header .title{font-size:34rpx;font-weight:650;color:var(--ink)}
.field-label{font-size:26rpx;font-weight:500;margin-bottom:12rpx;color:var(--ink)}
.position-options button.ui-button.ui-compact[size="mini"]{font-size:25rpx;font-weight:500}
.account-heading{margin-bottom:16rpx}
.account-heading .bold{font-size:28rpx;font-weight:600;color:var(--ink)}
.account-heading .tag,.admin-header .tag{font-size:24rpx;font-weight:500}
.hint{font-size:24rpx;font-weight:400;line-height:1.65;color:var(--muted)}
@media(max-width:346px){.field-label{font-size:12px}}
@media(max-width:360px){.position-options button.ui-button.ui-compact[size="mini"]{font-size:12px}}
@media(max-width:375px){.hint,.account-heading .tag,.admin-header .tag{font-size:12px}}

/* 球员编辑：状态、字段与账号区有独立权重，不更改输入光标样式。 */
.admin-header { flex-wrap:wrap; gap:var(--space-2); margin-bottom:var(--space-3); }
.admin-header .title { font-size:var(--type-page); line-height:1.35; }
.field-label { color:var(--muted); font-size:var(--type-field); font-weight:400; margin-bottom:var(--space-1); }
.position-options { gap:var(--space-1); }
.position-options button.ui-button.ui-compact[size="mini"] { min-height:44px; white-space:normal; font-size:var(--type-field); }
.account-heading { gap:var(--space-2); flex-wrap:wrap; }
.account-heading .bold { font-size:var(--type-section); }
.account-card { margin-top:var(--space-4); }
.hint { font-size:var(--type-meta); line-height:1.6; }
.tag.status-pending { color:var(--warning); background:var(--warning-soft); }
.tag.status-active { color:var(--success); background:var(--success-soft); }
.tag.status-inactive { color:var(--muted); background:var(--canvas); }
