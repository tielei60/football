/* UI v3：管理页共享视觉由 app.wxss 令牌与品牌横幅提供。 */
.admin-header { gap:16rpx; flex-wrap:wrap; margin:24rpx 0; }
.field-label { font-size:26rpx; font-weight:500; color:var(--muted); margin-bottom:12rpx; }
.hint,.subtitle { font-size:24rpx; line-height:1.65; color:var(--muted); }
.section-title { font-size:32rpx; font-weight:650; line-height:1.4; }
.card { padding:34rpx; }
.error { overflow-wrap:anywhere; }
 .card .between { gap:16rpx; align-items:flex-start; }
.bold { min-width:0; font-size:30rpx; font-weight:650; overflow-wrap:anywhere; }
.card .muted { font-size:26rpx; margin-top:16rpx; line-height:1.6; }
.link { font-size:24rpx; color:var(--brand-ink); padding-top:24rpx; margin-top:24rpx; border-top:1px solid var(--line); }
.tag { flex-shrink:0; }
.tag.status-active { background:var(--success-soft); color:var(--success); }
.tag.status-inactive { background:var(--canvas); color:var(--muted); }

/* 对齐 V3 管理列表：新增操作独立成行，保留权限与禁用条件。 */
.admin-create-action { margin:24rpx 0 32rpx; }
.admin-create-action .ui-button { width:100%; min-height:44px; margin:0; box-sizing:border-box; }

.venues-heading{margin:36rpx 0 24rpx;padding-left:18rpx;border-left:6rpx solid var(--brand);color:var(--ink)}
