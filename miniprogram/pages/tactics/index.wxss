/* UI v3：战术工作台的品牌页头，不参与画布坐标计算。 */
.tactical-header { margin: -32rpx -28rpx 28rpx; padding: 36rpx 28rpx 40rpx; background: linear-gradient(120deg,#5b106d,#84299b); color: #fff; border-radius: 0 0 32rpx 32rpx; }
.tactical-eyebrow { font-size: 22rpx; letter-spacing: 4rpx; color: #d8eaff; margin-bottom: 10rpx; }
.tactical-header .title { font-size: 44rpx; line-height: 1.4; font-weight: 700; color: #fff; margin: 0; overflow-wrap: anywhere; }
.tactical-subtitle { margin-top: 12rpx; color: #f1e5f7; font-size: 24rpx; line-height: 1.65; }

.tactical-actions { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.tactical-actions button { flex: 1; width: 0; min-width: 0; margin: 0; min-height: 44px; padding: 20rpx 10rpx; font-size: 26rpx; }
.input.section { margin-top: 0; margin-bottom: 28rpx; }
.tactic-card { display: flex; align-items: center; gap: 24rpx; padding: 28rpx; }
.tactic-info { flex: 1; min-width: 0; }
.tactic-card .between { gap: 16rpx; align-items: flex-start; }
.tactic-card .bold { font-size: 30rpx; font-weight: 600; overflow-wrap: anywhere; }
.tactic-card .link { flex-shrink: 0; font-size: 24rpx; color: var(--brand); }
.tactic-card .muted { font-size: 24rpx; line-height: 1.6; margin: 10rpx 0; }
.tactic-card .tag { font-size: 22rpx; line-height: 1.6; white-space: normal; }
.pitch-symbol { width: 108rpx; height: 144rpx; padding: 14rpx; flex-shrink: 0; background: #246c59; border-radius: 12rpx; }
.pitch-lines { position: relative; height: 100%; border: 1rpx solid #b5d5c7; }
.pitch-midline { position: absolute; left: 0; right: 0; top: 50%; border-top: 1rpx solid #b5d5c7; }
.pitch-circle { position: absolute; width: 30rpx; height: 30rpx; border: 1rpx solid #b5d5c7; border-radius: 50%; left: 50%; top: 50%; margin: -15rpx 0 0 -15rpx; }
.tactic-help { font-size: 24rpx; line-height: 1.65; margin-top: 24rpx; }

/* 同一操作组覆盖 ui-block 的上边距与 ui-compact 的独立尺寸，保持顶底齐。 */
.page .tactical-actions{align-items:stretch}
.page .tactical-actions>button.ui-button[size="mini"]{display:flex;flex:1 1 0;width:0;min-width:0;min-height:44px;height:auto;margin:0;padding:20rpx 12rpx;box-sizing:border-box;align-self:stretch;align-items:center;justify-content:center;font-size:26rpx;line-height:1.5;white-space:normal;overflow-wrap:anywhere}
