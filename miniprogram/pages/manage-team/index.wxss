/* UI v3：管理页共享视觉由 app.wxss 令牌与品牌横幅提供。 */
.admin-header { gap:16rpx; flex-wrap:wrap; margin:24rpx 0; }
.field-label { font-size:26rpx; font-weight:500; color:var(--muted); margin-bottom:12rpx; }
.hint,.subtitle { font-size:24rpx; line-height:1.65; color:var(--muted); }
.section-title { font-size:32rpx; font-weight:650; line-height:1.4; }
.card { padding:34rpx; }
.error { overflow-wrap:anywhere; }
 .crest-editor { margin-top:32rpx; padding:28rpx; border:1px dashed var(--line); border-radius:28rpx; background:var(--canvas); text-align:center; }
.crest-editor .picture-preview { display:block; width:256rpx; height:256rpx; margin:20rpx auto; }
.crest-editor .avatar { margin:20rpx auto; }
.actions { display:flex; gap:16rpx; }
.actions button.ui-button[size="mini"] { flex:1; min-width:0; min-height:44px; white-space:normal; }
