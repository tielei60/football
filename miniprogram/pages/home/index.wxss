/* 本页文字层级；不改变输入、按钮、列数或画布几何。 */
.hero {
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg,var(--surface),var(--brand-soft));
  border: 1rpx solid #e8dcef;
  border-color: var(--line);
}
.hero .title {
  font-size: var(--type-page);
  margin-top: 6rpx;
  line-height: 1.35;
  font-weight: 700;
}
.hero-metrics {
  display: grid;
  margin-top: 28rpx;
  gap: 16rpx;
  color: var(--muted);
  font-size: 24rpx;
  grid-template-columns: repeat(3,minmax(0,1fr));
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}
.hero-number {
  display: block;
  font-size: 40rpx;
  color: var(--brand-ink);
  font-weight: 700;
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
}
.next {
  border-color: var(--brand-soft);
}
.match-title {
  font-size: var(--type-section);
  font-weight: 600;
  margin: 20rpx 0 12rpx;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.hero .subtitle {
  font-size: 24rpx;
  letter-spacing: 0;
  line-height: 1.6;

  color: var(--muted);
}
.hero .avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
}
.hero .grow {
  min-width: 0;
}
.card .score {
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
  font-size: 36rpx;
  font-weight: 650;
}
.match-time {
  font-size: var(--type-body);
  font-weight: 500;
  line-height: 1.6;
  color: var(--ink);
}
.match-place {
  font-size: var(--type-field);
  line-height: 1.6;
}
.recent-name {
  font-size: var(--type-card);
  font-weight: 600;
  line-height: 1.4;
}
.section-title {
  font-size: var(--type-section);
  font-weight: 600;
}
.card .muted, .card .tag, .section .link {
  font-size: 24rpx;
}
.card .muted.match-place {
  font-size: 26rpx;
}

/* 小屏正文下限 12px，仅覆盖以上内容文字，不影响控件。 */
@media (max-width: 375.000px) {
  .hero .subtitle, .hero-metrics, .card .muted, .card .tag, .section .link { font-size: 12px; }
}
@media (max-width: 346.154px) {
  .card .muted.match-place { font-size: 12px; }
}
@media (max-width: 321.429px) {
  .match-time { font-size: var(--type-body); }
}

/* Schedule link keeps a full tap area while looking like a light navigation action. */
.page .between>button.home-schedule-link[size="mini"]{min-height:44px;padding:0 12rpx;margin:0 -12rpx 0 0;border:0;background:transparent;color:var(--brand-ink);font-size:24rpx;font-weight:600;line-height:1.4;box-shadow:none;white-space:nowrap}
.page .between>button.home-schedule-link[size="mini"]::after{border:0}

.signup-summary{align-items:flex-start;gap:12rpx}.signup-counts{display:flex;flex:1;min-width:0;flex-wrap:wrap;gap:6rpx 18rpx;color:var(--muted);font-size:25rpx;line-height:1.6}.signup-counts text{white-space:nowrap}.signup-summary>.tag{flex-shrink:0}@media(max-width:360px){.signup-counts{font-size:12px}}
