.subtitle,.hint{line-height:1.6}.account-name{overflow-wrap:anywhere}.account-actions{display:flex;gap:12rpx;margin-top:20rpx;min-width:0}.account-actions button.ui-button[size="mini"]{flex:1 1 0;width:0;min-width:0;min-height:44px;margin:0;padding:14rpx 8rpx;box-sizing:border-box;line-height:1.5}.error{margin-top:20rpx}

/* Keep account cards and their paired actions compact on narrow screens. */
.page .card.section+.card.section{margin-top:20rpx}.account-actions{gap:16rpx;align-items:stretch}.account-actions button.ui-button[size="mini"]{overflow-wrap:anywhere}.account-name{line-height:1.4;word-break:break-word}.page>.subtitle{margin-top:8rpx}
.page .card .account-name{margin-bottom:8rpx}
.page .card .hint{padding:0;margin-top:8rpx;line-height:1.6}
.page .account-actions{margin-top:20rpx}

/* 系统账号：账号名为主，角色与启停分层，危险操作不与创建抢权重。 */
.title { font-size:var(--type-page); line-height:1.35; }
.subtitle { font-size:var(--type-field); line-height:1.6; }
.section-title { font-size:var(--type-section); font-weight:600; }
.account-name { font-size:var(--type-card); line-height:1.45; }
.field-label { display:block; font-size:var(--type-field); color:var(--muted); font-weight:400; margin:var(--space-2) 0 var(--space-1); }
.account-role { color:var(--ink); font-weight:500; }
.account-state { color:var(--muted); }
.account-state.is-enabled { color:var(--success); }
.account-state.is-disabled { color:var(--muted); }
.page .card .hint { font-size:var(--type-meta); line-height:1.6; }
.account-actions { flex-wrap:wrap; gap:var(--space-2); margin-top:var(--space-3); }
.account-actions button.ui-button[size="mini"] { flex-basis:200rpx; font-size:var(--type-field); white-space:normal; }
.account-actions button.account-danger:not([disabled]) { color:var(--danger); background:var(--danger-soft); }

/* v3：创建入口和现有账号清单分离，权限与启停保留文字标识。 */
.card { padding:32rpx; border-radius:30rpx; }
.accounts-heading { margin:40rpx 0 20rpx; padding-left:18rpx; border-left:6rpx solid var(--brand); }
.account-name { font-size:32rpx; color:var(--ink); }
.account-state { display:inline-block; padding:4rpx 12rpx; border-radius:10rpx; background:var(--canvas); }
.account-state.is-enabled { background:var(--success-soft); }
.account-actions { padding-top:22rpx; border-top:1px solid var(--line); }

.access-denied.card{padding:56rpx 28rpx;text-align:center;background:linear-gradient(135deg,#fff,var(--canvas))}.access-denied-title{font-size:var(--type-page);font-weight:700;color:var(--ink);line-height:1.4}.access-denied-description{margin:28rpx 0 40rpx;color:var(--muted);font-size:var(--type-body);line-height:1.7}.access-denied-return{display:flex;align-items:center;justify-content:center;min-height:44px;padding:24rpx;box-sizing:border-box;border-radius:24rpx;background:var(--brand);color:#fff;font-size:var(--type-card);font-weight:600}

/* V3：账号统一白卡，条目分隔而非重复卡片。 */
.card.account-list{padding:0 32rpx}.account-row{padding:32rpx 0;min-width:0;overflow-wrap:anywhere}.account-row+.account-row{border-top:1px solid var(--line)}
.account-row .account-actions{border-top:0;padding-top:0}
